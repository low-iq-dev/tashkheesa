# =============================================================================
# Tashkheesa Portal — Environment Variables Reference
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# =============================================================================

# ── App Mode ──────────────────────────────────────────────────────────────────
MODE=development                        # development | staging | production
PORT=3000
LAUNCH_DATE=                            # Displayed on /coming-soon page (e.g. "February 28, 2026"). Leave blank to omit date.
# QA only: when MODE is NOT production, RATE_LIMIT_DISABLED=true bypasses the
# per-patient case-submission limiter on POST /patient/new-case/step5 so repeated
# Paymob sandbox runs aren't throttled. Ignored in production (limiter always on).
# RATE_LIMIT_DISABLED=false

# ── Business Info (homepage footer + JSON-LD schema) ─────────────────────────
BUSINESS_EMAIL=info@tashkheesa.com
BUSINESS_PHONE=+20 110 200 9886
BUSINESS_ADDRESS=Cairo, Egypt
PRICE_RANGE_MIN=200
PRICE_RANGE_MAX=18,250

NODE_ENV=development                    # development | production
BASE_URL=http://localhost:3000          # Full URL (no trailing slash)
APP_URL=http://localhost:3000           # Alias used by email templates

# ── Auth & Security ───────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS
SESSION_COOKIE_NAME=tashkheesa_portal

# Staging basic auth (required when MODE=staging or MODE=production)
BASIC_AUTH_USER=demo
BASIC_AUTH_PASS=demo123
# AUDIT-2026-08-22 — LIVE ALIASES, not legacy. src/server.js:243-244 resolves
# BASIC_AUTH_USER || STAGING_USER and BASIC_AUTH_PASS || STAGING_PASS, and
# src/bootCheck.js now accepts either pair. Set ONE pair, not both.
# STAGING_USER=
# STAGING_PASS=

# CSRF protection: off | log | enforce
CSRF_MODE=enforce

# Symmetric key used by pgcrypto's pgp_sym_encrypt / pgp_sym_decrypt to
# protect doctors' national IDs at rest in users.national_id_encrypted.
# REQUIRED in any environment that runs doctor signup or admin national-ID
# review. Treat as a top-tier secret — rotating it requires re-encrypting
# every existing row with the new key inside a single transaction.
# Generate with: openssl rand -base64 48
NATIONAL_ID_ENCRYPTION_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/tashkheesa
PG_SSL=false                            # Set to true on Render/production

# pg-boss (durable job queue) needs a session-mode Postgres connection because
# it uses LISTEN/NOTIFY and Postgres advisory locks for cross-instance
# singleton crons. The Supabase pgbouncer transaction-mode pooler (the URL
# above on Render production) silently breaks both. Set this to the Supabase
# "Session pooler" connection string (Project Settings → Database → Session
# pooler — typically port 5432). REQUIRED when MODE=production or MODE=staging
# (job_queue.js will fail fast at boot otherwise). Optional in development —
# pg-boss falls back to DATABASE_URL with a warning.
DATABASE_URL_DIRECT=

# Optional pool tuning (defaults shown).
# PG_POOL_MAX=8
# PG_POOL_CONNECT_TIMEOUT_MS=15000
# PG_POOL_IDLE_TIMEOUT_MS=30000
# PG_STATEMENT_TIMEOUT_MS=30000          # Per-query cap; kills runaway queries.

# AUDIT-2026-08-22 — pg-boss connection budget. pg-boss v12 defaults to max=10,
# which on top of the request pool put ~20 client connections against the
# 15-slot Supabase Free ceiling that PG_POOL_MAX is sized around.
#
# AUDIT-2026-08-22 (AUDIT-BOSS-POOL-2) — the first bound (4) was derived from a
# wrong worker count. pg-boss actually registers SIX workers (case-intelligence,
# case-reprocess, auto-assign, specialty-classify, sla-sweep, ai-canary), three
# of them with teamSize 2, plus its own maintenance and monitor connections. At
# max=4 its fetch/complete queries queue behind its own pool and sla-sweep /
# auto-assign stall. The corrected split:
#   8 (request pool) + 6 (pg-boss) + 1 (Supabase internals / burst) = 15
# The boot-time migration advisory-lock client is a further connection but is
# closed before pg-boss starts, so the two never coincide.
# Raise ONLY together with the Supabase tier, and keep
# PG_POOL_MAX + PG_BOSS_POOL_MAX <= 14.
# PG_BOSS_POOL_MAX=6

# AUDIT-2026-08-22 — how timezone + statement_timeout reach the backend.
#
# DATABASE_URL on Render is the Supabase TRANSACTION-mode pooler (port 6543). A
# `SET` there configures ONE arbitrary backend, so src/pg.js sends both settings
# in the STARTUP packet instead, by appending
#   ?options=-c%20timezone%3DUTC%20-c%20statement_timeout%3D30000
# to the connection string. Startup options are applied by the backend itself, so
# every backend the pooler can route to carries them.
#
# AUDIT-2026-08-22 (AUDIT-STARTUP-OPTIONS-2) — **THE DEFAULT IS NOW OFF.**
# Supavisor (the Supabase pooler DATABASE_URL points at) consumes the `options`
# startup parameter ITSELF, for `reference=<project-ref>` tenant routing. Sending
# our own `-c ...` there hands a value to a parser looking for something else,
# and the failure mode is total: every pool connection fails, the first migration
# query throws, the process exits ~2s into boot. Not worth gambling a deploy on.
#
#   PG_STARTUP_OPTIONS=          (unset — the default) no options sent.
#   PG_STARTUP_OPTIONS=off       explicit off, same thing.
#   PG_STARTUP_OPTIONS=on        opt in: sends `-c timezone=UTC -c statement_timeout=<ms>`.
#   PG_STARTUP_OPTIONS='-c ...'  opt in with exactly this string.
#
# Opting in is now recoverable: src/pg.js preflightPool() runs before the first
# migration query, and if the connection fails with startup options in play it
# strips them, retries once and logs loudly instead of letting the boot die.
# PG_STARTUP_OPTIONS=

# Boot-time verification of the above: opens 5 concurrent pool connections ~15s
# after start and logs the timezone / statement_timeout each one actually
# reports. Grep the deploy log for `[pg] verified on`. Set to `off` to skip.
# PG_VERIFY_SETTINGS=on

# ══ REQUIRED, NOT "BELT AND BRACES" ══════════════════════════════════════════
# Since PG_STARTUP_OPTIONS defaults to off, THIS is now the primary mechanism by
# which timezone and statement_timeout reach the backend. Run it once per
# environment, as the database owner:
#
#   ALTER ROLE postgres SET timezone = 'UTC';
#   ALTER ROLE postgres SET statement_timeout = '30s';
#
# Role defaults are applied by the SERVER at backend start regardless of pooler
# or client, which is the property the `options` startup parameter was reaching
# for. This is also what Supabase itself recommends for statement_timeout.
#
# Verify it took: grep the deploy log for `[pg] verified on`. Without it, naive
# timestamp columns (refunds.refunded_at, appointments.scheduled_at, cases.*) are
# read at the role's default offset — Africa/Cairo on this project — and a
# runaway query can hold a pool slot indefinitely.
#
# NOTE: the '30s' role default does NOT apply to the migration runner. src/db.js
# issues `SET statement_timeout = 0` on its dedicated advisory-lock session, so a
# long index build cannot be cancelled into a permanent crash-loop.

# ── Clock ─────────────────────────────────────────────────────────────────────
# TZ is read in src/server.js and FORCED to UTC at boot regardless of what you
# set here — it is listed for documentation, not as a knob. Setting it to
# anything else logs a warning and is then overridden.
#
# Why it is not configurable: the SLA deadline columns are `timestamp WITHOUT
# time zone` and every write to them is a JS .toISOString(), i.e. UTC. src/pg.js
# pins the DB session to UTC so SQL-side comparisons agree. If the Node process
# ran on a different offset, the JS-side halves (secondsUntilDeadline,
# sla_status.js, the doctor countdown) would drift from the DB by that offset
# and cases would breach early. Both halves have to be UTC or neither is right.
#
# Confirm on a running instance by grepping the boot log for: [tz] db=UTC node=UTC (ok)
# TZ=UTC

# ══ SLA Worker ═══════════════════════════════════════════════════════════════
#
#  ####################################################################
#  #  AUDIT-2026-08-22 — READ THIS BEFORE CHANGING SLA_MODE.          #
#  #                                                                  #
#  #  SLA_MODE=passive DOES NOT MEAN "less aggressive". IT MEANS THE  #
#  #  PLATFORM DOES NOT SEND ANYTHING.                                #
#  ####################################################################
#
# src/server.js registers the following INSIDE `if (CONFIG.SLA_MODE ===
# 'primary')`. In `passive` every one of them is simply never started:
#
#   * notification_worker  — the ONLY thing that drains the notifications
#                            table to email / WhatsApp / push. In passive,
#                            notifications are still WRITTEN, so the in-app
#                            bell keeps filling and looks healthy, and NOT ONE
#                            of them is ever delivered. Forever. Silently.
#   * case_sla_worker      — SLA breach detection, reassignment, breach refunds
#   * acceptance_watcher   — the doctor broadcast/accept handshake
#   * video scheduler, appointment + payment reminders, conversation auto-close
#
# ── WHERE EACH VALUE LIVES ───────────────────────────────────────────────────
#
# PRODUCTION VALUE IS `primary`, and it is set in **render.yaml**, not here.
# render.yaml is the reviewable source of truth for every production value; this
# file is a DEVELOPER TEMPLATE and ships the value that is safe to copy.
#
#  ####################################################################
#  #  AUDIT-2026-08-22 (AUDIT-DEVENV-PRIMARY-1)                       #
#  #  THIS FILE SHIPPED SLA_MODE=primary FOR ONE REVISION. DO NOT     #
#  #  PUT IT BACK.                                                    #
#  #                                                                  #
#  #  A developer copies .env.example to .env and points              #
#  #  DATABASE_URL at anything shared — a teammate's Supabase branch,  #
#  #  a restored prod dump, prod itself. With SLA_MODE=primary that    #
#  #  .env then:                                                       #
#  #    * starts notification_worker, which DRAINS the real            #
#  #      `notifications` table to real Resend recipients and real     #
#  #      WhatsApp numbers (EMAIL_ENABLED and                          #
#  #      NOTIFICATION_WORKER_ENABLED both default true below);        #
#  #    * runs the SLA sweep from a laptop — reassigning cases,        #
#  #      issuing breach refunds, auto-pausing doctors;                #
#  #    * races the production primary, because pg-boss's singleton    #
#  #      only deduplicates instances sharing ONE database, which is   #
#  #      exactly the situation.                                       #
#  #                                                                   #
#  #  The bug this replaced — "the file shipped passive and nobody     #
#  #  noticed the platform sent nothing" — is a DOCUMENTATION bug, and #
#  #  the banner at the top of this section is its fix. Production     #
#  #  correctness is render.yaml's job.                                #
#  ####################################################################
#
# Production runs primary on EXACTLY ONE instance. Render production is a
# single-instance service (disk-attached services cannot scale out), so primary
# is correct there. If a second instance is ever added it must run `passive` —
# two primaries double-send and race the SLA sweep.
#
# TO RUN THE SENDING WORKERS LOCALLY (deliberate, three separate acts — this is
# the point; none of them can happen by copying a file):
#   1. Confirm DATABASE_URL points at a database YOU OWN and nobody else uses.
#   2. Set EMAIL_TEST_STUB=true and WHATSAPP_TEST_STUB=true unless you
#      specifically intend to send to real addresses/numbers.
#   3. Uncomment all three lines below.
# bootCheck.js enforces 2-of-3 of that on its own: SLA_MODE=primary exits 1
# without SLA_PRIMARY_TOKEN=YES_I_UNDERSTAND (bootCheck.js:47-53), and again in
# MODE=development without ALLOW_PRIMARY_IN_DEV=true (bootCheck.js:58-69).
SLA_MODE=passive                        # dev template value. PRODUCTION IS `primary` — see render.yaml

# AUDIT-2026-08-22 (AUDIT-SLA-WEEKEND-1) — which days the urgent SLA window is
# open. Unset means ALL SEVEN DAYS, which is the behaviour that shipped before
# this variable existed; leave it unset until you know your actual radiologist
# roster. Set it and the urgent clock for a case paid outside the window is
# anchored to 07:00 Cairo on the next WORKING day instead of the next calendar
# day, so you stop selling a 4h turnaround against a day nobody is rostered.
# Accepts indices (0=Sunday) or short names:
#   URGENT_WINDOW_WORKING_DAYS=0,1,2,3,4
#   URGENT_WINDOW_WORKING_DAYS=sun,mon,tue,wed,thu
# NOTE: this currently gates the PAYMENT-side anchor only. Intake still offers
# urgent on any day (routes/patient.js, routes/api/cases.js call the bare
# hour-only helpers) — close that before setting this in production, or the
# sell side and the pay side will disagree.
# URGENT_WINDOW_WORKING_DAYS=

# AUDIT-2026-08-22 — boot and migration safety valves. All three are optional;
# the defaults are the safe values.
#
# STRICT_ENV_ASSERTS: when true, a missing NATIONAL_ID_ENCRYPTION_KEY or
# OPENCLAW_BASE_URL/OPENCLAW_SEND_KEY fails the boot instead of warning. Leave
# it off for the first deploy that introduces those checks, set the secrets in
# Render, confirm the log shows no BOOT CHECK WARNING, then turn it on so a
# later regression fails the deploy rather than shipping silently.
# STRICT_ENV_ASSERTS=false
#
# MIGRATION_LOCK_WAIT_MS: how long to wait for the migration advisory lock
# before giving up and migrating unlocked (default 120000). The wait exists so
# two instances booting together cannot run the same migration twice; the
# give-up exists so a lock orphaned by a SIGKILLed instance cannot stop every
# subsequent boot from binding a port.
# MIGRATION_LOCK_WAIT_MS=120000
#
# MIGRATION_LOCK_CONNECT_TIMEOUT_MS: connect timeout for the dedicated
# DATABASE_URL_DIRECT client that holds that lock (default 15000).
# MIGRATION_LOCK_CONNECT_TIMEOUT_MS=15000
# SLA_MODE=primary                      # ← starts every sender. Read the banner above first.
# SLA_PRIMARY_TOKEN=YES_I_UNDERSTAND    # REQUIRED when SLA_MODE=primary, or boot exits 1
# ALLOW_PRIMARY_IN_DEV=true             # REQUIRED when MODE=development AND SLA_MODE=primary
SLA_ENFORCEMENT_ENABLED=1
SLA_ENFORCEMENT_INTERVAL_MS=300000     # 5 minutes
SLA_REMINDER_MINUTES=60
SLA_DRY_RUN=false

# P1-FIN-2: auto-pause repeat SLA breachers from new assignments.
# When a doctor accumulates SLA_AUTO_PAUSE_BREACHES reassignment-out
# events within SLA_AUTO_PAUSE_WINDOW_DAYS days, users.is_paused is
# flipped true (excluded from open-pool routing; existing cases continue;
# login still works). Set BREACHES=0 to disable the auto-pause behavior.
# Referenced by the Specialist Code of Conduct §6.2 — change both together.
SLA_AUTO_PAUSE_BREACHES=3
SLA_AUTO_PAUSE_WINDOW_DAYS=30

# Per-doctor SLA tuning (defaults shown; uncomment to override).
#
# AUDIT-ACCEPT-1 — DOCTOR_RESPONSE_TIMEOUT_HOURS no longer sets the acceptance
# window. Those are policy and live in src/acceptance_window.js: urgent 15 min,
# VIP 45 min, standard 2 hours. They are deliberately NOT env-tunable, because
# the SLA clock starts at acceptance and the window is therefore added in full
# to the turnaround the patient was sold — the two have to move together, and
# the patient-facing copy with them.
#
# This variable is now only a FALLBACK for legacy assignment rows written before
# doctor_assignments.accept_by_at existed. It tracks the standard tier, so the
# effective default is 2 hours rather than the 24 it used to be.
#
# MAX_ACTIVE_CASES_PER_DOCTOR caps simultaneously-active cases before the
# assigner skips a doctor (src/case_sla_worker.js).
# DOCTOR_RESPONSE_TIMEOUT_HOURS=24
#
# AUDIT-P0 follow-up: this value now only ages a diagnostic counter. Legacy
# doctor_assignments rows with a NULL accept_by_at are SKIPPED by the timeout
# sweep rather than timed out, because any wall-clock cutoff matches all of
# them at once -- which on the first sweep after deploy would have mass-
# reassigned the live book and fired a 10% clawback against every doctor
# holding one. Backfill accept_by_at in batches to hand those cases back.
# MAX_ACTIVE_CASES_PER_DOCTOR=4

# ── Payments (Paymob) ─────────────────────────────────────────────────────────
# Three API keys live in: Paymob dashboard → Settings → API Keys
PAYMOB_PUBLIC_KEY=                      # Settings → API Keys → Public Key
PAYMOB_SECRET_KEY=                      # Settings → API Keys → Secret Key
PAYMOB_HMAC_SECRET=                     # Settings → Account Info → HMAC field
# Card integration ID for the Unified Intention API:
PAYMOB_CARD_INTEGRATION_ID=             # Payments → Integrations → (your card integration) → ID
# OPTIONAL Apple Pay integration ID (Payments → Integrations → your Apple Pay integration → ID).
# Leave EMPTY until Paymob provisions Apple Pay — the code is inert when unset/invalid (card-only).
PAYMOB_APPLEPAY_INTEGRATION_ID=         # optional; adds Apple Pay to the checkout when set to a positive integer
# Public webhook URL Paymob calls on transaction events.
# Also set this exact URL in the Paymob dashboard: Payments → Integrations → Transaction Processed Callback
PAYMOB_NOTIFICATION_URL=                # e.g. https://tashkheesa.com/payments/callback
# Mode safety guard. services/paymob.js throws if not 'test' — switching to
# live requires editing services/paymob.js intentionally.
PAYMOB_MODE=test                        # test | live (live not permitted in code yet)
# Wizard step-5 routing: 'stub' bounces the patient to /payment-success?stub=1
# (which calls markCasePaid() server-side); 'live' redirects to
# /portal/patient/pay/:id, which posts to /payments/paymob/create-intention
# and hands off to Paymob. Read per-request — no boot caching, so an env
# flip takes effect on the next click. Independent of PAYMOB_MODE: the
# safe testing posture is PAYMENT_MODE=live + PAYMOB_MODE=test (wizard
# reaches Paymob sandbox, real card flow with test cards). Going to real
# Paymob is a separate deliberate flip of PAYMOB_MODE.
PAYMENT_MODE=stub                       # stub | live

# How long a previously-minted Paymob intention may be REUSED when the patient
# clicks Pay Now again and nothing about the charge has changed (amount +
# currency must match the recorded 'intention_created' event). Bounded 1-720;
# anything outside that, or unset, falls back to 30. Keep it comfortably under
# Paymob's client_secret lifetime — reusing an expired checkout is a dead end
# the patient cannot escape by reloading. Read in src/routes/payments.js.
# PAYMOB_INTENTION_REUSE_MINUTES=30       # default 30, valid 1-720

# ── PAYMOB_REQUIRE_INTENTION_BINDING (default: false — LEAVE UNSET FOR LAUNCH) ─
# Webhook hardening in src/routes/payments.js /callback. When TRUE, a callback
# for an order that has a stored paymob_intention_id MUST itself carry
# obj.intention.id, or the order is left UNPAID and filed as a binding failure.
#
# It defaults to FALSE because obj.intention.id is NOT part of Paymob's
# HMAC-signed field set and we have not yet observed a real live callback that
# contains it. If it turns out Paymob does not send it, turning this on parks
# EVERY payment as unpaid while the patient's card is charged.
#
# The MISMATCH half of the same control is always on and is not affected by
# this flag: it fires only when the callback and the order both carry an
# intention id and they differ, which is never innocent.
#
# Verification before flipping to true (do this AFTER launch):
#   1. Take one real test-mode payment end to end.
#   2. psql> SELECT received_at, paymob_transaction_id, paymob_intention_id
#              FROM payment_events WHERE event_type = 'payment_succeeded'
#              ORDER BY received_at DESC LIMIT 5;
#   3. paymob_intention_id non-null on every row → safe to set this to true.
#      NULL on any row → Paymob does not send it; leave this unset.
# PAYMOB_REQUIRE_INTENTION_BINDING=false  # false (default) | true

# Escape hatch for the boot validator (src/server.js). In staging/production
# the server FATALs at boot unless PAYMENT_MODE=live AND PAYMOB_MODE=live, so
# patients can never be simulated-charged in prod. Set to 1 on STAGING only to
# boot with stubbed/sandbox payments. Leave UNSET in production.
# ALLOW_NON_LIVE_PAYMENTS=1

# ── API Keys ──────────────────────────────────────────────────────────────────
TASH_API_KEY=REPLACE_WITH_STRONG_RANDOM_KEY
PUBLIC_ORDER_API_KEY=REPLACE_WITH_STRONG_RANDOM_KEY
UNSUBSCRIBE_SECRET=REPLACE_WITH_STRONG_RANDOM_KEY

# ── AI Services ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                      # Anthropic console → API Keys
OPENAI_API_KEY=                         # Optional: OpenAI fallback

# ── AI: Anthropic model selection (Theme 9 Sub-issue D) ──────────────────────
# Override the per-pipeline default model. Leave blank to use the in-code
# default in src/config/anthropic.js, which tracks the canonical Claude family
# at deploy time. Update on Anthropic model rotation — no code change required.
# Verify Active status: https://docs.claude.com/en/docs/about-claude/model-deprecations
ANTHROPIC_MODEL_SONNET=                 # default: claude-sonnet-4-6 (case extraction + chat)
ANTHROPIC_MODEL_HAIKU=                  # default: claude-haiku-4-5 (fast triage)
ANTHROPIC_MODEL_VISION=                 # default: claude-sonnet-4-6 (image quality check)

# ── File Storage: Uploadcare (patient medical photos, doctor signup widget) ──
# Patient medical photos and doctor profile photos at signup are uploaded
# directly to ucarecdn.com from the browser via the Uploadcare 3.x widget.
# Server-side stores only the resulting URL string — there is no server-side
# Uploadcare API surface today (see src/server.js validator comment for why
# UPLOADCARE_SECRET_KEY is documented but not validated).
UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_SECRET_KEY=

# ── File Storage: Cloudflare R2 (case files, prescriptions, doctor photos) ───
# REQUIRED in staging/production. R2 stores server-generated artefacts and
# multipart uploads that don't go through the Uploadcare widget:
#   - prescription PDFs (src/routes/prescriptions.js — writer + reader)
#   - case reports (src/report-generator.js — writer)
#   - doctor profile photos + signatures (src/routes/doctor.js — writer + reader)
#   - patient case attachments via the order intake form (src/routes/order_flow.js)
#   - mobile API prescription downloads (src/routes/api_v1.js)
#   - generic GET /files/:id signed-URL serve (src/server.js)
# Files are served via 1-hour signed URLs; no public R2 URLs leak. If any of
# the four vars is missing in staging/production, src/server.js
# validateCriticalEnvVars hard-exits at boot. In development the server boots
# with a warning (src/storage.js:19) and uploads/downloads fail inside the
# request handler with "File temporarily unavailable" until the vars are set.
#
# Get the values from: Cloudflare → R2 → Manage R2 API Tokens → Create Account
# API Token (admin read+write on the bucket). The endpoint is on the bucket
# overview page; the bucket must exist before tokens can be scoped to it.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── Theme 13: Uploadcare → R2 cutover flag ──────────────────────────────────
# Optional. Default 'false' (or unset) keeps the legacy Uploadcare widget on
# the patient new-case wizard and order-detail page. Set to 'true' to mount
# the new POST /portal/patient/files endpoint that pushes patient case files
# directly to R2 (replaces the Uploadcare 3.x widget).
#
# Rollback: flip to 'false' and restart — the legacy widget continues to
# render. Both code paths coexist during the migration window per
# docs/audits/THEME_13_R2_MIGRATION_FIX_PLAN.md §7.
#
# Read by src/server.js (route mount gate) and the wizard EJS to switch
# between the FormData uploader and the legacy widget.
UPLOAD_R2_DIRECT_ENABLED=false

# ── Theme 13 C2: messages-attach R2 cutover flag ────────────────────────────
# Optional. Default 'false' (or unset) keeps the legacy Uploadcare widget on
# the patient_order.ejs messages-attach paperclip button. Set to 'true' to
# render the new FormData-based widget that posts directly to R2 with
# folder=messages-attach.
#
# AND-gated with UPLOAD_R2_DIRECT_ENABLED in patient_order.ejs — both must
# be 'true' to activate the R2 messages-attach widget. The AND-gate prevents
# the misconfigured state "wizard on R2, messages on Uploadcare" (per
# THEME_13_C2_FIX_PLAN.md §8 Q3).
#
# Rollback: flip to 'false' and restart — the legacy Uploadcare widget
# renders unchanged (byte-identical to pre-Theme-13 behaviour).
MESSAGES_R2_ENABLED=false

# ── Email (Resend HTTP API) ───────────────────────────────────────────────────
# Migrated from Gmail SMTP / nodemailer to Resend on 2026-04-30
# (see src/services/emailService.js header). Resend is now the only transport;
# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_SECURE have been removed
# from this file because nothing in the codebase reads them.
#
# RESEND_API_KEY is REQUIRED in staging/production for all transactional email:
# case lifecycle notifications, password reset, payment receipts, doctor signup
# verification. Without it, src/server.js validateCriticalEnvVars hard-exits at
# boot. In development the server boots with a warning and lifecycle email
# silently stubs (sendMail returns {stub: true}).
# Get the key from: https://resend.com → API Keys.
RESEND_API_KEY=
# AUDIT-2026-08-22 (AUDIT-DEVENV-PRIMARY-1) — `true` here matches production so
# email bugs are reproducible locally. It is SAFE only because this file also
# ships SLA_MODE=passive, which never starts notification_worker — the thing
# that drains the notifications table to Resend. If you flip SLA_MODE=primary,
# set EMAIL_TEST_STUB=true at the same time unless you intend real sends. Note
# that request-driven email (admin password-reset links, contact form) is NOT
# gated by SLA_MODE and will reach real inboxes whenever RESEND_API_KEY is set.
EMAIL_ENABLED=true

# Resend "from" identity. Variable names are kept from the pre-2026-04-30 SMTP
# era for backward compatibility with src/routes/static-pages.js (which reads
# SMTP_FROM_EMAIL as a contact-form recipient default). They configure the
# Resend "from" header only — they do NOT configure SMTP transport.
SMTP_FROM_EMAIL=noreply@tashkheesa.com
SMTP_FROM_NAME=Tashkheesa

# Reply-to address for warm-touch transactional emails (doctor onboarding,
# founder-signed welcome messages). Recipients hitting "Reply" land here
# instead of the unmonitored noreply@ from-address. Only templates listed
# in TEMPLATES_WITH_REPLY_TO (src/notification_worker.js) opt in — system
# alerts and automated notifications stay on noreply@. Default is a
# monitored inbox that forwards to founder + ops.
SMTP_REPLY_TO_EMAIL=info@tashkheesa.com

# Recipient of the public doctor-application (/apply) notification email. Sent
# post-commit + best-effort via emailService.sendMail (never blocks/rolls back a
# submission). Optional — defaults to info@tashkheesa.com when unset.
APPLICATIONS_NOTIFY_EMAIL=info@tashkheesa.com

# Recipient guard: hardcoded blocklist (demo.local, example.com, test.com, …)
# is ALWAYS enforced. EMAIL_GUARD_STRICT additionally enables MX-record
# validation. Default OFF for the first ~30 days while we monitor
# blocked_send_attempts for false positives against legitimate domains under
# Render's DNS. Flip to true after 30 days if no false positives observed.
EMAIL_GUARD_STRICT=false

# ── WhatsApp notifications: master flag + transport selector ─────────────────
# Master kill-switch for WhatsApp case-lifecycle notifications, independent
# of WHATSAPP_ENABLED (which gates the Meta Cloud API path only). Default
# OFF — flip to true on Render after the OpenClaw endpoint is confirmed
# live so the WhatsApp-via-OpenClaw rollout can be staged via env without
# a redeploy. Does NOT affect OTP delivery (separate code path).
NOTIFICATIONS_WHATSAPP_ENABLED=false

# Which WhatsApp transport to route case-lifecycle sends through:
#   meta     — graph.facebook.com Cloud API (legacy; currently blocked
#              pending Meta Business verification).
#   openclaw — OpenClaw HTTP gateway on the Mac mini, using a personal SIM.
# Default 'meta' so flipping NOTIFICATIONS_WHATSAPP_ENABLED on without
# also flipping this var doesn't silently change transports.
# AUDIT-P0: default flipped meta -> openclaw. Meta is blocked pending Business
# verification (see the note above), and every entry in whatsappTemplateMap.js
# hardcoded lang:'en', so the Meta path could never deliver Arabic -- the
# primary market. Leave this on openclaw unless Meta HSM approval has landed
# AND *_ar variants are approved. The code default matches this value.
NOTIFICATIONS_WHATSAPP_TRANSPORT=openclaw

# ── AUDIT-2026-08-22 — NOW BOOT-VALIDATED ────────────────────────────────────
# With either OPENCLAW_BASE_URL or OPENCLAW_SEND_KEY unset,
# src/lib/openclaw_client.js:60-71 returns { ok:false, error:'oc_env_misconfigured' }
# for EVERY send. Nothing throws, nothing exits — WhatsApp simply never arrives,
# while the in-app bell keeps filling. Neither var was in server.js's prodRequired
# list, so a launch deploy could boot green and deliver ZERO WhatsApp on day one.
# src/bootCheck.js now hard-fails in staging/production when
# NOTIFICATIONS_WHATSAPP_ENABLED=true and NOTIFICATIONS_WHATSAPP_TRANSPORT=openclaw
# and either of these is missing. To ship deliberately without WhatsApp, set
# NOTIFICATIONS_WHATSAPP_ENABLED=false — bootCheck then warns instead of failing.

# OpenClaw gateway endpoint (Tailscale-only; never publicly exposed).
# Required when NOTIFICATIONS_WHATSAPP_TRANSPORT=openclaw. The portal POSTs
# to `${OPENCLAW_BASE_URL}/send` with header `x-openclaw-key` and body
# `{ to, lang, body, ref }`. See src/lib/openclaw_client.js.
OPENCLAW_BASE_URL=

# Shared secret OpenClaw expects on inbound /send requests, and that the
# portal expects on inbound /api/openclaw/opt-in and /opt-out requests
# (called by OpenClaw's reply-STOP/START handler). Distinct from
# TASH_API_KEY so the two directions can rotate independently.
OPENCLAW_SEND_KEY=

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v22.0
# Meta-approved authentication-category template used for mobile-app OTP delivery.
# Must exist in WhatsApp Business Manager and accept ONE body parameter (the OTP code).
# When unset (or token missing), src/services/whatsapp_otp.js stubs and the OTP route
# returns "OTP generated. SMS delivery is not configured" so the OTP can be read from
# the otp_codes table in dev.
WHATSAPP_OTP_TEMPLATE_NAME=otp_verify_en
WHATSAPP_OTP_TEMPLATE_LANG=en

# ── Critical Alerts ──────────────────────────────────────────────────────────
# Admin phone for crash alerts via WhatsApp (digits with country code, no +)
ADMIN_PHONE=

# Theme 9 Sub-issue B: critical-alert WhatsApp template.
# Required for sendCriticalAlert to fire outside Meta's 24h customer-service
# window. Provision a utility-category template via Meta Business Manager
# with ONE body parameter (the alert text). Until this env is set,
# sendCriticalAlert logs every attempt as `template_not_configured` in
# critical_alert_log + error_logs but does not call Meta.
# LAUNCH BLOCKER IF UNSET. sendCriticalAlert() returns early when this is
# empty, so every alert path -- unhandledRejection, worker-down, error-rate,
# Paymob HMAC failure, intention mismatch, video amount mismatch, markCasePaid
# failure -- silently no-ops. Nothing can page anyone until this is set.
CRITICAL_ALERT_TEMPLATE_NAME=
CRITICAL_ALERT_TEMPLATE_LANG=en

# ── Twilio ───────────────────────────────────────────────────────────────────
# Shared credentials (used by both Video and OTP Verify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Twilio Verify — OTP delivery for mobile app login (SMS)
# Create at: console.twilio.com → Verify → Services → Create Service
# Set the service friendly name to "Tashkheesa" so SMS reads:
#   "Your Tashkheesa verification code is: 847291"
TWILIO_VERIFY_SERVICE_SID=

# Video Consultations
VIDEO_CONSULTATION_ENABLED=false
TWILIO_API_KEY=
TWILIO_API_SECRET=

# ── Instagram / Social ────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
FB_PAGE_ID=
MEDIA_BASE_URL=https://tashkheesa.com

# ── Cloudinary (Instagram image hosting) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Notification Worker ───────────────────────────────────────────────────────
# AUDIT-2026-08-22 (AUDIT-DEVENV-PRIMARY-1) — this flag is a SECOND gate, not the
# first one: the worker is only registered at all when SLA_MODE=primary
# (src/server.js). With the SLA_MODE=passive this file ships, `true` here starts
# nothing. Production sets both, in render.yaml.
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=30000
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_DRY_RUN=false

# ── Smoke Tests ───────────────────────────────────────────────────────────────
SMOKE_BASE_URL=http://localhost:3000

# ── Ops Dashboard ───────────────────────────────────────────────────────────
OPS_USER=                               # Username for /ops login
OPS_PASS=                               # Password for /ops login
OPS_SSH_HOST=100.106.122.55             # Mac mini Tailscale IP for agent monitoring
OPS_SSH_USER=macmini                    # SSH user on Mac mini
OPS_SSH_KEY_PATH=                       # Path to SSH private key (e.g. /etc/secrets/render_ops_key)

# Theme 3 Stage 1 — optional. When set, /ops/agent/* routes log
# "agent <route> signed OK" if the X-Ops-Agent-Key request header matches;
# otherwise log "agent <route> unsigned" but continue (no rejection).
# Stage 2 cutover (after one full uptime cycle with signing observed in
# logs) flips to mandatory and the validator promotes this to prodRequired.
# See docs/runbooks/THEME_03_OPS_AGENT_KEY_CUTOVER.md.
OPS_AGENT_KEY=

# ── Mobile App Links ────────────────────────────────────────────────────────
# Public URL the iOS landing page uses to point patients at TestFlight before
# App Store launch (src/routes/app_landing.js:42). Safe default
# https://tashkheesa.com/app keeps the page rendering; override on staging or
# when TestFlight invitation URLs change.
TESTFLIGHT_URL=

# ── Undocumented reads, now documented ───────────────────────────────────────
# AUDIT-M2 — these are read in src/ but were neither validated at boot nor
# listed here, so a deployer had no way to know they existed. All are optional;
# the defaults shown are what the code falls back to.

# Restricts the Command app's admin API to a single account, as defence in depth
# on top of the role gate (src/routes/api/admin.js). Defaults to the Shifa
# superadmin address, so leaving it unset FAILS CLOSED — it does not open access.
# SUPERADMIN_EMAIL=ziad.wahsh@shifaegypt.com

# Coming-soon SMS sender identity (src/notify/coming_soon.js). With NEITHER set,
# every coming-soon SMS fails closed with `twilio_from_not_configured` — safe,
# but silent, so set one deliberately rather than by omission.
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_SMS_FROM=

# Outside production, WhatsApp sends are blocked unless the recipient is on this
# comma-separated allowlist (src/notify/whatsapp.js). Unset means ALL non-prod
# WhatsApp is blocked, reported only as a console.warn.
# WHATSAPP_TEST_RECIPIENTS=+201001234567,+201009876543

# AI specialty routing (src/services/ai/specialtyRouter.js). Currently PARKED —
# the router is mounted nowhere. Kill switch is opt-IN: routing is off unless
# explicitly 'true'.
# AI_SPECIALTY_ROUTING_ENABLED=false
# AI_SPECIALTY_ROUTING_MODEL=            # falls back to src/config/anthropic.js
# AI_SPECIALTY_ROUTING_TIMEOUT_MS=8000

# AI canary — a scheduled probe that trips the AI health card when the
# Anthropic credit/billing state fails (src/job_queue.js, src/services/ai_health.js).
# AI_CANARY_CRON=0 */3 * * *
# AI_CANARY_STALE_HOURS=6

# Classification transport. false = synchronous fallback for rollback
# (src/services/classify_job.js).
# CLASSIFIER_ASYNC=true

# ── AUDIT-2026-08-22: 18 more reads in src/, previously undocumented ─────────
# Every entry below is read by src/ and was absent from this file, so a deployer
# had no way to know it existed. All are optional unless stated; the value shown
# is the code's fallback.

# Branding shown in the doctor portal shell and email/dashboard headers
# (src/middleware.js:199, src/routes/doctor.js:140).
# BRAND_NAME=Tashkheesa

# Cookie name for the patient/doctor language preference (src/routes/auth.js:25).
# Changing it on a live deploy resets everyone's language to the default.
# LANG_COOKIE_NAME=lang

# Add-on system v2. DORMANT unless exactly 'true' (src/services/addons/registry.js:41).
# When false, POST /addons returns "ADDON_SYSTEM_V2 is disabled" and the v2
# dual-writes in routes/payments.js + routes/video.js are skipped. Leave OFF for
# launch — Phase 3 flips it.
# ADDON_SYSTEM_V2=false

# ── Test stubs — NEVER set any of these in production ────────────────────────
# Each one short-circuits a real send and returns success. Together they make a
# deploy look perfectly healthy while delivering nothing.

# Short-circuits WhatsApp (src/notify/whatsapp.js:63, src/lib/openclaw_client.js:25).
# src/bootCheck.js warns loudly if this is 'true' in staging/production.
# WHATSAPP_TEST_STUB=false

# Short-circuits transactional email (src/services/emailService.js:48).
# EMAIL_TEST_STUB=false

# Seeds demo users/orders at boot when set to exactly '1' (src/server.js:869).
# Production data pollution risk — leave unset outside local dev.
# SEED_DEMO_DATA=

# Dumps the doctor-dashboard SLA computation to stdout for one request when set
# to '1' (src/routes/doctor.js:194). Verbose; local debugging only.
# DEBUG_DASHBOARD_SLA=

# ── Attribution on blocked outbound sends ────────────────────────────────────
# Written to blocked_send_attempts.agent_name / .skill_name so a blocked email
# can be traced back to the automation that tried to send it
# (src/services/recipientGuard.js:155-156). Set these on agent/cron processes,
# not on the web service.
# AGENT_NAME=
# SKILL_NAME=

# ── Uploadcare public-key fallbacks ──────────────────────────────────────────
# UPLOADCARE_PUBLIC_KEY (above, in File Storage) is the canonical name and the
# one src/server.js validates in staging/production. src/routes/verify.js:100-104
# additionally falls back to these two older spellings when reporting the
# diagnostic snapshot. Set UPLOADCARE_PUBLIC_KEY; these exist so an environment
# still carrying an old name is not reported as unconfigured.
# UPLOADCARE_PUBLIC=
# UPLOADCARE_KEY=

# ── Release / preflight ──────────────────────────────────────────────────────
# AUDIT-2026-08-22 — scripts/preflight.js runs scripts/backup-db.js but DEGRADES
# to a warning when pg_dump is not installed (exit 3) or DATABASE_URL_DIRECT is
# unset (exit 2), instead of aborting the whole preflight. Set this to 1 to make
# any non-zero exit fatal — RELEASE_CHECKLIST.md §2 and §6 require a real,
# verified dump, and a warning is not a backup.
# PREFLIGHT_REQUIRE_BACKUP=1

# ── Git / Deploy ──────────────────────────────────────────────────────────────
# Build/commit identity for GET /__version and the ops dashboard. src/server.js:
# 33-38 reads them in this order and falls back to `git rev-parse --short HEAD`:
#   GIT_SHA → COMMIT_SHA → RENDER_GIT_COMMIT → RENDER_COMMIT
# On Render the RENDER_* ones are injected automatically and none of these need
# setting; set GIT_SHA explicitly only in a build that has no .git directory.
# GIT_SHA=
# COMMIT_SHA=
# RENDER_GIT_COMMIT=       # injected by Render
# RENDER_COMMIT=           # injected by Render (older name)

# Injected automatically by Render. RENDER_SERVICE_NAME is NOT cosmetic:
# src/auth.js:142 treats a service whose name matches /staging/i as staging and
# changes auth behaviour accordingly. Renaming the Render service changes that.
# RENDER_SERVICE_ID, RENDER_SERVICE_NAME
