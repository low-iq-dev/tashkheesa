<!-- New Case Available — open-pool broadcast to eligible doctors (A3 2026-09-09) -->
<h2 style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:#0B6B5F;" dir="rtl">
  حالة جديدة متاحة في تخصصك
</h2>

<p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4A4640;" dir="rtl">
  أهلاً د. {{doctorName}}،
</p>

<p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4A4640;" dir="rtl">
  في حالة جديدة مدفوعة في تخصصك متاحة للقبول دلوقتي. الحالة معروضة على كل الأطباء
  المؤهلين &mdash; أول واحد يقبلها بياخدها. افتح قائمتك وراجع الحالة واقبلها قبل ما
  تقفل مهلة القبول.
</p>

<!-- Case details box -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:24px 0;background-color:#F4F1E9;border-radius:8px;border:1px solid #E3DED2;" dir="rtl">
  <tr>
    <td style="padding:20px 24px;">
      <p style="margin:0 0 8px 0;font-size:13px;font-weight:600;color:#0B6B5F;text-transform:uppercase;letter-spacing:0.5px;">تفاصيل الحالة</p>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        {{#if caseReference}}
        <tr>
          <td style="padding:6px 0;font-size:14px;color:#7A736A;width:160px;">الرقم المرجعي:</td>
          <td style="padding:6px 0;font-size:14px;font-weight:600;color:#2E2B26;">{{caseReference}}</td>
        </tr>
        {{/if}}
        {{#if acceptWindowMinutes}}
        <tr>
          <td style="padding:6px 0;font-size:14px;color:#7A736A;width:160px;">اقبلها خلال:</td>
          <td style="padding:6px 0;font-size:14px;font-weight:600;color:#c53030;">{{acceptWindowMinutes}} دقيقة</td>
        </tr>
        {{/if}}
      </table>
    </td>
  </tr>
</table>

<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto;">
  <tr>
    <td align="center" style="background-color:#0B6B5F;border-radius:8px;">
      <a href="{{appUrl}}/portal/doctor/dashboard" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;">
        افتح قائمتي
      </a>
    </td>
  </tr>
</table>

<p style="margin:24px 0 0 0;font-size:13px;color:#9A9287;line-height:1.5;" dir="rtl">
  الحالات بتتوزّع على أساس أول قبول. لو طبيب تاني قبلها قبلك، الحالة مش هتفضل ظاهرة في قائمتك.
</p>
