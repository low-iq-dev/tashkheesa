<!-- تم قبول الحالة — إشعار للمريض -->
<h2 style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:#0B6B5F;">
  أخصائي يراجع حالتك
</h2>

<p style="margin:0 0 16px 0;font-size:15px;line-height:1.8;color:#4A4640;">
  مرحباً {{patientName}}،
</p>

<p style="margin:0 0 16px 0;font-size:15px;line-height:1.8;color:#4A4640;">
  قبل أخصائي مؤهل حالتك وبدأ بمراجعة ملفاتك الطبية. ستتلقى تقريرك المفصل عند اكتمال المراجعة.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:24px 0;background-color:#F4F1E9;border-radius:8px;border:1px solid #E3DED2;">
  <tr>
    <td style="padding:20px 24px;">
      <p style="margin:0 0 8px 0;font-size:13px;font-weight:600;color:#0B6B5F;letter-spacing:0.5px;">الحالة قيد المراجعة</p>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        {{#if caseReference}}
        <tr>
          <td style="padding:6px 0;font-size:14px;color:#7A736A;width:140px;">رقم المرجع:</td>
          <td style="padding:6px 0;font-size:14px;font-weight:600;color:#2E2B26;">{{caseReference}}</td>
        </tr>
        {{/if}}
        {{#if specialty}}
        <tr>
          <td style="padding:6px 0;font-size:14px;color:#7A736A;width:140px;">التخصص:</td>
          <td style="padding:6px 0;font-size:14px;color:#2E2B26;">{{specialty}}</td>
        </tr>
        {{/if}}
        {{#if doctorName}}
        <tr>
          <td style="padding:6px 0;font-size:14px;color:#7A736A;width:140px;">الأخصائي:</td>
          <td style="padding:6px 0;font-size:14px;color:#2E2B26;">د. {{doctorName}}</td>
        </tr>
        {{/if}}
        {{#if slaHours}}
        <tr>
          <td style="padding:6px 0;font-size:14px;color:#7A736A;width:140px;">متوقع خلال:</td>
          <td style="padding:6px 0;font-size:14px;color:#2E2B26;">{{slaHours}} ساعة</td>
        </tr>
        {{/if}}
      </table>
    </td>
  </tr>
</table>

{{#if dashboardUrl}}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto;">
  <tr>
    <td align="center" style="background-color:#0B6B5F;border-radius:8px;">
      <a href="{{dashboardUrl}}" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;">
        تتبع حالتك
      </a>
    </td>
  </tr>
</table>
{{/if}}

<p style="margin:24px 0 0 0;font-size:13px;color:#9A9287;line-height:1.6;">
  ستتلقى إشعاراً آخر عندما يكون تقريرك جاهزاً للمراجعة.
</p>
