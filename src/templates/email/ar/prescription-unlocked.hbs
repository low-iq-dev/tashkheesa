<!-- AUDIT-2026-08-23 (C4) — النسخة العربية -->
<h2 style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:#1a365d;">
  تم فتح الروشتة
</h2>

<p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4a5568;">
  {{#if doctorName}}د. {{doctorName}}،{{else}}مرحباً،{{/if}}
</p>

<p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4a5568;">
  تم ترتيب الروشتة التي أوصيت بها في الحالة <strong>{{caseReference}}</strong> مع المريض.
  يمكنك الآن كتابتها من صفحة الحالة.
</p>

{{#if caseUrl}}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0 0 0;">
  <tr>
    <td align="center" style="background-color:#38b2ac;border-radius:8px;">
      <a href="{{caseUrl}}" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;">
        افتح الحالة
      </a>
    </td>
  </tr>
</table>
{{/if}}
