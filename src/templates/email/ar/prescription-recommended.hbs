<!-- AUDIT-2026-08-23 (C4) — النسخة العربية -->
<h2 style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:#0B6B5F;">
  استشاريك يوصي بروشتة طبية
</h2>

<p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4A4640;">
  مرحباً {{patientName}}،
</p>

<p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4A4640;">
  أثناء مراجعة الحالة <strong>{{caseReference}}</strong>، رأى استشاريك أن الروشتة الطبية ستكون مفيدة لك.
  الروشتة الرقمية خدمة إضافية منفصلة عن التقرير المكتوب{{#if addonPrice}}، بقيمة <strong>{{addonPrice}} {{addonCurrency}}</strong>{{/if}}.
</p>

<p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4A4640;">
  القرار لك وحدك. تقريرك المكتوب لن يتأثر وسيصلك في موعده في كل الأحوال. إذا رغبت في الروشتة،
  رُدّ على هذه الرسالة أو راسلنا على واتساب وسيتولى فريقنا الترتيب — ثم يصدرها استشاريك موقَّعة كملف PDF.
</p>

{{#if dashboardUrl}}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0 0 0;">
  <tr>
    <td align="center" style="background-color:#B38B3E;border-radius:8px;">
      <a href="{{dashboardUrl}}" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;">
        افتح حالتك
      </a>
    </td>
  </tr>
</table>
{{/if}}
