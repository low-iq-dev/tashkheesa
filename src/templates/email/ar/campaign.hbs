<!-- قالب البريد الإلكتروني للحملة -->
<h2 style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:#0B6B5F;">
  {{campaignName}}
</h2>

<div style="margin:0 0 24px 0;font-size:15px;line-height:1.8;color:#4A4640;">
  {{{content}}}
</div>

{{#if unsubscribeUrl}}
<div style="margin:32px 0 0 0;padding-top:16px;border-top:1px solid #E3DED2;">
  <p style="margin:0;font-size:12px;color:#9A9287;line-height:1.6;">
    أنت تتلقى هذا البريد لأن لديك حساب في تشخيصة.
    <a href="{{unsubscribeUrl}}" style="color:#7A736A;text-decoration:underline;">إلغاء الاشتراك من الرسائل التسويقية</a>
  </p>
</div>
{{/if}}
