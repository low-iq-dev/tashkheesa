<!-- Payment Claim Rejected (manual payment path, migration 117) -->
<h2 style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:#0B6B5F;">
  We could not match your transfer
</h2>
<p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4A4640;">
  Hi {{patientName}},
</p>
<p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4A4640;">
  We checked our account for the transfer you told us about, and we could not match it to your case. Your case is saved and still awaiting payment — nothing has been charged or lost on our side.
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:24px 0;background-color:#fff8f0;border-radius:8px;border:1px solid #f0d2b0;">
  <tr>
    <td style="padding:20px 24px;">
      {{#if transferReference}}
      <p style="margin:0 0 12px 0;font-size:14px;color:#4A4640;">Reference you sent: {{transferReference}}</p>
      {{/if}}
      <p style="margin:0 0 8px 0;font-size:13px;font-weight:600;color:#7a4a1a;text-transform:uppercase;letter-spacing:0.5px;">Reason</p>
      <p style="margin:0;font-size:15px;line-height:1.6;color:#4A4640;">{{rejectionReason}}</p>
      {{#if caseReference}}
      <p style="margin:12px 0 0 0;font-size:13px;color:#7A736A;">Case: {{caseReference}}</p>
      {{/if}}
    </td>
  </tr>
</table>
<p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4A4640;">
  Please check the amount and the transfer reference, then send them again from your payment page. If you think this is a mistake, reply to this email and we will look again.
</p>
{{#if caseUrl}}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto;">
  <tr>
    <td align="center" style="background-color:#0B6B5F;border-radius:8px;">
      <a href="{{caseUrl}}" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;">Open your payment page</a>
    </td>
  </tr>
</table>
{{/if}}
