<!-- Draft resume — 1 hour idle (patient recovery, Part A). Fixed copy, no AI. -->
<h2 style="margin:0 0 16px 0;font-size:22px;font-weight:600;color:#0B6B5F;">
  Your case is saved
</h2>

<p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4A4640;">
  Hi {{patientName}},
</p>

<p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4A4640;">
  You started a case with Tashkheesa and everything you entered is saved. Finishing it takes about two minutes, and the link below opens it exactly where you left off.
</p>

{{#if caseReference}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:24px 0;background-color:#F4F1E9;border-radius:8px;border:1px solid #E3DED2;">
  <tr>
    <td style="padding:16px 24px;">
      <p style="margin:0 0 4px 0;font-size:12px;font-weight:600;color:#0B6B5F;text-transform:uppercase;letter-spacing:0.5px;">Reference</p>
      <p style="margin:0;font-size:15px;font-weight:600;color:#2E2B26;">{{caseReference}}</p>
    </td>
  </tr>
</table>
{{/if}}

{{#if resumeUrl}}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 24px auto;">
  <tr>
    <td align="center" style="background-color:#0B6B5F;border-radius:8px;">
      <a href="{{resumeUrl}}" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;">
        Finish my case
      </a>
    </td>
  </tr>
</table>
{{/if}}

<p style="margin:24px 0 0 0;font-size:13px;color:#7A736A;line-height:1.5;">
  The link works for 72 hours and only opens your case after you sign in. If you need help with the upload or with choosing a service, just reply to this email.<br>
  — The Tashkheesa team
</p>
