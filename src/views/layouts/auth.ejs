<%
  const baseTitle = (typeof title !== 'undefined' && title) ? String(title) : 'Tashkheesa';
  const pageTitle = baseTitle.includes('Tashkheesa') ? baseTitle : `${baseTitle} – Tashkheesa`;
  const pageLang = (typeof lang !== 'undefined' && lang)
    ? lang
    : ((typeof locals !== 'undefined' && locals && locals.lang)
        ? locals.lang
        : ((typeof locals !== 'undefined' && locals && locals.user && locals.user.lang)
            ? locals.user.lang
            : 'en'));
  const pageDir = (String(pageLang).toLowerCase() === 'ar') ? 'rtl' : 'ltr';
  const renderNav = (typeof showNav === 'undefined') ? false : Boolean(showNav);
%>
<!DOCTYPE html>
<html lang="<%= pageLang %>" dir="<%= pageDir %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="/css/portal-variables.css" />
  <link rel="stylesheet" href="/css/portal-components.css" />
  <link rel="stylesheet" href="/css/portal-global.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Arabic:wght@400;600;700&display=swap" rel="stylesheet" />
  <%# The Lucide icon font used to be pulled from unpkg here. Our own CSP
      (style-src 'self' 'unsafe-inline' ucarecdn fonts.googleapis) never
      allowed it, so the browser refused the stylesheet on EVERY page load
      and logged a violation every time. It has therefore never rendered a
      single icon in production — every icon you see is an inline SVG or the
      .portal-icon-fallback text, which is why nothing looked broken.

      Removed rather than added to the CSP: the fallback path is the only
      path that has ever run, so widening a medical site's style-src to a
      third-party CDN would buy a cosmetic change in exchange for a real
      supply-chain surface. If the icon font is ever genuinely wanted,
      self-host it under /fonts and the CSP needs no change at all.

      The html.lucide-ready probe that sat below is gone with it — it
      existed only to detect a font that can no longer arrive. The
      html.lucide-ready CSS rules are left in place, inert, so a future
      self-hosted font needs one line here and nothing else. %>
  <% var _nonce = (typeof locals !== 'undefined' && locals && (locals.cspNonce || locals.csp_nonce || locals.nonce)) ? String(locals.cspNonce || locals.csp_nonce || locals.nonce) : ''; %>
  <link rel="icon" href="/favicon.ico" />
</head>
<body class="layout layout-auth">

<% if (renderNav) { %>
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-brand">
      <img
        src="/assets/brand/tashkheesa-logo-white-horizontal.png"
        alt="Tashkheesa"
        class="brand-logo-img"
      />
    </a>
  </div>
</header>
<% } %>

<main id="main-content" class="app-shell">
