<%
  // Theme 7b Phase 2 — patient refund request form.
  // Part C1 (2026-09-13): says what can be refunded, and why, before it asks
  // for anything. It used to show a bare amount, send an ineligible patient
  // back to the case page with no word of why, and ask for an "Instapay
  // handle or IBAN" in free text.
  //
  // Locals from src/routes/patient.js GET/POST /portal/patient/orders/:id/request-refund:
  //   user, lang, isAr, order
  //   eligibility     — verdict from services/refund_eligibility.isEligibleForRefund
  //   summary         — services/refund_summary.describeRefund(): { kind, canRequest,
  //                     paidEgp, alreadyRefundedEgp, remainingEgp, amountEgp, text:{en,ar} }
  //                     (null only if it could not be built)
  //   requestedAmount — what is still refundable, EGP
  //   instapayDefault — users.phone, prefilled into the InstaPay number
  //   formError       — reason_required | reason_too_long | instapay_required |
  //                     instapay_invalid | duplicate | ineligible | amount_unavailable
  //   formValues      — { reason, instapay_handle } re-rendered on a validation failure

  const __isAr = !!isAr;
  const __lang = __isAr ? 'ar' : 'en';
  const __order = (typeof order === 'object' && order) ? order : {};
  const __values = (typeof formValues === 'object' && formValues) ? formValues : {};
  const __error = String(formError || '').trim();
  const __summary = (typeof summary === 'object' && summary) ? summary : null;
  const __elig = (typeof eligibility === 'object' && eligibility) ? eligibility : null;
  const __kind = __summary ? __summary.kind : ((__elig && __elig.eligible) ? 'review' : 'nothing');
  const __canRequest = __summary ? !!__summary.canRequest : !!(__elig && __elig.eligible);
  const __eligText = __summary
    ? __summary.text[__lang]
    : tt('refund.summary_unavailable',
         'We could not work out the refundable amount just now. You can still send the request; our team confirms the amount.',
         'تعذّر حساب المبلغ القابل للاسترداد الآن. يمكنك إرسال الطلب، وسيؤكد فريقنا المبلغ.');
  const __remaining = __summary ? __summary.remainingEgp : (typeof requestedAmount === 'number' ? requestedAmount : 0);

  const caseRef = __order.reference_id || __order.reference_code
    || (__order.id ? 'TSH-' + String(__order.id).substring(0, 12).toUpperCase() : '');
  // Western digits in both languages: this is the number the patient checks
  // against their InstaPay app.
  const fmtMoney = function (n) {
    const v = Number(n);
    if (!Number.isFinite(v)) return '';
    const s = v.toLocaleString('en-US', { maximumFractionDigits: 2 });
    return __isAr ? s + ' جنيه' : 'EGP ' + s;
  };
  const __instapayValue = (__values.instapay_handle != null && String(__values.instapay_handle) !== '')
    ? String(__values.instapay_handle)
    : ((typeof instapayDefault === 'string') ? instapayDefault : '');
  const __nonce = (typeof cspNonce !== 'undefined' && cspNonce) ? cspNonce : '';
%>
<%- include('partials/patient/head', {
  title: tt('refund.form_title', 'Request a refund', 'طلب استرداد المبلغ'),
  active: 'cases',
  variant: 'dark',
  trustDensity: 'medium',
  bodyClass: 'p-page-refund-request',
  user: user,
  lang: lang,
  cspNonce: __nonce
}) %>

<nav class="p-crumbs" aria-label="<%= tt('Breadcrumb', 'Breadcrumb', 'مسار التنقل') %>">
  <a href="/dashboard" style="color:var(--muted);text-decoration:none;"><%= tt('Home', 'Home', 'الرئيسية') %></a>
  <%- include('partials/patient/icon', { name: 'chevR', size: 10, className: 'chev' }) %>
  <a href="/portal/patient/orders/<%= __order.id %>" style="color:var(--muted);text-decoration:none;">
    <%= tt('Case', 'Case', 'الحالة') %>
    <% if (caseRef) { %><bdi dir="ltr" style="font-family:var(--font-mono);font-size:11px;margin-inline-start:4px;"><%= caseRef %></bdi><% } %>
  </a>
  <%- include('partials/patient/icon', { name: 'chevR', size: 10, className: 'chev' }) %>
  <span style="color:var(--ink-2);">
    <%= tt('refund.cta_button', 'Request refund', 'اطلب استرداد المبلغ') %>
  </span>
</nav>

<style>
  .p-refund { max-width: 680px; margin: 0 auto; padding: 24px 16px 32px; }
  .p-refund__head { margin-block-end: 20px; }
  .p-refund__head h1 { margin: 0 0 6px; font-size: 26px; font-weight: 700; color: var(--ink); }
  .p-refund__head p { margin: 0; font-size: 14px; color: var(--ink-2); line-height: 1.55; }
  .p-refund__alert { margin: 0 0 18px; padding: 12px 14px; border-radius: 8px; background: #fff5f5; border: 1px solid #feb2b2; color: #742a2a; font-size: 14px; line-height: 1.5; }
  .p-refund__h { margin: 0 0 12px; font-size: 15px; font-weight: 600; color: var(--ink); }
  .p-refund__dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0 0 14px; font-size: 14px; line-height: 1.5; }
  .p-refund__dl dt { color: var(--muted); }
  .p-refund__dl dd { margin: 0; color: var(--ink); }
  .p-refund__dl .is-strong { font-weight: 700; }
  .p-refund__elig { margin: 0; padding: 12px 14px; border-radius: 10px; background: var(--primary-light); color: var(--ink); font-size: 14px; line-height: 1.6; }
  .p-refund__elig--nothing, .p-refund__elig--surcharge_only { background: var(--surface-sunk); }
  .p-refund__policy { margin: 18px 0; font-size: 13.5px; color: var(--ink-2); line-height: 1.6; }
  .p-refund__policy ul { margin: 0 0 4px; padding-inline-start: 20px; }
  .p-refund__policy li { margin-block-end: 4px; }
  .p-refund__policy a { display: inline-flex; align-items: center; min-height: 44px; color: var(--primary-dark); font-weight: 600; }
  .p-refund__count { font-variant-numeric: tabular-nums; }
  .p-refund__fields { padding: 18px; }
  .p-refund__fields .p-field + .p-field { margin-block-start: 18px; }
  .p-refund__submitbar { position: sticky; bottom: 0; z-index: 5; display: flex; flex-wrap: wrap; gap: 10px; align-items: center;
    margin-block-start: 12px; padding: 12px 0 calc(12px + env(safe-area-inset-bottom, 0px)); background: var(--bg); border-block-start: 1px solid var(--rule); }
  .p-refund__submitbar .p-btn { min-height: 44px; }
  .p-refund__submitbar .p-btn--primary[disabled] { opacity: .55; cursor: not-allowed; }
  .p-refund__why { flex: 1 1 100%; margin: 0; font-size: 13px; color: var(--muted); }
  @media (max-width: 767px) {
    /* patient-portal-v2.css sets .p-main { overflow-x: hidden } on phones, which
       makes .p-main the scroll container, so a sticky bar sticks to a box that
       never scrolls. clip still clips sideways without creating one. */
    body.p-page-refund-request .p-main { overflow-x: clip; }
    .p-refund { padding-block-end: 8px; }
    .p-refund__head h1 { font-size: 22px; }
    .p-refund__dl { grid-template-columns: 1fr; gap: 0; }
    .p-refund__dl dd { margin-block-end: 8px; }
    /* Above the patient bottom tab bar (partials/patient/mobile-tabbar). */
    .p-refund__submitbar { bottom: var(--p-tabbar-height, 0px); padding-block-end: 12px; }
    .p-refund__submitbar .p-btn--primary { flex: 1 1 100%; justify-content: center; }
  }
</style>

<div class="p-refund">

  <header class="p-refund__head">
    <h1><%= tt('refund.form_title', 'Request a refund', 'طلب استرداد المبلغ') %></h1>
    <p><%= tt('refund.form_subtitle_v2', 'See what can be refunded, then tell us why and where to send it.', 'اعرف المبلغ الذي يمكن ردّه، ثم اكتب السبب ورقم إنستاباي.') %></p>
  </header>

  <% if (__error) { %>
    <div role="alert" class="p-refund__alert">
      <% if (__error === 'reason_required') { %>
        <%= tt('refund.error.reason_required', 'Please tell us why you need a refund.', 'قول لنا السبب من فضلك.') %>
      <% } else if (__error === 'reason_too_long') { %>
        <%= tt('refund.error.reason_too_long', 'Please keep the reason to 500 characters.', 'اكتب السبب في حدود 500 حرف من فضلك.') %>
      <% } else if (__error === 'instapay_required') { %>
        <%= tt('refund.error.instapay_number_required', 'Please enter the mobile number your InstaPay account uses.', 'اكتب رقم الموبايل المسجّل على حساب إنستاباي من فضلك.') %>
      <% } else if (__error === 'instapay_invalid') { %>
        <%= tt('refund.error.instapay_invalid', 'That InstaPay number does not look right. Use the international format, for example +201012345678.', 'رقم إنستاباي غير صحيح. اكتبه بالصيغة الدولية، مثلًا ‎+201012345678.') %>
      <% } else if (__error === 'duplicate') { %>
        <%= tt('refund.error.duplicate', 'A refund request is already pending on this case.', 'في طلب استرداد قيد المراجعة على الحالة دي.') %>
      <% } else if (__error === 'ineligible') { %>
        <%= tt('refund.error.ineligible', 'This case is not eligible for a refund request.', 'الحالة دي مش مؤهلة لاسترداد المبلغ.') %>
      <% } else { %>
        <%= tt('Something went wrong. Please try again.', 'Something went wrong. Please try again.', 'حصل خطأ. حاول تاني من فضلك.') %>
      <% } %>
    </div>
  <% } %>

  <%# The form wraps the whole page so the sticky submit bar is on screen from the first scroll position. %>
  <form method="post"
        action="/portal/patient/orders/<%= __order.id %>/request-refund"
        novalidate>
    <%- (typeof csrfField === 'function') ? csrfField() : '' %>

  <section class="p-card" aria-labelledby="refund-facts-h" data-refund-summary>
    <div class="p-card__body" style="padding:16px 18px;">
      <h2 id="refund-facts-h" class="p-refund__h"><%= tt('refund.facts_title', 'What you paid and what can come back', 'ما دفعته وما يمكن ردّه') %></h2>
      <dl class="p-refund__dl">
        <dt><%= tt('refund.case_label', 'Case', 'الحالة') %></dt>
        <dd><bdi dir="ltr" style="font-family:var(--font-mono);font-size:13px;"><%= caseRef %></bdi></dd>
        <% if (__summary && __summary.paidEgp > 0) { %>
          <dt><%= tt('refund.paid_label', 'You paid', 'المبلغ المدفوع') %></dt>
          <dd><bdi data-money><%= fmtMoney(__summary.paidEgp) %></bdi></dd>
        <% } %>
        <% if (__summary && __summary.alreadyRefundedEgp > 0) { %>
          <dt><%= tt('refund.already_label', 'Already refunded', 'تم ردّه بالفعل') %></dt>
          <dd><bdi data-money><%= fmtMoney(__summary.alreadyRefundedEgp) %></bdi></dd>
        <% } %>
        <dt><%= tt('refund.can_refund_label', 'Can be requested now', 'يمكن طلبه الآن') %></dt>
        <dd class="is-strong">
          <% if (__canRequest && __remaining > 0) { %><bdi data-money><%= fmtMoney(__remaining) %></bdi><% } else { %><%= tt('refund.nothing_label', 'Nothing', 'لا شيء') %><% } %>
        </dd>
      </dl>
      <p id="refund-eligibility" class="p-refund__elig p-refund__elig--<%= __kind %>" data-refund-eligibility data-kind="<%= __kind %>"><%= __eligText %></p>
    </div>
  </section>

  <section class="p-refund__policy" aria-labelledby="refund-policy-h">
    <h2 id="refund-policy-h" class="p-refund__h"><%= tt('refund.policy_title', 'How refunds work', 'كيف يتم الاسترداد') %></h2>
    <ul data-refund-policy-summary>
      <li><%= tt('refund.policy_line_paid', 'We send refunds by InstaPay only, to the number below. We review your request within 1 business day, and approved refunds arrive in 3-5 business days.', 'نرسل المبالغ عبر إنستاباي فقط، إلى الرقم المكتوب بالأسفل. نراجع طلبك خلال يوم عمل واحد، ويصل المبلغ المعتمد خلال 3 إلى 5 أيام عمل.') %></li>
      <li><%= tt('refund.policy_line_rules', 'Full refund before a consultant accepts your case. After that, a missed deadline refunds the urgency surcharge — Standard has none.', 'استرداد كامل قبل أن يقبل استشاري حالتك. بعد ذلك، يُرَدّ رسم الاستعجال إذا فات موعد التسليم — والخدمة القياسية بلا رسوم استعجال.') %></li>
      <li><%= tt('refund.policy_line_rest', 'If part of your payment was already refunded, you can ask for the rest.', 'إذا رُدّ جزء مما دفعته، يمكنك طلب المتبقي.') %></li>
    </ul>
    <a href="<%= locals.publicLinkPrefix || '' %>/refund-policy"><%= tt('refund.policy_link', 'Read the full refund policy', 'اقرأ سياسة الاسترداد كاملة') %></a>
  </section>

    <% if (__canRequest) { %>
    <div class="p-card">
      <div class="p-refund__fields">
        <div class="p-field">
          <label class="p-field__label" for="refund_reason">
            <%= tt('refund.reason_label', 'Why do you need a refund?', 'ليه محتاج استرداد المبلغ؟') %>
            <span style="color:var(--danger);" aria-hidden="true">*</span>
          </label>
          <textarea id="refund_reason" name="reason" rows="5" required
                    minlength="3" maxlength="500"
                    class="p-field__textarea"
                    aria-describedby="refund_reason_hint"
                    placeholder="<%= tt('refund.reason_placeholder', 'A short explanation helps us review faster.', 'شرح بسيط هيساعدنا نراجع أسرع.') %>"><%= __values.reason || '' %></textarea>
          <div class="p-field__hint" id="refund_reason_hint">
            <%= tt('refund.reason_hint_500', 'Up to 500 characters.', 'حد أقصى 500 حرف.') %>
            <span class="p-refund__count" data-refund-count aria-live="polite"></span>
          </div>
        </div>

        <div class="p-field">
          <label class="p-field__label" for="refund_instapay">
            <%= tt('refund.instapay_number_label', 'InstaPay mobile number', 'رقم موبايل إنستاباي') %>
            <span style="color:var(--danger);" aria-hidden="true">*</span>
          </label>
          <input id="refund_instapay" name="instapay_handle" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" required
                 minlength="3" maxlength="100"
                 class="p-field__input"
                 aria-describedby="refund_instapay_hint"
                 value="<%= __instapayValue %>"
                 placeholder="+201012345678" />
          <div class="p-field__hint" id="refund_instapay_hint">
            <%= tt('refund.instapay_number_hint', 'We send your refund to this number by InstaPay — please check it. International format, e.g. +201012345678.', 'نرسل المبلغ إلى هذا الرقم عبر إنستاباي — راجعه من فضلك. بالصيغة الدولية، مثلًا ‎+201012345678.') %>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <div class="p-refund__submitbar" data-refund-submitbar>
      <button class="p-btn p-btn--primary p-btn--lg" type="submit" data-refund-submit
              <% if (!__canRequest) { %>disabled aria-describedby="refund-eligibility"<% } %>>
        <%= tt('refund.submit_button', 'Submit refund request', 'إرسال طلب الاسترداد') %>
      </button>
      <a class="p-btn p-btn--ghost" href="/portal/patient/orders/<%= __order.id %>">
        <%= tt('refund.cancel_link', 'Back to case', 'الرجوع للحالة') %>
      </a>
      <% if (!__canRequest) { %>
        <p class="p-refund__why"><%= tt('refund.nothing_to_request', 'There is nothing to request on this case — the reason is above.', 'لا يوجد ما يمكن طلبه على هذه الحالة — السبب موضّح بالأعلى.') %></p>
      <% } %>
    </div>
  </form>

</div>

<script<%- __nonce ? ' nonce="' + __nonce + '"' : '' %>>
(function () {
  var ta = document.getElementById('refund_reason');
  var out = document.querySelector('[data-refund-count]');
  if (!ta || !out) return;
  function update() { out.textContent = '(' + ta.value.length + ' / 500)'; }
  ta.addEventListener('input', update);
  update();
})();
</script>

<%- include('partials/patient/foot', { active: 'cases', isAr: __isAr, cspNonce: __nonce }) %>
