            nothing ever hid either one. The primary SVG's wordmark is #1e3a8a
            navy, drawn for LIGHT backgrounds, so the top copy all but vanished
            against the footer while the white copy sat correctly beneath it —
            a doubled, half-invisible logo site-wide. .site-footer is
            unconditionally dark (--footer-bg, white text), so there is no
            light-footer case to switch for: render the white mark only. %>
        <img src="/assets/brand/tashkheesa-logo-white.svg" class="footer-logo" alt="Tashkheesa" style="max-height:36px;width:auto;" />
        <p class="muted"><%= __footerIsAr ? 'آراء طبية ثانية من استشاريين متخصصين، مقدمة بوضوح.' : 'Specialist medical second opinions, delivered clearly.' %></p>
      </div>
      <div class="footer-columns">
        <div class="footer-col">
          <h4 class="footer-col-title"><%= __footerIsAr ? 'الخدمات' : 'Services' %></h4>
          <a href="/services"><%= __footerIsAr ? 'الخدمات والأسعار' : 'Services & Pricing' %></a>
          <a href="/specialties"><%= __footerIsAr ? 'التخصصات' : 'Specialties' %></a>
          <a href="/about"><%= __footerIsAr ? 'من نحن' : 'About Us' %></a>
          <a href="/faq"><%= __footerIsAr ? 'الأسئلة الشائعة' : 'FAQ' %></a>
          <a href="/blog"><%= __footerIsAr ? 'المدونة' : 'Blog' %></a>
          <a href="/contact"><%= __footerIsAr ? 'اتصل بنا' : 'Contact Us' %></a>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title"><%= __footerIsAr ? 'السياسات' : 'Legal' %></h4>
          <a href="/privacy"><%= __footerIsAr ? 'سياسة الخصوصية' : 'Privacy Policy' %></a>
          <a href="/terms"><%= __footerIsAr ? 'شروط الخدمة' : 'Terms of Service' %></a>
          <a href="/refund-policy"><%= __footerIsAr ? 'الاسترداد والإلغاء' : 'Refund & Cancellation' %></a>
          <a href="/delivery-policy"><%= __footerIsAr ? 'سياسة التسليم' : 'Delivery Policy' %></a>
        </div>
        <div class="footer-col">
          <%# /apply is a complete, live, public doctor-application page that had
              no inbound link anywhere in the product — it appeared only in
              sitemap.xml, so the sole way a specialist could reach it was via a
              search engine that had already crawled the sitemap. /doctor/signup
              is likewise only linked from doctor_login_v2.ejs, which you must
              already be at the doctor login to see. Both now have a permanent
              home in the global footer. %>
          <h4 class="footer-col-title"><%= __footerIsAr ? 'للأطباء' : 'For Doctors' %></h4>
          <a href="/apply"><%= __footerIsAr ? 'قدِّم كاستشاري' : 'Apply as a Specialist' %></a>
          <a href="/doctor/signup"><%= __footerIsAr ? 'تسجيل الأطباء' : 'Doctor Sign-up' %></a>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title"><%= __footerIsAr ? 'تواصل معنا' : 'Contact' %></h4>
          <a href="mailto:info@tashkheesa.com" style="color:inherit;">info@tashkheesa.com</a>
          <a href="https://wa.me/201102009886" style="color:inherit;" dir="ltr">+20 110 200 9886</a>
          <p><%= __footerIsAr ? 'القاهرة، مصر' : 'Cairo, Egypt' %></p>
        </div>
      </div>
    </div>
  </footer>
<% } %>

<% if (usePortalFrame) { %>
  <script src="/vendor/lucide.min.js" defer></script>
  <script<% if (cspNonce) { %> nonce="<%= cspNonce %>"<% } %>>
    (function () {
      var attempts = 0;
      var done = false;

      function markReady() {
        document.documentElement.classList.add('lucide-ready');
        document.documentElement.classList.remove('lucide-fallback');
      }

      function markFallback() {
        document.documentElement.classList.add('lucide-fallback');
        document.documentElement.classList.remove('lucide-ready');
      }

      function initLucide() {
        if (done || attempts >= 2) return;
        attempts += 1;

        try {
          document.documentElement.classList.remove('lucide-ready');
          document.documentElement.classList.remove('lucide-fallback');

          if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
            if (document.querySelector('svg.lucide')) {
              done = true;
              markReady();
              return;
            }
          }
        } catch (e) {}

        if (attempts >= 2) {
          done = true;
          markFallback();
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLucide, { once: true });
      } else {
        initLucide();
      }

      // Safety retry for defer/load-order edge cases.
      setTimeout(initLucide, 0);
    })();
  </script>
<% } %>

<script<% if (cspNonce) { %> nonce="<%= cspNonce %>"<% } %>>
  (function () {
    /* ── Sidebar drawer (phones) ──
       2026-09-13 (mobile A1). Open and close keep the sidebar and the overlay in
       step (the overlay used to be left behind when the drawer was toggled
       shut). On the doctor portal the drawer also behaves like a dialog: the
       page behind it stops scrolling, Escape closes it, focus moves into it and
       comes back to the button that opened it, and aria-expanded tells a screen
       reader which state it is in. Those extras are doctor-only on purpose —
       the admin frames are outside this change. */
    var drawerReturnFocus = null;
    function isDoctorPortal() { return document.body.classList.contains('doctor-theme'); }
    function setDrawer(open) {
      var sidebar = document.querySelector('.portal-sidebar');
      var overlay = document.querySelector('.portal-sidebar-overlay');
      if (!sidebar) return;
      sidebar.classList.toggle('open', open);
      if (overlay) overlay.classList.toggle('active', open);
      if (!isDoctorPortal()) return;
      document.documentElement.classList.toggle('portal-drawer-open', open);
      document.querySelectorAll('[data-action="toggle-sidebar"]').forEach(function (b) {
        b.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      if (open) {
        drawerReturnFocus = document.activeElement;
        var first = sidebar.querySelector('a[href], button:not([disabled])');
        if (first) { try { first.focus({ preventScroll: true }); } catch (_) { first.focus(); } }
      } else if (drawerReturnFocus && typeof drawerReturnFocus.focus === 'function') {
        try { drawerReturnFocus.focus({ preventScroll: true }); } catch (_) { drawerReturnFocus.focus(); }
        drawerReturnFocus = null;
      }
    }
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape' || !isDoctorPortal()) return;
      if (document.querySelector('.portal-sidebar.open')) setDrawer(false);
    });
    if (window.matchMedia) {
      var desktopMq = window.matchMedia('(min-width: 769px)');
      var onDesktop = function (mq) { if (mq.matches && isDoctorPortal()) setDrawer(false); };
      if (desktopMq.addEventListener) desktopMq.addEventListener('change', onDesktop);
      else if (desktopMq.addListener) desktopMq.addListener(onDesktop);
    }

    /* ── Portal-wide event delegation for data-action buttons ── */
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-action]');
      if (!btn) return;
      var action = btn.getAttribute('data-action');
      var sidebar = document.querySelector('.portal-sidebar');
      var overlay = document.querySelector('.portal-sidebar-overlay');

      if (action === 'toggle-sidebar') {
        setDrawer(!(sidebar && sidebar.classList.contains('open')));
      } else if (action === 'close-sidebar') {
        setDrawer(false);
      } else if (action === 'start-tour') {
        if (typeof startPortalTour === 'function') startPortalTour();
      } else if (action === 'dismiss-banner') {
        var targetId = btn.getAttribute('data-dismiss-target');
        if (targetId) { var el = document.getElementById(targetId); if (el) el.style.display = 'none'; }
      } else if (action === 'print-page') {
        window.print();
      } else if (action === 'reload-page') {
        window.location.reload();
      } else if (action === 'navigate') {
        var href = btn.getAttribute('data-href');
        if (href) window.location.href = href;
      } else if (action === 'select-text') {
        if (btn.select) btn.select();
      } else if (action === 'show-fallback') {
        var tid = btn.getAttribute('data-target');
        if (tid) { var el = document.getElementById(tid); if (el) el.style.display = 'block'; }
      } else if (action === 'toggle-stack') {
        var tid2 = btn.getAttribute('data-target');
        if (tid2) { var el2 = document.getElementById(tid2); if (el2) el2.style.display = el2.style.display === 'block' ? 'none' : 'block'; }
      } else if (action === 'set-sla') {
        var target = btn.getAttribute('data-target');
        var val = btn.getAttribute('data-value');
        if (target && val) { var el3 = document.getElementById(target); if (el3) el3.value = val; }
      }
    });

    /* ── data-confirm on form submit buttons ── */
    document.addEventListener('submit', function (e) {
      var confirmBtn = e.target.querySelector('[data-confirm]');
      if (!confirmBtn) {
        var submitter = e.submitter;
        if (submitter && submitter.hasAttribute('data-confirm')) confirmBtn = submitter;
      }
      if (confirmBtn) {
        var msg = confirmBtn.getAttribute('data-confirm');
        if (msg && !window.confirm(msg)) {
          e.preventDefault();
        }
      }
    });

    /* ── data-action="select-text" on focus for inputs ── */
    document.addEventListener('focus', function (e) {
      if (e.target && e.target.hasAttribute && e.target.hasAttribute('data-action') && e.target.getAttribute('data-action') === 'select-text') {
        e.target.select();
      }
    }, true);

    /* ── data-action="auto-submit" on change for selects ── */
    document.addEventListener('change', function (e) {
      if (e.target && e.target.hasAttribute && e.target.hasAttribute('data-action') && e.target.getAttribute('data-action') === 'auto-submit') {
        var form = e.target.closest('form');
        if (form) form.submit();
      }
    });
  })();
</script>

<script<% if (cspNonce) { %> nonce="<%= cspNonce %>"<% } %>>
  (function () {
    /* ── Scroll-reveal animations ── */
    var els = document.querySelectorAll(
      '.scroll-reveal, .scroll-reveal-left, .scroll-reveal-right, .scroll-reveal-scale'
    );
    if (!els.length) return;

    if (!('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    els.forEach(function (el) { observer.observe(el); });
  })();
</script>

</body>
</html>
