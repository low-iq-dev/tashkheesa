  //
  // Every option used to render its ENGLISH name regardless of language, so the
  // Arabic registration form showed "Egypt" rather than "مصر" on an otherwise
  // fully Arabic page — and "Cote d'Ivoire" and "Sao Tome and Principe" were
  // missing their diacritics on the English side too.
  //
  // The Arabic names were GENERATED from ICU (Intl.DisplayNames with the 'ar'
  // locale) rather than typed by hand, then committed as static data. Generated
  // because 198 hand-typed country names is 198 chances to misspell one;
  // committed rather than computed per request because a server whose Node
  // ships small-icu would silently fall back to the two-letter code, and a
  // country list that degrades to "EG" is worse than one that cannot change.
  //
  // Sorted at render time by the name actually being displayed, so the Arabic
  // list is in Arabic alphabetical order rather than English order with Arabic
  // labels — using localeCompare, which knows that ال is not a sort prefix.
  var _cc = (typeof _selectedCountry !== 'undefined') ? _selectedCountry : '';
  var _ar = (typeof _isAr !== 'undefined' && _isAr);
  function _sel(v) { return _cc === v ? 'selected' : ''; }
  function _label(row) { return _ar ? row[2] : row[1]; }

