<%
  // Country list, both languages — <option>s for a country <select>.
  //
  // 26 Oct 2026 — the data lives in src/lib/countries.js (app.locals.COUNTRIES),
  // the same table the phone normaliser reads, so the dial code a patient picks
  // here is always one the server can interpret. The English and Arabic names
  // are the ones this partial used to carry inline (Arabic generated from ICU
  // with Intl.DisplayNames('ar'), then committed — 198 hand-typed names is 198
  // chances to misspell one, and a server on small-icu would degrade to "EG").
  //
  // Sorted at render time by the name actually displayed, so the Arabic list is
  // in Arabic alphabetical order — localeCompare knows ال is not a sort prefix.
  //
  // Locals:
  //   _selectedCountry  ISO code to pre-select
  //   _isAr             Arabic labels
  //   _withDial         the signup form: each option carries data-dial (its
  //                     dialling code) and data-ph (a local-format phone
  //                     placeholder), and the label shows the code.
  //
  // AUDIT-SIGNUP-DEAD-END-2026-09-29 rendered only the nine markets POST
  // /register then accepted. Since 26 Oct /register accepts every country on
  // this list, so the signup form offers them all.
  var _cc = (typeof _selectedCountry !== 'undefined' && _selectedCountry) ? String(_selectedCountry).toUpperCase() : '';
  var _ar = (typeof _isAr !== 'undefined' && _isAr);
  var _dial = (typeof _withDial !== 'undefined' && _withDial) || (typeof _onlyLiveMarkets !== 'undefined' && _onlyLiveMarkets);
  // Fallback for a render without app.locals (unit renders): the nine markets.
  var _rows = (typeof COUNTRIES !== 'undefined' && COUNTRIES && COUNTRIES.length) ? COUNTRIES : [
    { iso: 'EG', en: 'Egypt', ar: 'مصر', dial: '+20', ex: '01X XXXX XXXX' },
    { iso: 'SA', en: 'Saudi Arabia', ar: 'المملكة العربية السعودية', dial: '+966', ex: '05X XXX XXXX' },
    { iso: 'AE', en: 'United Arab Emirates', ar: 'الإمارات العربية المتحدة', dial: '+971', ex: '05X XXX XXXX' },
    { iso: 'KW', en: 'Kuwait', ar: 'الكويت', dial: '+965', ex: 'XXXX XXXX' },
    { iso: 'BH', en: 'Bahrain', ar: 'البحرين', dial: '+973', ex: 'XXXX XXXX' },
    { iso: 'QA', en: 'Qatar', ar: 'قطر', dial: '+974', ex: 'XXXX XXXX' },
    { iso: 'OM', en: 'Oman', ar: 'عُمان', dial: '+968', ex: '9XXX XXXX' },
    { iso: 'GB', en: 'United Kingdom', ar: 'المملكة المتحدة', dial: '+44', ex: '07XXX XXXXXX' },
    { iso: 'US', en: 'United States', ar: 'الولايات المتحدة', dial: '+1', ex: '(XXX) XXX-XXXX' }
  ];
  var _popularIsos = (typeof POPULAR_COUNTRIES !== 'undefined' && POPULAR_COUNTRIES) ? POPULAR_COUNTRIES : ['EG', 'SA', 'AE', 'KW', 'BH', 'QA', 'OM', 'GB', 'US'];
  var _byIso = {};
  _rows.forEach(function (r) { _byIso[r.iso] = r; });
  var _popular = _popularIsos.map(function (i) { return _byIso[i]; }).filter(Boolean);
  function _label(r) {
    var n = _ar ? (r.ar || r.en) : r.en;
    if (!_ar && r.iso === 'AE') n = 'UAE';
    return _dial ? n + ' (' + r.dial + ')' : n;
  }
  var _collator = new Intl.Collator(_ar ? 'ar' : 'en', { sensitivity: 'base' });
  var _allSorted = _rows.slice().sort(function (a, b) {
    return _collator.compare(_ar ? (a.ar || a.en) : a.en, _ar ? (b.ar || b.en) : b.en);
  });
  // The selected country is marked once — in Popular when it is there.
  var _selDone = false;
  function _sel(r) {
    if (_selDone || r.iso !== _cc) return '';
    _selDone = true;
    return 'selected';
  }
%>
<option value="" <%= !_cc ? 'selected' : '' %>><%= _ar ? 'اختر الدولة' : 'Select country' %></option>
<optgroup label="<%= _ar ? 'الأكثر شيوعاً' : 'Popular' %>">
<% _popular.forEach(function (r) { %>  <option value="<%= r.iso %>"<% if (_dial) { %> data-dial="<%= r.dial %>" data-ph="<%= r.ex || '' %>"<% } %> <%= _sel(r) %>><%= _label(r) %></option>
<% }); %></optgroup>
<optgroup label="<%= _ar ? 'كل الدول' : 'All countries' %>">
<% _allSorted.forEach(function (r) { %>  <option value="<%= r.iso %>"<% if (_dial) { %> data-dial="<%= r.dial %>" data-ph="<%= r.ex || '' %>"<% } %> <%= _sel(r) %>><%= _label(r) %></option>
<% }); %></optgroup>
