<%
  /* Turnaround-tier reconfirmation nudge (2026-08-24).

     Migration 089 opened Standard, VIP and Urgent to every assignable doctor.
     25 of 31 had been sitting at Standard alone — not a decision, an untouched
     default: the tier checkboxes appeared once on the signup form with Standard
     pre-ticked, and the portal offered no way to change them afterwards.

     Opening them silently would be worse than the problem it solves, so this
     runs until the doctor gives an affirmative answer. Saving on the services
     page stamps users.sla_tiers_confirmed_at and this stops — whether they keep
     all three or drop back to Standard. The confirmation is the point.

     Shown by partials/doctor/topbar.ejs; the flag is computed once per request
     in doctor.js (_computeTierConfirmBannerFlag). Never a hard gate. */
  var _tbAr = (typeof isAr !== 'undefined') ? !!isAr : false;
  var _tbShow = (typeof locals !== 'undefined' && locals && locals.doctorTierBanner) ? true : false;
%>
<% if (_tbShow) { %>
<div class="v2-tier-nudge" role="status" style="margin:0 0 12px;padding:12px 16px;border:1px solid #BFDDD6;background:#EDF6F4;border-radius:10px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
  <div style="display:flex;align-items:flex-start;gap:10px;min-width:0;">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0B6B5F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;margin-top:2px;">
      <circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/>
    </svg>
    <div style="min-width:0;">
      <div style="color:#074B43;font-weight:650;">
        <%= _tbAr ? 'أكد سرعات التسليم التي تقبلها' : 'Confirm which turnaround speeds you accept' %>
      </div>
      <div style="color:#2C3A4A;font-size:12.5px;line-height:1.5;margin-block-start:2px;">
        <%= _tbAr
              ? 'أنت الآن مُدرج لجميع السرعات: قياسي (48 ساعة) وVIP (18 ساعة) وعاجل (4 ساعات). راجعها وأبقِ ما يناسبك فقط.'
              : 'You are currently listed for all three: Standard (48h), VIP (18h) and Urgent (4h). Review them and keep only the ones that suit you.' %>
      </div>
    </div>
  </div>
  <a class="v2-btn v2-btn--sm" href="/portal/doctor/services#turnaround" style="white-space:nowrap;background:#0B6B5F;color:#F8F5EF;border-radius:8px;padding:6px 14px;text-decoration:none;font-weight:600;">
    <%= _tbAr ? 'مراجعة' : 'Review' %>
  </a>
</div>
<% } %>
