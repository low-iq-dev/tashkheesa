  <%# ── FAQ ─────────────────────────────────────────────────────────── %>
  <section class="sv3-sec" aria-labelledby="sv3-faq">
   <h2 class="sv3-h2" id="sv3-faq"><%= tt('svc3.faq.title', 'What people ask before they start', 'أسئلة الناس قبل ما تبدأ') %></h2>
   <div class="sv3-faq">
    <% [
      [tt('svc3.faq1.q', 'Will my doctor mind if I get a second opinion?', 'دكتوري هيزعل لو أخدت رأي تاني؟'), tt('svc3.faq1.a', 'A second opinion is normal in medicine. The report is yours, and you decide whether to show it to your doctor.', 'الرأي الطبي التاني حاجة عادية في الطب. التقرير بتاعك، وإنت اللي تقرر توريه لدكتورك ولا لأ.')],
      [tt('svc3.faq2.q', 'Who reads my file?', 'مين اللي هيقرا ملفي؟'), tt('svc3.faq2.a', 'A consultant in the same specialty from Shifa Hospital Group. Their name and signature are on your report.', 'استشاري في نفس التخصص من مجموعة مستشفيات شفا، واسمه وتوقيعه على تقريرك.')],
      [tt('svc3.faq3.q', 'When does the report arrive?', 'التقرير بيوصل إمتى؟'), tt('svc3.faq3.a', 'Within 48 hours on Standard, 18 hours on VIP or 4 hours on Urgent.', 'في خلال 48 ساعة في Standard، أو 18 ساعة في VIP، أو 4 ساعات في العاجل.')],
      [tt('svc3.faq4.q', 'Is this a diagnosis?', 'ده تشخيص؟'), tt('svc3.faq4.a', 'No. It is a written second opinion based on the files you send. It does not replace an examination or emergency care.', 'لأ. ده رأي طبي ثانٍ مكتوب بناءً على الملفات اللي بتبعتها، ومش بديل عن الكشف ولا عن الطوارئ.')],
      [tt('svc3.faq5.q', 'How do I pay?', 'أدفع إزاي؟'), (__pbLocal ? tt('svc3.faq5.a_intl', 'By Visa or Mastercard. You see the full price before you pay; your card is charged the equivalent in Egyptian pounds.', 'بفيزا أو ماستركارد. السعر بيظهر كامل قبل ما تدفع، والبطاقة بتتخصم بما يعادله بالجنيه المصري.') : tt('svc3.faq5.a', 'By InstaPay or bank transfer. You see the full price before you pay.', 'إنستاباي أو تحويل بنكي، والسعر بيظهر كامل قبل ما تدفع.'))],
      [tt('svc3.faq6.q', 'What if my specialty is not listed?', 'لو تخصصي مش موجود؟'), tt('svc3.faq6.a', 'Message us on WhatsApp and we will tell you whether a consultant can take your case.', 'كلمنا على واتساب ونقولك لو في استشاري يقدر ياخد حالتك.')]
    ].forEach(function (f, i) { %>
    <details<%= i === 0 ? ' open' : '' %>><summary><%= f[0] %></summary><p><%= f[1] %></p></details>
    <% }); %>
