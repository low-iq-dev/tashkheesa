<%- include('partials/header', { title: tt('svc.page_title', 'Services & Pricing', 'الخدمات والأسعار'), layout: "public", showNav: true }) %>
<%#
  Services page, v3 (14 Oct 2026). The colourful redesign approved on the
  Claude Design canvas ("Services page on iPhone: before, v2 and v3").

  Everything that decides WHAT a visitor may do is unchanged from the page it
  replaces: the booking gate (__ctaOn), bookHref(), isBookable(), the hero's
  sign-up destination, the coming-soon partition and the funnel tags. Only the
  presentation changed. Styles are scoped under .sv3 so nothing leaks into the
  shared header and footer.
%>
<style>
.sv3{text-align:start;--ink:#0F1E2D;--ink2:#33474F;--mute:#4A5F6B;--teal:#0B6B5F;--teal-d:#084C45;--teal-2:#128174;--teal-3:#0E7A6D;--gold:#F2C76E;--bg:#F5F8FA;--line:#E6ECEF;--card:#FFFFFF;--wa:#1E8E4E;--wa-bg:#E7F7EE;
  background:var(--bg);color:var(--ink);padding:14px 0 56px;}
.sv3 *{box-sizing:border-box}
.sv3 a{text-decoration:none}
.sv3 h1,.sv3 h2,.sv3 h3{color:inherit;margin:0}
.sv3-wrap{max-width:1120px;margin:0 auto;padding:0 14px}
.sv3-sec{margin-top:34px}
.sv3-h2{font-size:22px;font-weight:700;line-height:1.35;margin:0 4px 14px;color:var(--ink)}
.sv3-h2-row{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin:0 4px 14px}
.sv3-h2-row .sv3-h2{margin:0}
.sv3-meta{font-size:13px;color:var(--mute)}
.sv3-ic{display:flex;align-items:center;justify-content:center;flex:none;border-radius:13px}
.sv3-ic svg{display:block}

/* Hero */
.sv3-hero{background:var(--teal);border-radius:26px;padding:24px 20px 20px;color:#fff;position:relative;overflow:hidden}
.sv3-hero:before{content:"";position:absolute;width:240px;height:240px;border-radius:50%;background:var(--teal-2);top:-100px;inset-inline-end:-80px}
.sv3-hero:after{content:"";position:absolute;width:130px;height:130px;border-radius:50%;background:var(--teal-3);bottom:-56px;inset-inline-start:42%}
.sv3-hero-in{position:relative;z-index:1;display:grid;gap:18px}
.sv3-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.14);border-radius:999px;padding:5px 12px;font-size:12px;font-weight:600;justify-self:start}
.sv3-hero h1{font-size:30px;line-height:1.32;font-weight:700;color:#fff;margin-top:10px}
.sv3-hero h1 span{color:var(--gold)}
.sv3-hero p.sv3-lead{font-size:15px;line-height:1.7;color:#DDF0EC;margin:10px 0 0}
.sv3-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.sv3-chip{background:rgba(255,255,255,.14);border-radius:999px;padding:5px 11px;font-size:12px;font-weight:600;color:#fff}
.sv3-chip--solid{background:#fff;color:var(--teal);font-weight:700}
.sv3-hero-img{width:100%;height:190px;object-fit:cover;border-radius:18px;display:block}
.sv3-btns{display:grid;gap:10px;margin-top:4px}
.sv3-btn{display:flex;align-items:center;justify-content:center;gap:8px;min-height:52px;border-radius:16px;font-size:17px;font-weight:700;padding:10px 18px;text-align:center;border:0;cursor:pointer;font-family:inherit}
.sv3-btn--hero{background:#fff;color:var(--teal)}
.sv3-btn--hero span{font-weight:500;color:var(--mute)}
.sv3-btn--ghost{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.55);font-size:15px}
.sv3-btn--teal{background:var(--teal);color:#fff}
.sv3-btn--teal:hover{background:var(--teal-d)}
.sv3-btn--wa{background:var(--wa-bg);color:var(--wa);font-size:16px}
.sv3 .urgent-window-note{color:#CDE7E2;font-size:13px;line-height:1.55;margin:2px 0 0}

/* Trust */
.sv3-trust{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
.sv3-tile{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:12px 14px;display:flex;align-items:center;gap:12px;box-shadow:0 1px 2px rgba(15,30,45,.04)}
.sv3-tile b{display:block;font-size:20px;font-weight:700;line-height:1.2;direction:ltr;text-align:start}
.sv3-tile small{display:block;font-size:12px;color:var(--mute)}

/* Speeds */
.sv3-speeds{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.sv3-speed{border-radius:18px;padding:14px 8px;text-align:center}
.sv3-speed .k{font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:11px;font-weight:600;letter-spacing:.06em;direction:ltr}
.sv3-speed .v{font-size:32px;font-weight:700;line-height:1.15;margin-top:4px;direction:ltr}
.sv3-speed .u{font-size:13px;color:var(--ink2)}
.sv3-note{font-size:13px;color:var(--mute);line-height:1.6;margin:10px 4px 0}

/* Specialty tiles */
.sv3-specs{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.sv3-spec{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:14px;display:flex;flex-direction:column;gap:8px;color:var(--ink);box-shadow:0 1px 2px rgba(15,30,45,.04);transition:transform .15s,box-shadow .15s}
.sv3-spec:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(15,30,45,.08);color:var(--ink)}
.sv3-spec .n{font-size:15px;font-weight:700;line-height:1.3}
.sv3-spec .s{font-size:12px;color:var(--mute)}

/* Help card */
.sv3-help{margin-top:14px;background:#FFF5D9;border-radius:20px;padding:16px 18px;display:flex;gap:12px;align-items:flex-start}
.sv3-help h3{font-size:17px;font-weight:700}
.sv3-help p{font-size:14px;line-height:1.65;color:#5B4A1E;margin:4px 0 8px}
.sv3-help a{font-size:14px;font-weight:700;color:var(--teal)}

/* Specialty sections */
.sv3-cat{background:var(--card);border:1px solid var(--line);border-radius:22px;overflow:hidden;margin-top:14px;scroll-margin-top:80px}
.sv3-cat-hd{padding:16px;display:flex;gap:14px;align-items:center}
.sv3-cat-hd .sv3-ic{width:52px;height:52px;border-radius:16px;background:#fff}
.sv3-cat-hd h2{font-size:21px;font-weight:700;line-height:1.3}
.sv3-cat-hd .d{font-size:13px;color:var(--ink2);line-height:1.5}
.sv3-cat-hd .m{font-size:12px;color:var(--mute);margin-top:2px}
.sv3-rows{padding:10px 12px 4px;display:grid;gap:8px}
.sv3 .service-card{min-height:56px;background:var(--bg);border:1px solid transparent;border-radius:14px;padding:8px 12px 8px 14px;display:flex;align-items:center;justify-content:space-between;gap:10px;color:var(--ink);transition:border-color .15s,background .15s}
.sv3 .service-card{flex-direction:row;height:auto;box-shadow:none;transform:none}
.sv3 a.service-card:hover{border-color:var(--teal);background:#fff;transform:none;box-shadow:0 4px 14px rgba(11,107,95,.10)}
.sv3 .service-card h3{flex:1;min-width:0;text-align:start;font-size:15px;font-weight:600;line-height:1.45;margin:0}
.sv3 .service-card .sla{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;font-size:12.5px;line-height:1.55;color:var(--mute);font-weight:400;margin-top:2px}
.sv3-price{flex:none;background:#fff;border:1px solid var(--line);border-radius:999px;padding:6px 12px;font-size:14px;font-weight:700;color:var(--teal);direction:ltr;white-space:nowrap}
.sv3-price small{font-size:11px;font-weight:600;color:var(--mute)}
.sv3-more{padding:0 12px}
.sv3-more summary{list-style:none;cursor:pointer;font-size:14px;font-weight:700;color:var(--teal);padding:10px 4px}
.sv3-more summary::-webkit-details-marker{display:none}
.sv3-more[open] summary{display:none}
.sv3-more .sv3-rows{padding:0 0 4px}
.sv3-cat-ft{padding:10px 12px 14px}
.sv3-cat-ft .sv3-btn{min-height:48px;font-size:15px}
.service-soon-badge{display:inline-block;font-size:12px;font-weight:700;color:#8E6C2C;background:#FAF1DD;border-radius:999px;padding:5px 10px}
.sv3-soon{margin-top:14px;background:var(--card);border:1px dashed #C9D5DA;border-radius:20px;padding:16px 18px;text-align:center}
.sv3-soon h3{font-size:16px;font-weight:700}
.sv3-soon p{font-size:14px;line-height:1.7;color:var(--mute);margin:6px 0 0}
.sv3-soon a{color:var(--teal);font-weight:700}

/* Steps */
.sv3-steps{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:6px 16px}
.sv3-step{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid var(--line)}
.sv3-step:last-child{border-bottom:0}
.sv3-step .sv3-ic{width:40px;height:40px;border-radius:50%;font-weight:700;font-size:17px}
.sv3-step h3{font-size:16px;font-weight:700}
.sv3-step p{font-size:14px;line-height:1.6;color:var(--mute);margin:3px 0 0}

/* Report sample */
.sv3-report{background:#EDEFFC;border-radius:24px;padding:18px 16px}
.sv3-paper{background:#fff;border-radius:16px;padding:16px;box-shadow:0 10px 28px rgba(40,50,120,.12);position:relative;overflow:hidden}
.sv3-paper-hd{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid var(--teal);padding-bottom:10px}
.sv3-paper-hd b{font-size:15px}
.sv3-paper-hd small{display:block;font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:10px;letter-spacing:.08em;color:var(--mute);direction:ltr;text-align:start}
.sv3-paper-sec{margin-top:12px}
.sv3-paper-sec b{font-size:13px;color:var(--teal)}
.sv3-bar{height:7px;border-radius:4px;background:#E9EEF0;margin-top:7px}
.sv3-paper-sign{display:flex;justify-content:space-between;align-items:center;margin-top:14px;font-size:12px;color:var(--mute)}
.sv3-stamp{position:absolute;inset-inline-end:16px;bottom:52px;transform:rotate(-12deg);border:2px solid #3B4BBD;color:#3B4BBD;border-radius:10px;padding:2px 10px;font-weight:700;font-size:14px;background:rgba(255,255,255,.85)}
.sv3-points{list-style:none;margin:14px 0 0;padding:0;display:grid;gap:9px}
.sv3-points li{display:flex;gap:10px;align-items:flex-start;font-size:14px;font-weight:600;line-height:1.5}
.sv3-points li span.sv3-ic{width:22px;height:22px;border-radius:50%;background:#fff;margin-top:1px}

/* Consultants */
.sv3-docs{display:flex;gap:10px;overflow-x:auto;padding:2px 4px 8px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch}
.sv3-doc{flex:0 0 168px;scroll-snap-align:start;border-radius:20px;padding:10px;text-align:center}
.sv3-doc img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:14px;display:block;background:#fff}
.sv3-doc b{display:block;font-size:14px;margin-top:8px}
.sv3-doc span{display:inline-block;margin-top:5px;font-size:12px;font-weight:600;border-radius:999px;padding:3px 10px;background:#fff}

/* When */
.sv3-whens{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.sv3-when{border-radius:18px;padding:14px;font-size:14px;font-weight:700;line-height:1.5;display:flex;flex-direction:column;gap:8px}

/* Ladder */
.sv3-ladder{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:4px 16px}
.sv3-rung{display:flex;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}
.sv3-rung:last-child{border-bottom:0}
.sv3-rung i{flex:none;width:5px;height:30px;border-radius:3px}
.sv3-rung .t{flex:1;font-size:14px;line-height:1.5;color:var(--ink2)}
.sv3-rung .p{flex:none;font-size:17px;font-weight:700;direction:ltr}
.sv3-rung .p small{font-size:11px;color:var(--mute);font-weight:600}
.sv3-pay{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:12px 4px 0;font-size:13px;color:var(--mute)}
.sv3-pay b{background:#E3F3F0;color:var(--teal);border-radius:999px;padding:5px 12px;font-size:13px}

/* Privacy */
.sv3-priv{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
.sv3-priv div{border-radius:18px;padding:14px}
.sv3-priv h3{font-size:15px;font-weight:700;margin-top:6px}
.sv3-priv p{font-size:13px;line-height:1.6;color:var(--ink2);margin:4px 0 0}

/* FAQ */
.sv3-faq{background:var(--card);border:1px solid var(--line);border-radius:22px;overflow:hidden}
.sv3-faq details{border-bottom:1px solid var(--line)}
.sv3-faq details:last-child{border-bottom:0}
.sv3-faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px;font-size:15px;font-weight:700}
.sv3-faq summary::-webkit-details-marker{display:none}
.sv3-faq summary:after{content:"";flex:none;width:9px;height:9px;border-right:2px solid var(--ink2);border-bottom:2px solid var(--ink2);transform:rotate(45deg);margin-top:-4px;transition:transform .15s}
.sv3-faq details[open] summary:after{transform:rotate(-135deg);margin-top:4px}
.sv3-faq p{margin:0;padding:0 16px 16px;font-size:14px;line-height:1.7;color:var(--mute)}
.sv3-faq-more{display:block;text-align:center;margin-top:12px;font-size:14px;font-weight:700;color:var(--teal)}

/* Final CTA */
.sv3-final{background:var(--teal);color:#fff;border-radius:26px;padding:24px 20px;position:relative;overflow:hidden}
.sv3-final:before{content:"";position:absolute;width:200px;height:200px;border-radius:50%;background:var(--teal-2);bottom:-90px;inset-inline-start:-60px}
.sv3-final>*{position:relative}
.sv3-final h2{font-size:26px;line-height:1.35;font-weight:700;color:#fff}
.sv3-final h2 span{color:var(--gold)}
.sv3-final p{color:#DDF0EC;font-size:14px;line-height:1.6;margin:8px 0 16px}
.sv3-final .sv3-btns{max-width:420px}
.sv3-disclaimer{font-size:12px;line-height:1.7;color:var(--mute);text-align:center;margin:18px auto 0;max-width:640px}

/* Locked CTAs: deliberately shut (services/public_cta.js), not broken. */
.is-cta-locked{background:#E5E7EB !important;color:#6B7280 !important;border-color:#D1D5DB !important;cursor:not-allowed;box-shadow:none !important;pointer-events:none}

@media (min-width:760px){
  .sv3{padding-top:24px}
  .sv3-wrap{padding:0 24px}
  .sv3-hero{padding:40px 40px 36px;border-radius:32px}
  .sv3-hero-in{grid-template-columns:1.15fr 1fr;align-items:center;gap:32px}
  .sv3-hero h1{font-size:44px}
  .sv3-hero p.sv3-lead{font-size:17px;max-width:520px}
  .sv3-hero-img{height:100%;min-height:300px}
  .sv3-btns{grid-template-columns:1fr 1fr}
  .sv3-trust{grid-template-columns:repeat(4,1fr)}
  .sv3-specs{grid-template-columns:repeat(5,1fr)}
  .sv3-cats{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start}
  .sv3-cats .sv3-cat{margin-top:0}
  .sv3-two{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start}
  .sv3-two>.sv3-sec{margin-top:34px}
  .sv3-whens{grid-template-columns:repeat(4,1fr)}
  .sv3-sec{margin-top:48px}
  .sv3-h2{font-size:26px}
  .sv3-final{padding:40px;display:grid;grid-template-columns:1.2fr 1fr;gap:24px;align-items:center}
  .sv3-final h2{font-size:34px}
  .sv3-final .sv3-btns{grid-template-columns:1fr}
}
</style>
<%
  // ── Booking links. Unchanged rules, see the comments on each. ──────────
  const __heroMin = (services || []).filter(x => x && x.is_bookable && x.base_price > 0)
    .reduce((m, x) => (m == null || x.base_price < m ? x.base_price : m), null);
  const __heroAr = !!(typeof isAr !== 'undefined' && isAr);
  // 11 Oct 2026 — the hero button goes straight to sign-up (or the case form
  // when signed in), exactly like every booking link further down this page.
  const __heroLp = (typeof langParam !== 'undefined' && langParam) ? langParam : '';
  const __heroIn = !!(typeof user !== 'undefined' && user && user.id);
  // While the booking gate is shut no link on this page may open sign-up
  // or the case form, so the hero keeps its old /start destination.
  const __heroCtaOn = (typeof bookingCtaEnabled !== 'undefined') ? !!bookingCtaEnabled : false;
  const __heroStartHref = !__heroCtaOn
    ? (locals.publicLinkPrefix || '') + '/start'
    : __heroIn
      ? '/patient/new-case' + (__heroLp ? '?' + __heroLp : '')
      : '/register?next=' + encodeURIComponent('/patient/new-case') + (__heroLp ? '&' + __heroLp : '');
  const __lpx = locals.publicLinkPrefix || '';

  // Logged-out visitors go to REGISTER, not login (see public-cta tests).
  const __loggedIn = !!(typeof user !== 'undefined' && user && user.id);
  const submitUrl = __loggedIn ? '/patient/new-case' : '/register?next=/patient/new-case';
  const __lp = (typeof langParam !== 'undefined' && langParam) ? langParam : '';
  // One builder for every booking link on this page. `next` is encoded as a
  // whole so a specialty name containing '&' cannot split it.
  function bookHref(qs) {
    const target = '/patient/new-case' + (qs ? '?' + qs : '');
    const base = __loggedIn ? target : '/register?next=' + encodeURIComponent(target);
    return __lp ? base + (base.indexOf('?') === -1 ? '?' : '&') + __lp : base;
  }

  const __isAr = !!(typeof isAr !== 'undefined' && isAr);
  const __specNameArMap = (typeof specialtyNameArMap === 'object' && specialtyNameArMap) ? specialtyNameArMap : {};
  function specDisplayName(enName) {
    return (__isAr && __specNameArMap[enName]) ? __specNameArMap[enName] : enName;
  }
  // English article by SOUND, not letter ("an OB/GYN", "a Urology").
  const AN_DESPITE_CONSONANT = /^(OB\/?GYN|ENT|MRI|ECG|EEG|X-ray|MSK|hour|honest)/i;
  const A_DESPITE_VOWEL = /^(uro|uri|uni|use|usu|util|euro|eu[a-z]|one\b)/i;
  function enArticle(name) {
    const n = String(name || '').trim();
    if (AN_DESPITE_CONSONANT.test(n)) return 'an';
    if (A_DESPITE_VOWEL.test(n)) return 'a';
    return /^[aeiou]/i.test(n) ? 'an' : 'a';
  }
  // Orderable only if the shared SQL rule (serviceBookableClause) said so.
  function isBookable(sv) { return !!(sv && sv.is_bookable); }
  function svcName(sv) {
    if (!sv) return '';
    return (__isAr && sv.name_ar) ? sv.name_ar : sv.name;
  }
  const __specLive = (typeof specialtyLiveMap !== 'undefined' && specialtyLiveMap) ? specialtyLiveMap : {};
  const __isLiveSpec = (sp) => !!__specLive[sp];
  // The public booking gate (services/public_cta.js). When off, every CTA
  // renders as an inert grey control instead of an anchor.
  const __ctaOn = (typeof bookingCtaEnabled !== 'undefined') ? !!bookingCtaEnabled : false;
  const __ctaOffLabel = tt('svc.cta.locked', 'Booking opens soon', 'الحجز هيفتح قريب');

  // ── Catalogue, grouped. ────────────────────────────────────────────────
  const seen = new Set();
  const uniqueServices = (services || []).filter(s => {
    if (seen.has(s.id)) return false;
    seen.add(s.id);
    return true;
  });
  const bySpecialty = {};
  uniqueServices.forEach(s => {
    const sp = s.specialty_name || 'Other';
    if (!bySpecialty[sp]) bySpecialty[sp] = [];
    bySpecialty[sp].push(s);
  });
  // Bookable first, then cheapest first, so each list opens on the price a
  // visitor can actually start at.
  Object.keys(bySpecialty).forEach(sp => {
    bySpecialty[sp].sort((a, b) =>
      (isBookable(b) - isBookable(a)) || ((a.base_price || 0) - (b.base_price || 0)));
  });
  const __fromPrice = {};
  uniqueServices.forEach(s => {
    if (!isBookable(s) || !(s.base_price > 0)) return;
    const sp = s.specialty_name || 'Other';
    if (__fromPrice[sp] == null || s.base_price < __fromPrice[sp]) __fromPrice[sp] = s.base_price;
  });
  const __minPrice = Object.values(__fromPrice).reduce((m, v) => (m == null || v < m ? v : m), null);
  const __fmt = v => Number(v).toLocaleString('en-US', { maximumFractionDigits: 0 });
  // 16 Oct 2026 — a visitor outside Egypt sees their own price list (£ for the
  // UK), the same numbers the checkout charges from. `prices` is a
  // public_market.priceBook; for Egypt it is not local and nothing changes.
  const __pb = (typeof prices !== 'undefined' && prices) ? prices : null;
  const __pbLocal = !!(__pb && __pb.isLocal);
  const __loc = (egp, sid) => (__pbLocal ? __pb.format(egp, sid) : null);
  const __fromChip = (egp, cap) => {
    const l = __loc(egp);
    if (l) return (__heroAr ? 'من ' : (cap ? 'From ' : 'from ')) + l;
    return __heroAr ? ('من ' + __fmt(egp) + ' جنيه') : ((cap ? 'From' : 'from') + ' EGP ' + __fmt(egp));
  };

  // Descriptions (unchanged copy) + the v3 colour, tint and icon per specialty.
  const specialtyMeta = {
    'Radiology':                { desc: 'X-ray, MRI, CT scan & ultrasound review',         desc_ar: 'مراجعة الأشعة العادية والرنين والمقطعية والسونار' },
    'Cardiology':               { desc: 'ECG, echo, Holter & cardiac imaging',             desc_ar: 'رسم القلب، الإيكو، الهولتر، وأشعة القلب' },
    'Oncology':                 { desc: 'Cancer staging, bone marrow & tumor review',      desc_ar: 'تحديد مرحلة الورم، نخاع العظم، ومراجعة الأورام' },
    'Neurology':                { desc: 'Brain MRI, EEG, EMG/NCS & spine imaging',         desc_ar: 'رنين المخ، رسم المخ، رسم العصب، وأشعة العمود الفقري' },
    'Lab & Pathology':          { desc: 'Blood work, hormones, histopathology & microbiology', desc_ar: 'تحاليل الدم، الهرمونات، الباثولوجي، والميكروبيولوجي' },
    'Orthopedics':              { desc: 'Joint MRI, fracture review & surgical opinion',    desc_ar: 'رنين المفاصل، مراجعة الكسور، ورأي تاني للعمليات' },
    'Gastroenterology':         { desc: 'Endoscopy, liver, MRCP & IBD workup',              desc_ar: 'المنظار، الكبد، أشعة القنوات المرارية، والتهابات الأمعاء' },
    'Endocrinology':            { desc: 'Thyroid, diabetes, PCOS & metabolic review',       desc_ar: 'الغدة الدرقية، السكر، تكيس المبايض، ومراجعة الأيض' },
    'Internal Medicine':        { desc: 'General medical case review & diagnostics',        desc_ar: 'مراجعة طبية عامة وتشخيص' },
    'Pediatrics':               { desc: 'Pediatric case review & child health',             desc_ar: 'مراجعة حالات الأطفال وصحتهم' },
    'OB/GYN':                   { desc: 'Obstetric ultrasound, fertility & pelvic MRI',     desc_ar: 'سونار الحوامل، الخصوبة، ورنين الحوض' },
    'Urology':                  { desc: 'Prostate MRI, PSA review & renal imaging',         desc_ar: 'رنين البروستاتا، تحليل PSA، وأشعة الكلى' },
    'Nephrology':               { desc: 'Kidney function, stones, dialysis & biopsy review', desc_ar: 'وظائف الكلى، الحصوات، الغسيل، ومراجعة العينات' },
    'Clinical Nutrition':       { desc: 'Therapeutic diet and nutrition review',            desc_ar: 'مراجعة التغذية العلاجية' }
  };
  function metaDesc(sp) {
    const m = specialtyMeta[sp];
    return (__isAr && m && m.desc_ar) ? m.desc_ar : (m && m.desc) || '';
  }
  const I = {
    heart: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z M8 12h2l1-2 2 4 1-2h2',
    scan: 'M4 8V5h3 M17 5h3v3 M20 16v3h-3 M7 19H4v-3 M9 12a3 3 0 1 0 6 0 3 3 0 1 0-6 0',
    bone: 'M16.5 3.5a2.5 2.5 0 0 1 2.2 3.7 2.5 2.5 0 0 1-1.9 3.6L10.8 16.8a2.5 2.5 0 0 1-3.6 1.9 2.5 2.5 0 0 1-3.7-2.2 2.5 2.5 0 0 1 3.7-2.2l6.2-6.2a2.5 2.5 0 0 1 3.1-4.6z',
    baby: 'M5 13a7 7 0 1 0 14 0 7 7 0 1 0-14 0 M9.5 15.5c1.5 1.2 3.5 1.2 5 0 M10 11.5h.01 M14 11.5h.01 M12 6c0-1.5 1-2.5 2.5-2.5',
    fem: 'M7 9a5 5 0 1 0 10 0 5 5 0 1 0-10 0 M12 14v7 M9 18h6',
    drop: 'M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z',
    steth: 'M6 3v6a5 5 0 0 0 10 0V3 M11 14v2a4 4 0 0 0 8 0v-2 M17 12a2 2 0 1 0 4 0 2 2 0 1 0-4 0',
    kidney: 'M15 4c-3 0-5 2-5 5 0 1.5 1.5 2 1.5 3.5S10 15 10 16.5C10 19 12 21 14.5 21 18 21 20 17 20 12.5S18 4 15 4z',
    gut: 'M9 3v4c0 2-3 3-3 7a6 6 0 0 0 12 0c0-3-2-4-4-4h-2',
    apple: 'M12 7c-2-2-7-1.5-7 4 0 4 3 9 5 9 1 0 1.5-.5 2-.5s1 .5 2 .5c2 0 5-5 5-9 0-5.5-5-6-7-4z M12 7c0-2 1-3.5 3-4',
    plus: 'M12 5v14 M5 12h14',
    file: 'M7 3h7l5 5v13H7z M14 3v5h5 M10 13h6 M10 17h6',
    bed: 'M3 18v-8 M3 14h18v4 M21 14v-2a3 3 0 0 0-3-3h-7v5 M7 11.5a1.5 1.5 0 1 0 0 .01',
    shield: 'M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z M9 12l2 2 4-4',
    cut: 'M6 6l12 12 M4 4a2 2 0 1 0 4 4 2 2 0 1 0-4-4 M16 16a2 2 0 1 0 4 4 2 2 0 1 0-4-4',
    doc: 'M6 3h9l3 3v15H6z M9 9h6 M9 13h6 M9 17h3',
    two: 'M4 7h7v10H4z M13 7h7v10h-7z',
    home: 'M4 11l8-7 8 7v9H4z M10 20v-6h4v6',
    lock: 'M6 11h12v10H6z M8 11V8a4 4 0 0 1 8 0v3',
    info: 'M12 3a9 9 0 1 0 0 18 9 9 0 1 0 0-18 M12 11v5 M12 8h.01',
    bulb: 'M9 18h6 M10 21h4 M12 3a6 6 0 0 0-4 10.5c.8.8 1 1.5 1 2.5h6c0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3z',
    check: 'M5 12.5l4.5 4.5L19 7.5'
  };
  const SKIN = {
    'Cardiology':         { c: '#D9661F', t: '#FDEFE3', i: I.heart },
    'Radiology':          { c: '#4C5FD5', t: '#EDEFFC', i: I.scan },
    'Orthopedics':        { c: '#1F74D1', t: '#E8F1FC', i: I.bone },
    'Pediatrics':         { c: '#C98A00', t: '#FFF5D9', i: I.baby },
    'OB/GYN':             { c: '#7A5AC9', t: '#F1ECFB', i: I.fem },
    'Urology':            { c: '#0E8FA8', t: '#E2F5F9', i: I.drop },
    'Internal Medicine':  { c: '#0B6B5F', t: '#E3F3F0', i: I.steth },
    'Nephrology':         { c: '#2E9D5B', t: '#E6F6EC', i: I.kidney },
    'Gastroenterology':   { c: '#6E8E14', t: '#F0F5DF', i: I.gut },
    'Clinical Nutrition': { c: '#B5651D', t: '#FBEEE1', i: I.apple }
  };
  const skin = sp => SKIN[sp] || { c: '#0B6B5F', t: '#E3F3F0', i: I.plus };
  function svg(d, color, size, sw) {
    return '<svg aria-hidden="true" width="' + (size || 22) + '" height="' + (size || 22) + '" viewBox="0 0 24 24" fill="none" stroke="' + color + '" stroke-width="' + (sw || 2) + '" stroke-linecap="round" stroke-linejoin="round"><path d="' + d + '"/></svg>';
  }

  // Display order: hand-ordered names first, then the rest; every bookable
  // specialty before every coming-soon one.
  const specOrder = ['Cardiology','Radiology','Orthopedics','Pediatrics','OB/GYN','Urology',
    'Internal Medicine','Nephrology','Gastroenterology','Clinical Nutrition'];
  const __allSpecs = [
    ...specOrder.filter(sp => bySpecialty[sp]),
    ...Object.keys(bySpecialty).filter(sp => !specOrder.includes(sp)).sort()
  ];
  // A live specialty lists only what can be booked; specialties with no
  // consultant yet are one short line at the bottom.
  const __liveSpecs = __allSpecs.filter(sp => __isLiveSpec(sp) && (bySpecialty[sp] || []).length);
  const __soonSpecs = __allSpecs.filter(sp => !__isLiveSpec(sp) && (bySpecialty[sp] || []).length);
  const __listFor = sp => {
    const all = bySpecialty[sp] || [];
    const b = all.filter(isBookable);
    return b.length ? b : all;
  };
  const __bookableCount = uniqueServices.filter(isBookable).length;
  const sectionId = sp => sp.replace(/[^a-z0-9]/gi, '-').toLowerCase();
  // A local price carries its own symbol (£150), so the EGP word is dropped.
  const egp = __pbLocal ? '' : (__isAr ? 'جنيه' : 'EGP');
  const fromTxt = v => { const l = __loc(v); return __isAr ? ('من ' + (l || __fmt(v))) : ('from ' + (l || __fmt(v))); };
  function typesTxt(n) {
    // "N من الأنواع" style avoided: a plain "N types" reads right in both.
    return __isAr ? (n + ' ' + (n >= 3 && n <= 10 ? 'أنواع' : 'نوع')) : (n + (n === 1 ? ' report type' : ' report types'));
  }

  // Price ladder: the prices are whatever is bookable today; the line under
  // each is the kind of review that sits at that price.
  const LADDER_TXT = {
    750:  ['Report read — one question', 'قراءة تقرير — سؤال واحد'],
    1200: ['ECG, plain X-ray, ultrasound, blood count', 'رسم القلب، أشعة عادية، سونار، صورة دم'],
    1600: ['Echo, MRI, CT, Holter', 'إيكو، رنين، مقطعية، هولتر'],
    2400: ['Coronary CT, endoscopy, full case review', 'مقطعية الشرايين، المنظار، مراجعة الحالة كاملة'],
    3500: ['Pre-surgery opinion, chronic kidney follow-up', 'رأي قبل العملية، متابعة الكلى المزمنة']
  };
  const LADDER_C = ['#0B6B5F', '#1F74D1', '#4C5FD5', '#D9661F', '#C98A00', '#7A5AC9'];
  const __ladder = Array.from(new Set(uniqueServices.filter(s => isBookable(s) && s.base_price > 0).map(s => Number(s.base_price))))
    .sort((a, b) => a - b)
    .map(function (p, i) {
      const known = LADDER_TXT[p];
      const t = known ? known[__isAr ? 1 : 0]
        : uniqueServices.filter(s => isBookable(s) && Number(s.base_price) === p).slice(0, 2).map(svcName).join(__isAr ? '، ' : ', ');
      return { p: p, t: t, c: LADDER_C[i % LADDER_C.length] };
    });

  // Consultants who have agreed to be named and pictured in our marketing.
  const DOCS = [
    { img: 'dr-nancy',  en: 'Dr Nancy Ghoneim',     ar: 'د. نانسي غنيم',       sp: 'Internal Medicine' },
    { img: 'dr-jamal',  en: 'Dr Mohammed Jamaleddin', ar: 'د. محمد جمال الدين', sp: 'Orthopedics' },
    { img: 'dr-sultan', en: 'Dr Khaled Sultan',     ar: 'د. خالد سلطان',       sp: 'OB/GYN' },
    { img: 'dr-zaky',   en: 'Dr Ibrahim Zaky',      ar: 'د. إبراهيم زكي',      sp: 'Urology' },
    { img: 'dr-hassan', en: 'Dr Hassan Khaled',     ar: 'د. حسن خالد',         sp: 'OB/GYN' }
  ];
%>

<main class="sv3">
 <div class="sv3-wrap">

  <%# ── HERO ─────────────────────────────────────────────────────────── %>
  <section class="sv3-hero" aria-labelledby="sv3-h1">
   <div class="sv3-hero-in">
    <div>
     <div class="sv3-badge"><%- svg(I.shield, '#F2C76E', 14, 2.4) %> <%= tt('svc3.hero.badge', 'Shifa Hospital Group · GAHAR-accredited', 'مجموعة مستشفيات شفا · معتمدة من GAHAR') %></div>
     <h1 id="sv3-h1"><%= tt('svc3.hero.h1a', 'A written second medical opinion,', 'رأي طبي ثانٍ مكتوب،') %><br><span><%= tt('svc3.hero.h1b', 'from a named consultant.', 'من استشاري باسمه.') %></span></h1>
     <p class="sv3-lead"><%= tt('svc3.hero.lead',
       'Upload your scans or lab results from your phone and receive a report in Arabic and English, with the consultant\'s name and signature.',
       'ارفع أشعتك أو تحاليلك من موبايلك، واستلم تقرير بالعربي والإنجليزي، باسم الاستشاري وتوقيعه.') %></p>
     <div class="sv3-chips">
      <% if (__heroMin) { %><span class="sv3-chip sv3-chip--solid"><%= __fromChip(__heroMin, true) %></span><% } %>
      <span class="sv3-chip"><%= tt('svc3.hero.chip_time', 'In 48 hours or less', 'في 48 ساعة أو أقل') %></span>
      <span class="sv3-chip"><%= tt('svc3.hero.chip_ai', 'Not AI', 'مش ذكاء اصطناعي') %></span>
     </div>
    </div>
    <div style="display:grid;gap:12px">
     <img class="sv3-hero-img" src="/assets/services/hero-desk.webp" width="900" height="558" alt="<%= tt('svc3.hero.img_alt', 'A consultant\'s desk with a printed report and reading glasses', 'مكتب استشاري عليه تقرير مطبوع ونظارة') %>">
     <div class="sv3-btns">
      <%# The hero CTA keeps its /start destination while the gate is shut
          (__heroCtaOn above), so it is an anchor in both states. %>
      <a href="<%= __heroStartHref %>" data-funnel="services_cta" class="sv3-btn sv3-btn--hero"><%= tt('svc3.cta.start', 'Start your request', 'ابدأ طلبك') %><% if (__heroMin) { %> <span>· <%= __fromChip(__heroMin, false) %></span><% } %></a>
      <a href="#sv3-report" class="sv3-btn sv3-btn--ghost"><%= tt('svc3.hero.see_report', 'See what the report looks like', 'شوف شكل التقرير') %></a>
     </div>
     <%- include('partials/urgent-window-note', {}) %>
    </div>
   </div>
  </section>

  <%# ── TRUST ───────────────────────────────────────────────────────── %>
  <div class="sv3-trust">
   <div class="sv3-tile"><span class="sv3-ic" style="width:42px;height:42px;background:#E3F3F0"><%- svg(I.steth, '#0B6B5F') %></span><div><b><%= __liveSpecs.length %></b><small><%= tt('svc3.trust.specs', 'specialties open now', 'تخصصات متاحة') %></small></div></div>
   <div class="sv3-tile"><span class="sv3-ic" style="width:42px;height:42px;background:#EDEFFC"><%- svg(I.file, '#4C5FD5') %></span><div><b><%= __bookableCount %></b><small><%= tt('svc3.trust.types', 'report types', 'نوع تقرير') %></small></div></div>
   <div class="sv3-tile"><span class="sv3-ic" style="width:42px;height:42px;background:#FDEFE3"><%- svg(I.bed, '#D9661F') %></span><div><b>220</b><small><%= tt('svc3.trust.beds', 'hospital beds', 'سرير في المستشفى') %></small></div></div>
   <div class="sv3-tile"><span class="sv3-ic" style="width:42px;height:42px;background:#FFF5D9"><%- svg(I.shield, '#B07800') %></span><div><b>GAHAR</b><small><%= tt('svc3.trust.gahar', 'accredited', 'اعتماد') %></small></div></div>
  </div>

  <%# ── SPEEDS ──────────────────────────────────────────────────────── %>
  <section class="sv3-sec" aria-labelledby="sv3-speeds">
   <h2 class="sv3-h2" id="sv3-speeds"><%= tt('svc3.speed.title', 'Choose the speed that suits you', 'اختار السرعة اللي تناسبك') %></h2>
   <div class="sv3-speeds">
    <div class="sv3-speed" style="background:#E3F3F0"><div class="k" style="color:#0B6B5F">STANDARD</div><div class="v">48</div><div class="u"><%= tt('svc3.unit.hours', 'hours', 'ساعة') %></div></div>
    <div class="sv3-speed" style="background:#EDEFFC"><div class="k" style="color:#4C5FD5">VIP</div><div class="v">18</div><div class="u"><%= tt('svc3.unit.hours', 'hours', 'ساعة') %></div></div>
    <div class="sv3-speed" style="background:#FDEFE3"><div class="k" style="color:#B5541A">URGENT</div><div class="v">4</div><div class="u"><%= tt('svc3.unit.hours4', 'hours', 'ساعات') %></div></div>
   </div>
   <p class="sv3-note"><%= tt('svc3.speed.note',
     'Prices below are Standard. VIP and Urgent add a priority fee. Radiology is Standard and VIP only.',
     'الأسعار تحت لسرعة Standard، وفي رسوم أولوية إضافية على VIP والعاجل. الأشعة متاحة Standard وVIP بس.') %></p>
  </section>

  <%# ── SPECIALTY TILES ─────────────────────────────────────────────── %>
  <section class="sv3-sec" aria-labelledby="sv3-specs">
   <div class="sv3-h2-row">
    <h2 class="sv3-h2" id="sv3-specs"><%= tt('svc3.specs.title', 'Choose your specialty', 'اختار تخصصك') %></h2>
    <span class="sv3-meta"><%= __isAr ? (__liveSpecs.length + ' تخصصات · ' + __bookableCount + ' نوع تقرير') : (__liveSpecs.length + ' specialties · ' + __bookableCount + ' report types') %></span>
   </div>
   <div class="sv3-specs">
    <% __liveSpecs.forEach(function (sp) { const k = skin(sp); const n = __listFor(sp).length; %>
    <a class="sv3-spec" href="#<%= sectionId(sp) %>">
     <span class="sv3-ic" style="width:42px;height:42px;background:<%= k.t %>"><%- svg(k.i, k.c) %></span>
     <span class="n"><%= specDisplayName(sp) %></span>
     <span class="s"><%= typesTxt(n) %><% if (__fromPrice[sp]) { %> · <%= fromTxt(__fromPrice[sp]) %><% } %></span>
    </a>
    <% }); %>
   </div>
   <div class="sv3-help">
    <span class="sv3-ic" style="width:40px;height:40px;background:#fff"><%- svg(I.bulb, '#C98A00') %></span>
    <div>
     <h3><%= tt('svc3.help.title', 'Not sure which to pick?', 'مش عارف تختار؟') %></h3>
     <p><%= tt('svc3.help.body', 'Tell us what you have and we will point you to the right specialty and price before you pay.', 'قولنا معاك إيه، وإحنا نحدد التخصص ونأكد معاك السعر قبل الدفع.') %></p>
     <a href="<%= __lpx %>/help-me-choose" data-funnel="services_help"><%= tt('svc3.help.cta', 'Help me choose →', 'ساعدني أختار ←') %></a>
    </div>
   </div>
  </section>

  <%# ── EVERY LIVE SPECIALTY, EVERY BOOKABLE SERVICE ─────────────────── %>
  <section class="sv3-sec" aria-labelledby="sv3-prices">
   <h2 class="sv3-h2" id="sv3-prices"><%= tt('svc3.list.title', 'Every review and its price', 'كل مراجعة وسعرها') %></h2>
   <div class="sv3-cats">
   <% __liveSpecs.forEach(function (specName) {
        const k = skin(specName);
        const list = __listFor(specName);
        const head = list.slice(0, 3);
        const rest = list.slice(3);
        const __specIsLive = true;
        function row(service) { %>
     <% if (isBookable(service) && __ctaOn) { %>
     <a href="<%= bookHref('service_id=' + encodeURIComponent(service.id)) %>" class="service-card" data-funnel="services_card">
      <h3><%= svcName(service) %><% const __d = (__isAr && service.description_ar) || (!__isAr && service.description) || ''; if (__d) { %><span class="sla"><%= __d %></span><% } %></h3>
      <span class="sv3-price"><% if (__loc(service.base_price, service.id)) { %><%= __loc(service.base_price, service.id) %><% } else { %><%= __fmt(service.base_price) %> <small>EGP</small><% } %></span>
     </a>
     <% } else { %>
     <%# Bookable but held unlinked by the site-wide gate keeps its price;
         genuinely unorderable gets the Coming Soon badge. %>
     <div class="service-card service-card--static"<% if (!isBookable(service)) { %> aria-disabled="true"<% } %>>
      <h3><%= svcName(service) %><% const __d = (__isAr && service.description_ar) || (!__isAr && service.description) || ''; if (__d) { %><span class="sla"><%= __d %></span><% } %></h3>
      <% if (!isBookable(service)) { %><span class="service-soon-badge"><%= tt('svc.coming_soon', 'Coming Soon', 'قريبًا') %></span>
      <% } else { %><span class="sv3-price"><% if (__loc(service.base_price, service.id)) { %><%= __loc(service.base_price, service.id) %><% } else { %><%= __fmt(service.base_price) %> <small>EGP</small><% } %></span><% } %>
     </div>
     <% } %>
   <%   } %>
    <article class="sv3-cat" id="<%= sectionId(specName) %>">
     <div class="sv3-cat-hd" style="background:<%= k.t %>">
      <span class="sv3-ic"><%- svg(k.i, k.c, 28) %></span>
      <div>
       <h2><%= specDisplayName(specName) %></h2>
       <% if (metaDesc(specName)) { %><div class="d"><%= metaDesc(specName) %></div><% } %>
       <div class="m"><%= typesTxt(list.length) %><% if (__fromPrice[specName]) { %> · <%= fromTxt(__fromPrice[specName]) %> <%= egp %><% } %></div>
      </div>
     </div>
     <div class="sv3-rows"><% head.forEach(row); %></div>
     <% if (rest.length) { %>
     <details class="sv3-more">
      <summary><%= __isAr ? ('شوف الكل (' + list.length + ') ←') : ('Show all ' + list.length + ' →') %></summary>
      <div class="sv3-rows"><% rest.forEach(row); %></div>
     </details>
     <% } %>
     <div class="sv3-cat-ft">
      <% const __ctaLabel = __isAr ? ('احجز مراجعة ' + specDisplayName(specName)) : ('Book ' + enArticle(specDisplayName(specName)) + ' ' + specDisplayName(specName) + ' review'); %>
      <% if (__specIsLive && __ctaOn) { %>
      <a href="<%= bookHref('specialty=' + encodeURIComponent(specName)) %>" class="sv3-btn sv3-btn--teal" data-funnel="services_card"><%= __ctaLabel %></a>
      <% } else { %>
      <span class="sv3-btn sv3-btn--teal is-cta-locked" aria-disabled="true" title="<%= __ctaOffLabel %>"><%= __ctaLabel %></span>
      <% } %>
     </div>
    </article>
   <% }); %>
   </div>
   <% if (__soonSpecs.length) { %>
   <div class="sv3-soon" id="coming-soon-specialties">
    <h3><%= tt('svc.soon.title', 'More specialties are on the way', 'تخصصات تانية جاية قريب') %></h3>
    <p><%= __soonSpecs.map(specDisplayName).join(__isAr ? '، ' : ', ') %></p>
    <p><a href="<%= __lpx %>/wa" rel="nofollow"><%= tt('svc.soon.ask', 'Need one of these? Ask us on WhatsApp', 'محتاج واحد منهم؟ اسألنا على واتساب') %></a></p>
   </div>
   <% } %>
  </section>

  <div class="sv3-two">
  <%# ── STEPS ───────────────────────────────────────────────────────── %>
  <section class="sv3-sec" aria-labelledby="sv3-steps">
   <h2 class="sv3-h2" id="sv3-steps"><%= tt('svc3.steps.title', 'Four steps, all from your phone', 'أربع خطوات، كلها من موبايلك') %></h2>
   <div class="sv3-steps">
    <% [
      ['#0B6B5F', '#E3F3F0', tt('svc3.step1.t', 'Upload your file', 'ارفع ملفك'), tt('svc3.step1.d', 'Scans, lab results, reports. Photos or PDF from your phone.', 'أشعة، تحاليل، تقارير. صور أو PDF من موبايلك.')],
      ['#3B4BBD', '#EDEFFC', tt('svc3.step2.t', 'We confirm the specialty and price', 'نأكد معاك التخصص والسعر'), (__pbLocal ? tt('svc3.step2.d_intl', 'You see the full price before you pay, by card.', 'السعر بيظهر كامل قبل ما تدفع، بالبطاقة.') : tt('svc3.step2.d', 'You see the full price before you pay, by InstaPay or bank transfer.', 'السعر بيظهر كامل قبل ما تدفع، إنستاباي أو تحويل بنكي.'))],
      ['#A84D13', '#FDEFE3', tt('svc3.step3.t', 'A consultant reads and writes', 'استشاري يقرا ويكتب'), tt('svc3.step3.d', 'A consultant in the same specialty from Shifa Hospital Group.', 'استشاري في نفس التخصص من مجموعة مستشفيات شفا.')],
      ['#8A6200', '#FFF5D9', tt('svc3.step4.t', 'You receive your report', 'تستلم تقريرك'), tt('svc3.step4.d', 'In Arabic and English, with their name and signature. What happens next is your decision, with your doctor.', 'بالعربي والإنجليزي، باسمه وتوقيعه. والقرار بعد كده بتاعك مع دكتورك.')]
    ].forEach(function (s, i) { %>
