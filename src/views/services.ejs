     <span class="sv3-stamp"><%= tt('svc3.report.sample', 'Sample', 'نموذج') %></span>
    </div>
    <ul class="sv3-points">
     <% [
       tt('svc3.report.p1', 'With the consultant\'s name and signature, not AI', 'باسم الاستشاري وتوقيعه، مش ذكاء اصطناعي'),
       tt('svc3.report.p2', 'In Arabic and English, as a PDF on your phone', 'بالعربي والإنجليزي، PDF على موبايلك'),
       tt('svc3.report.p3', 'Within 48, 18 or 4 hours, depending on the speed you choose', 'في خلال 48 أو 18 أو 4 ساعات حسب اختيارك'),
