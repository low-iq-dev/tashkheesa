   <div class="sv3-report">
    <div class="sv3-paper" aria-hidden="true">
     <div class="sv3-paper-hd"><div><b><%= tt('svc3.report.paper', 'Second opinion report', 'تقرير رأي طبي ثانٍ') %></b><small>SECOND OPINION REPORT</small></div><span class="sv3-ic" style="width:30px;height:30px;border-radius:9px;background:#0B6B5F"><%- svg(I.check, '#fff', 17, 3) %></span></div>
     <div class="sv3-paper-sec"><b><%= tt('svc3.report.s1', '1 · Summary of the files you sent', '١ · ملخص الملفات المرسلة') %></b><div class="sv3-bar"></div><div class="sv3-bar" style="width:78%"></div></div>
     <div class="sv3-paper-sec"><b><%= tt('svc3.report.s2', '2 · The consultant\'s opinion', '٢ · رأي الاستشاري') %></b><div class="sv3-bar"></div><div class="sv3-bar" style="width:86%"></div><div class="sv3-bar" style="width:64%"></div></div>
     <div class="sv3-paper-sec"><b><%= tt('svc3.report.s3', '3 · Points to discuss with your doctor', '٣ · نقاط تناقشها مع طبيبك') %></b><div class="sv3-bar" style="width:70%"></div></div>
