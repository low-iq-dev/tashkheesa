     ].forEach(function (p) { %><li><span class="sv3-ic"><%- svg(I.check, '#3B4BBD', 13, 3) %></span><span><%= p %></span></li><% }); %>
    </ul>
   </div>
  </section>
  </div>

  <%# ── CONSULTANTS ─────────────────────────────────────────────────── %>
