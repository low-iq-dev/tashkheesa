   </div>
  </section>
  <p class="sv3-disclaimer"><%= tt('svc3.disclaimer', 'Tashkheesa provides a written second medical opinion report based on the files you send. It does not replace a medical examination or emergency care.', 'تشخيصة بتقدّم تقرير رأي طبي ثانٍ مكتوب بناءً على الملفات المرسلة. لا تغني عن الكشف الطبي ولا عن الطوارئ.') %></p>

 </div>
</main>

<%# FUNNEL BEACON 2026-10-02 (unchanged). A view counts once the page has been
    VISIBLE for a second; taps on tagged elements are counted too. %>
<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function () {
  var src = (location.search.match(/[?&]utm_source=([^&]+)/) || [])[1] || '';
  var camp = (location.search.match(/[?&]utm_campaign=([^&]+)/) || [])[1] || '';
  var sent = false, t = null;
  function arm() {
    if (sent || document.visibilityState !== 'visible') return;
    clearTimeout(t);
    t = setTimeout(function () {
      if (sent || document.visibilityState !== 'visible') return;
      sent = true;
      try { fetch('/f/e?s=services_view' + (src ? '&src=' + encodeURIComponent(src) : '') + (camp ? '&c=' + encodeURIComponent(camp) : ''), { keepalive: true, credentials: 'same-origin' }); } catch (e) {}
    }, 1000);
  }
  document.addEventListener('visibilitychange', arm);
  arm();
  Array.prototype.forEach.call(document.querySelectorAll('[data-funnel]'), function (a) {
    a.addEventListener('click', function () {
      try { fetch('/f/e?s=' + encodeURIComponent(a.getAttribute('data-funnel')), { keepalive: true, credentials: 'same-origin' }); } catch (e) {}
    });
  });
})();
</script>

