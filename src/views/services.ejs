   <% } %>
   <div class="sv3-priv">
    <div style="background:#EDEFFC"><%- svg(I.lock, '#3B4BBD') %><h3><%= tt('svc3.priv1.t', 'Your files are private', 'ملفاتك سرية') %></h3><p><%= tt('svc3.priv1.d', 'Seen only by the medical team handling your request.', 'بيشوفها الفريق الطبي المختص بطلبك بس.') %></p></div>
    <div style="background:#E3F3F0"><%- svg(I.info, '#0B6B5F') %><h3><%= tt('svc3.priv2.t', 'A written opinion', 'رأي مكتوب') %></h3><p><%= tt('svc3.priv2.d', 'Not a substitute for an examination or emergency care.', 'مش بديل عن الكشف ولا عن الطوارئ.') %></p></div>
   </div>
