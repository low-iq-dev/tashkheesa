<%- include('partials/header', { title: tt('lp.page_title', 'A written second opinion in 48 hours', 'رأي طبي تاني مكتوب في 48 ساعة'), layout: 'public', showNav: true }) %>
<%
  // /start and /ar/start — the paid-ads landing page (26 Sep 2026).
  // One promise, one action. The ads used to land on /services, a 21k-px
  // catalogue with 128 "Coming soon" cards; this page says what you get, who
  // reviews it, what it costs, and offers exactly two ways forward.
  const __isAr = !!(typeof isAr !== 'undefined' && isAr);
  const __ctaOn = (typeof bookingCtaEnabled !== 'undefined') ? !!bookingCtaEnabled : false;
  const __loggedIn = !!(typeof user !== 'undefined' && user && user.id);
  const __lp = (typeof langParam !== 'undefined' && langParam) ? langParam : (__isAr ? 'lang=ar' : '');
  const __target = '/patient/new-case';
  let __startHref = __loggedIn ? __target : '/register?next=' + encodeURIComponent(__target);
  if (__lp) __startHref += (__startHref.indexOf('?') === -1 ? '?' : '&') + __lp;
  const __min = (typeof minPrice !== 'undefined' && minPrice) ? Number(minPrice).toLocaleString('en-GB') : '1,600';
  const __wa = 'https://wa.me/201102009886?text=' + encodeURIComponent(__isAr
    ? 'مرحباً تشخيصة 👋 عندي تقرير/أشعة ومحتاج رأي تاني'
    : 'Hi Tashkheesa 👋 I have a report/scan and would like a second opinion');
  const DOCS = [
    { img: '/assets/landing/dr-hassan-khaled.jpg', en: 'Dr Hassan Khaled', ar: 'د. حسن خالد', specEn: 'Obstetrics & Gynecology', specAr: 'النسا والتوليد' },
    { img: '/assets/landing/dr-nancy-ghoneim.jpg', en: 'Dr Nancy Ghoneim', ar: 'د. نانسي غنيم', specEn: 'Internal Medicine', specAr: 'الباطنة' },
    { img: '/assets/landing/dr-mohammed-jamaleddin.jpg', en: 'Dr Mohammed Jamaleddin', ar: 'د. محمد جمال الدين', specEn: 'Orthopedics', specAr: 'العظام' }
  ];
%>
<style>
.lp { --teal:#0F4C5C; --teal-2:#15667a; --brass:#B8893B; --cream:#FAF6EE; --ink:#16272c; --muted:#5d6b6f;
  color: var(--ink); background: var(--cream); }
.lp *{ box-sizing:border-box; }
.lp-wrap{ max-width:1080px; margin:0 auto; padding:0 20px; }
.lp-hero{ background:linear-gradient(160deg,var(--teal) 0%,#0b3b47 100%); color:#fff; padding:56px 0 64px; }
.lp-hero__grid{ display:grid; grid-template-columns:1.1fr .9fr; gap:40px; align-items:center; }
.lp-kicker{ display:inline-block; font-size:13px; font-weight:700; color:#f1d9a6; background:rgba(184,137,59,.18);
  border:1px solid rgba(241,217,166,.35); padding:6px 12px; border-radius:999px; margin-bottom:18px; }
.lp h1{ font-size:clamp(30px,4.6vw,46px); line-height:1.18; margin:0 0 16px; font-weight:800; color:#fff; }
.lp-sub{ font-size:18px; line-height:1.65; color:#d9e7e9; margin:0 0 22px; max-width:560px; }
.lp-price{ display:flex; gap:18px; flex-wrap:wrap; margin:0 0 26px; font-size:15px; color:#eaf2f3; }
.lp-price b{ color:#fff; font-size:22px; }
.lp-ctas{ display:flex; gap:12px; flex-wrap:wrap; }
.lp-btn{ display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:52px; padding:0 26px; border-radius:12px;
  font-weight:700; font-size:17px; text-decoration:none; transition:transform .15s, box-shadow .15s; }
.lp-btn--primary{ background:var(--brass); color:#fff; box-shadow:0 8px 22px rgba(184,137,59,.35); }
.lp-btn--primary:hover{ transform:translateY(-1px); }
.lp-btn--wa{ background:#fff; color:#128C7E; }
.lp-btn--locked{ background:#cfd8da; color:#5d6b6f; cursor:not-allowed; box-shadow:none; }
.lp-hero__img{ border-radius:18px; overflow:hidden; box-shadow:0 24px 60px rgba(0,0,0,.35); background:#0b3b47; }
.lp-hero__img img{ display:block; width:100%; height:auto; }
.lp-hero__cap{ font-size:13px; color:#b9cfd3; margin-top:10px; text-align:center; }
.lp-report{ background:#fff; color:var(--ink); border-radius:18px; padding:22px 22px 18px; box-shadow:0 24px 60px rgba(0,0,0,.35); }
.lp-report__h{ display:flex; justify-content:space-between; align-items:center; gap:10px; font-weight:800; font-size:17px; color:var(--teal); }
.lp-report__tag{ font-size:11px; font-weight:700; color:var(--brass); border:1px solid var(--brass); border-radius:999px; padding:2px 10px; }
.lp-report__meta{ color:var(--muted); font-size:13px; margin:4px 0 14px; }
.lp-report__q{ background:#f4f7f7; border-radius:10px; padding:10px 12px; font-size:14px; line-height:1.55; margin-bottom:12px; }
.lp-report__f{ margin:0 0 12px; padding-inline-start:20px; font-size:14px; line-height:1.8; }
.lp-report__rec{ border-inline-start:3px solid var(--brass); padding:4px 12px; font-size:14px; line-height:1.6; margin-bottom:12px; }
.lp-report__sig{ font-size:12.5px; color:var(--teal); font-weight:700; border-top:1px dashed #e3dccd; padding-top:10px; }
.lp-sec{ padding:56px 0; }
.lp-sec h2{ font-size:clamp(24px,3vw,32px); margin:0 0 10px; text-align:center; color:var(--teal); }
.lp-sec__sub{ text-align:center; color:var(--muted); margin:0 auto 34px; max-width:620px; line-height:1.6; }
.lp-steps{ display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
.lp-step{ background:#fff; border-radius:16px; padding:24px; border:1px solid #eee4d3; }
.lp-step__n{ width:36px; height:36px; border-radius:50%; background:var(--teal); color:#fff; font-weight:800;
  display:flex; align-items:center; justify-content:center; margin-bottom:12px; }
.lp-step h3{ margin:0 0 6px; font-size:18px; }
.lp-step p{ margin:0; color:var(--muted); line-height:1.6; font-size:15px; }
.lp-docs{ display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
.lp-doc{ background:#fff; border-radius:16px; overflow:hidden; border:1px solid #eee4d3; text-align:center; }
.lp-doc img{ display:block; width:100%; aspect-ratio:4/5; object-fit:cover; background:#eef0f0; }
.lp-doc__b{ padding:14px 12px 18px; }
.lp-doc__n{ font-weight:800; font-size:17px; margin:0 0 2px; }
.lp-doc__s{ color:var(--brass); font-weight:700; font-size:14px; margin:0; }
.lp-trust{ display:grid; grid-template-columns:repeat(2,1fr); gap:14px; max-width:860px; margin:0 auto; }
.lp-trust div{ background:#fff; border-radius:14px; padding:16px 18px; border:1px solid #eee4d3; line-height:1.55; font-size:15px; }
.lp-trust b{ color:var(--teal); display:block; margin-bottom:2px; }
.lp-final{ background:var(--teal); color:#fff; text-align:center; padding:48px 0 56px; }
.lp-final h2{ color:#fff; }
.lp-final p{ color:#d9e7e9; margin:0 0 22px; }
.lp-final .lp-ctas{ justify-content:center; }
@media (max-width:820px){
  .lp-hero{ padding:36px 0 44px; }
  .lp-hero__grid{ grid-template-columns:1fr; gap:28px; }
  .lp-steps,.lp-docs{ grid-template-columns:1fr; }
  .lp-docs{ grid-template-columns:repeat(3,1fr); gap:10px; }
  .lp-doc__n{ font-size:14px; } .lp-doc__s{ font-size:12px; }
  .lp-trust{ grid-template-columns:1fr; }
  .lp-btn{ width:100%; }
}
</style>

<main class="lp" dir="<%= __isAr ? 'rtl' : 'ltr' %>">
  <section class="lp-hero">
    <div class="lp-wrap lp-hero__grid">
      <div>
        <span class="lp-kicker"><%= __isAr ? 'استشاريين مجموعة مستشفيات شفا · القاهرة الجديدة' : 'Shifa Hospital Group consultants · New Cairo' %></span>
        <%# LEAN HERO 2026-10-01: ~0.5% of paid visitors tapped Start with the
            four-line hero. One line of promise, the price, one button. %>
        <h1><%= __isAr ? 'رأي طبي تاني مكتوب — خلال 48 ساعة' : 'A written second opinion — in 48 hours' %></h1>
        <p class="lp-sub"><%= __isAr
          ? 'ارفع تقريرك أو أشعتك، واستشاري من مجموعة مستشفيات شفا يبعتلك رأيه مكتوب.'
          : 'Upload your report or scan; a Shifa Hospital Group consultant sends you a written opinion.' %></p>
        <div class="lp-price">
          <span><%= __isAr ? 'تبدأ من' : 'From' %> <b><%= __min %> <%= __isAr ? 'ج.م' : 'EGP' %></b></span>
          <span><b>48</b> <%= __isAr ? 'ساعة للرد' : 'hours to your report' %></span>
        </div>
        <div class="lp-ctas">
          <% if (__ctaOn) { %>
          <a class="lp-btn lp-btn--primary" href="<%= __startHref %>" data-track="lp_start" data-funnel="start_cta"><%= __isAr ? 'ابدأ حالتك' : 'Start my case' %></a>
          <% } else { %>
          <span class="lp-btn lp-btn--locked is-cta-locked" aria-disabled="true"><%= __isAr ? 'الحجز هيفتح قريب' : 'Booking opens soon' %></span>
          <% } %>
          <a class="lp-btn lp-btn--wa" href="<%= __wa %>" target="_blank" rel="noopener" data-track="lp_whatsapp" data-funnel="start_wa">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0012 0C5.4 0 .1 5.3.1 11.9c0 2.1.6 4.1 1.6 5.9L0 24l6.3-1.7a11.9 11.9 0 005.7 1.5c6.6 0 11.9-5.3 11.9-11.9 0-3.2-1.2-6.2-3.4-8.4zM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4a9.9 9.9 0 01-1.5-5.3C2.2 6.5 6.6 2.1 12 2.1c2.6 0 5.1 1 7 2.9a9.8 9.8 0 012.9 7c0 5.4-4.4 9.8-9.9 9.8zm5.4-7.4c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1-.8 1-.9 1.2-.3.2-.6.1a8.1 8.1 0 01-4-3.5c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.5 1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5 1.9.8 2.6.9 3.6.7.6-.1 1.8-.7 2-1.4s.2-1.3.2-1.4c-.1-.2-.3-.3-.6-.4z"/></svg>
            <%= __isAr ? 'اسألنا على واتساب' : 'Ask us on WhatsApp' %></a>
        </div>
        <p style="margin:12px 0 0;font-size:14px;color:#b9cfd3;"><%= __isAr ? 'خطوة واحدة: اسمك ورقم الواتساب — وبعدها ترفع ملفاتك.' : 'One step: your name and WhatsApp number — then upload your files.' %></p>
      </div>
      <div>
        <%# A written-report mock, not a photo: the old hero image was a video
            call, which contradicted "no appointments". Clearly labelled as an
            example; no real doctor's name on invented content. %>
        <div class="lp-report" aria-label="<%= __isAr ? 'مثال لتقرير' : 'Example report' %>">
          <div class="lp-report__h">
            <span><%= __isAr ? 'تقرير الرأي الطبي التاني' : 'Second-opinion report' %></span>
            <span class="lp-report__tag"><%= __isAr ? 'مثال' : 'Example' %></span>
          </div>
          <div class="lp-report__meta"><%= __isAr ? 'رنين مغناطيسي على الركبة اليمين · ٣ ملاحظات' : 'Knee MRI · Right knee · 3 findings' %></div>
          <div class="lp-report__q"><b><%= __isAr ? 'سؤالك:' : 'Your question:' %></b> <%= __isAr ? 'الدكتور قال محتاج منظار. هل ده ضروري دلوقتي؟' : 'My doctor says I need arthroscopy. Is it necessary now?' %></div>
          <ol class="lp-report__f">
            <li><%= __isAr ? 'سائل بسيط في المفصل' : 'Small joint effusion' %></li>
            <li><%= __isAr ? 'قطع صغير في الغضروف الهلالي الداخلي' : 'Small medial meniscus tear, posterior horn' %></li>
            <li><%= __isAr ? 'الأربطة الصليبية سليمة' : 'ACL and PCL intact' %></li>
          </ol>
          <div class="lp-report__rec"><b><%= __isAr ? 'رأي الاستشاري:' : 'Consultant’s opinion:' %></b> <%= __isAr ? 'القطع صغير ومستقر. ابدأ بعلاج طبيعي ٦ أسابيع، والمنظار لو الركبة بتقفل أو الألم مستمر.' : 'The tear is small and stable. Start 6 weeks of physiotherapy; arthroscopy only if the knee locks or pain persists.' %></div>
          <div class="lp-report__sig">✓ <%= __isAr ? 'موقّع من استشاري العظام · مجموعة مستشفيات شفا' : 'Signed by the orthopedic consultant · Shifa Hospital Group' %></div>
        </div>
      </div>
    </div>
  </section>

  <section class="lp-sec">
    <div class="lp-wrap">
      <h2><%= __isAr ? 'إزاي بتشتغل' : 'How it works' %></h2>
      <p class="lp-sec__sub"><%= __isAr ? 'من غير مواعيد ولا مشاوير.' : 'No appointments, no trips.' %></p>
      <div class="lp-steps">
        <div class="lp-step"><div class="lp-step__n">1</div><h3><%= __isAr ? 'ارفع ملفاتك' : 'Upload your files' %></h3><p><%= __isAr ? 'صور التقرير أو الأشعة أو التحاليل، واكتب سؤالك للدكتور.' : 'Photos of the report, scan or labs, plus your question for the doctor.' %></p></div>
        <div class="lp-step"><div class="lp-step__n">2</div><h3><%= __isAr ? 'استشاري يراجعها' : 'A consultant reviews' %></h3><p><%= __isAr ? 'استشاري في نفس التخصص من مجموعة مستشفيات شفا يقرا حالتك كاملة.' : 'A Shifa Hospital Group consultant in the right specialty reads your whole case.' %></p></div>
        <div class="lp-step"><div class="lp-step__n">3</div><h3><%= __isAr ? 'رأي مكتوب في 48 ساعة' : 'Written opinion in 48h' %></h3><p><%= __isAr ? 'تقرير بالعربي يجاوب سؤالك ويقولك الخطوة الجاية.' : 'A report that answers your question and tells you the next step.' %></p></div>
      </div>
    </div>
  </section>

  <section class="lp-sec" style="padding-top:0;">
    <div class="lp-wrap">
      <h2><%= __isAr ? 'استشاريين حقيقيين، بأسمائهم' : 'Real consultants, by name' %></h2>
      <p class="lp-sec__sub"><%= __isAr ? 'مفيش مراجعين مجهولين. اسم الاستشاري بيكون على تقريرك.' : 'No anonymous reviewers. Your consultant’s name is on your report.' %></p>
      <div class="lp-docs">
        <% DOCS.forEach(function(d) { %>
        <div class="lp-doc">
          <img src="<%= d.img %>" width="480" height="600" loading="lazy" alt="<%= __isAr ? d.ar : d.en %>">
          <div class="lp-doc__b"><p class="lp-doc__n"><%= __isAr ? d.ar : d.en %></p><p class="lp-doc__s"><%= __isAr ? d.specAr : d.specEn %></p></div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="lp-sec" style="padding-top:0;">
    <div class="lp-wrap">
      <div class="lp-trust">
        <div><b><%= __isAr ? 'مجموعة مستشفيات شفا' : 'Shifa Hospital Group' %></b><%= __isAr ? 'مجموعة مستشفيات معتمدة من GAHAR في القاهرة الجديدة.' : 'A GAHAR-accredited hospital group in New Cairo.' %></div>
        <div><b><%= __isAr ? 'فلوسك مضمونة' : 'Your money is safe' %></b><%= __isAr ? 'لو مفيش استشاري قبل حالتك، بترجعلك فلوسك كاملة.' : 'If no consultant has accepted your case, you get a full refund.' %></div>
        <div><b><%= __isAr ? 'خصوصية تامة' : 'Private' %></b><%= __isAr ? 'ملفاتك مشفّرة ومحدش بيشوفها غير الاستشاري بتاعك.' : 'Your files are encrypted and seen only by your consultant.' %></div>
        <div><b><%= __isAr ? 'الدفع سهل' : 'Easy payment' %></b><%= __isAr ? 'تدفع بإنستاباي أو تحويل بنكي بعد ما تجهز حالتك.' : 'Pay by InstaPay or bank transfer once your case is ready.' %></div>
      </div>
    </div>
  </section>

  <section class="lp-final">
    <div class="lp-wrap">
      <h2><%= __isAr ? 'خد رأي تاني قبل ما تقرر' : 'Get a second opinion before you decide' %></h2>
      <p><%= __isAr ? ('تبدأ من ' + __min + ' ج.م · رد خلال 48 ساعة') : ('From EGP ' + __min + ' · reply within 48 hours') %></p>
      <div class="lp-ctas">
        <% if (__ctaOn) { %>
        <a class="lp-btn lp-btn--primary" href="<%= __startHref %>" data-track="lp_start_bottom" data-funnel="start_cta"><%= __isAr ? 'ابدأ حالتك' : 'Start my case' %></a>
        <% } else { %>
        <span class="lp-btn lp-btn--locked is-cta-locked" aria-disabled="true"><%= __isAr ? 'الحجز هيفتح قريب' : 'Booking opens soon' %></span>
        <% } %>
        <a class="lp-btn lp-btn--wa" href="<%= __wa %>" target="_blank" rel="noopener" data-track="lp_whatsapp_bottom" data-funnel="start_wa"><%= __isAr ? 'اسألنا على واتساب' : 'Ask us on WhatsApp' %></a>
      </div>
    </div>
  </section>
</main>

<%# FUNNEL BEACON 2026-10-01. The server-side GET counter was inflated by Meta's
    in-app browser preloading the page before anyone saw it (~2,500 "views" a
    day, more than Meta's own landing-page views). A view now counts only once
    the page has been VISIBLE for a second; CTA taps are counted too. %>
<script nonce="<%= (typeof cspNonce !== 'undefined' && cspNonce) ? cspNonce : '' %>">
(function () {
  var src = (location.search.match(/[?&]utm_source=([^&]+)/) || [])[1] || '';
  var camp = (location.search.match(/[?&]utm_campaign=([^&]+)/) || [])[1] || '';
  function hit(step) {
    try { fetch('/f/e?s=' + encodeURIComponent(step) + (src ? '&src=' + encodeURIComponent(src) : '') + (camp ? '&c=' + encodeURIComponent(camp) : ''), { keepalive: true, credentials: 'same-origin' }); } catch (e) {}
  }
  var sent = false, t = null;
  function arm() {
    if (sent || document.visibilityState !== 'visible') return;
    clearTimeout(t);
    t = setTimeout(function () { if (!sent && document.visibilityState === 'visible') { sent = true; hit('start_view'); } }, 1000);
  }
  document.addEventListener('visibilitychange', arm);
  arm();
  Array.prototype.forEach.call(document.querySelectorAll('[data-funnel]'), function (a) {
    a.addEventListener('click', function () { hit(a.getAttribute('data-funnel')); });
  });
})();
</script>

<%- include('partials/footer') %>
