<%- include('partials/header', { title: (typeof isAr !== 'undefined' && isAr) ? 'خدماتي' : 'My Services', layout: 'portal', showNav: true, portalFrame: true, portalRole: 'doctor', portalActive: 'services', portalNext: '/portal/doctor/services' }) %>
<%
  var _isAr = (typeof isAr !== 'undefined') ? !!isAr : false;
  var _groups = Array.isArray(typeof groups !== 'undefined' ? groups : []) ? groups : [];
  var _isEmpty = (typeof isEmpty !== 'undefined') ? !!isEmpty : (_groups.length === 0);
  var _subs = Array.isArray(typeof subSpecialties !== 'undefined' ? subSpecialties : []) ? subSpecialties : [];
  var _specName = (_isAr && typeof specialtyNameAr !== 'undefined' && specialtyNameAr) ? specialtyNameAr
                : (typeof specialtyName !== 'undefined' && specialtyName) ? specialtyName : '';
  var _error = (typeof error !== 'undefined' && error) ? String(error) : '';
  var _warning = (typeof warning !== 'undefined' && warning) ? String(warning) : '';
  var _success = (typeof success !== 'undefined' && success) ? String(success) : '';
  function _money(n) {
    var v = Number(n);
    if (!Number.isFinite(v)) return '';
    return v.toLocaleString(_isAr ? 'ar-EG' : 'en-US');
  }
  function _groupHeading(g) {
    if (_isAr && g.specialtyNameAr) return g.specialtyNameAr;
    return g.specialtyName || (_isAr ? 'خدمات' : 'Services');
  }
%>
<%- include('partials/doctor/topbar', {
  isAr: _isAr,
  topbarTitle: tt('My Services', 'My Services', 'خدماتي'),
  topbarSub: tt('Confirm the services you accept', 'Confirm the services you accept', 'أكد الخدمات التي تقبلها'),
  topbarShowSearch: false
}) %>

<%# ── What this page is asking for (2026-08-25) ──────────────────────────
  Every invited doctor lands here first (services/doctor_landing.js), and
  until now the page gave them no framing at all: two separate forms, each
  with its own Save, both pre-filled by migrations 089 and 092, and nothing
  saying so. A doctor who does not know the boxes were filled in for them
  reads a pre-ticked list as a claim someone else made about their practice,
  which is the opposite of the confirmation we are asking for.

  Shown only while something is still unconfirmed, so it disappears once the
  doctor is done rather than nagging them on every later visit. %>
<%# req.user is the JWT payload and carries no onboarding_complete, so this
    comes from the route, which reads it alongside the tier state. %>
<% var _svcUnconfirmed = (typeof servicesUnconfirmed !== 'undefined') ? !!servicesUnconfirmed : false;
   var _tiersNeedConfirm = (typeof tiersUnconfirmed !== 'undefined' && tiersUnconfirmed); %>
<%# Gated on !_isEmpty as well: the empty-catalogue branch below has no service
    list and no second Save button, so on that page this would promise a list
    that is not there and point at a button that does not exist. That is the
    three Pediatrics doctors, whose specialty has no service rows at all. %>
<% if (!_isEmpty && (_svcUnconfirmed || _tiersNeedConfirm)) { %>
  <div class="v2-card" style="border-inline-start:3px solid var(--v2-brand);margin-block-end:12px;">
    <div class="v2-card__body">
      <div style="font:600 14px/1.5 inherit;margin-block-end:6px;color:var(--v2-brand-dk, #0b6b5f);">
        <%= tt('We have filled this in for you — please check it', 'We have filled this in for you — please check it', 'جهزناها لك — كل المطلوب مراجعتها') %>
      </div>
      <div style="font-size:13px;line-height:1.7;color:var(--v2-muted);">
        <%= tt(
          'Your turnaround speeds and every service in your specialty are already ticked below, from your specialty on file. Until you confirm them, cases cannot be routed to you and our team cannot assign you one by hand. There are two things to save on this page and each has its own button — the speeds at the top, your services at the bottom. Untick anything you would rather not take.',
          'Your turnaround speeds and every service in your specialty are already ticked below, from your specialty on file. Until you confirm them, cases cannot be routed to you and our team cannot assign you one by hand. There are two things to save on this page and each has its own button — the speeds at the top, your services at the bottom. Untick anything you would rather not take.',
          'سرعات التسليم وكل خدمات تخصصك محددة لك بالفعل بالأسفل، حسب التخصص المسجل باسمك. وحتى تؤكدها، لا يمكن توجيه الحالات إليك ولا يستطيع فريقنا إسنادها إليك يدوياً. في حاجتين محتاجين حفظ في الصفحة دي ولكل واحدة زرار خاص بها — السرعات في الأعلى، والخدمات في الأسفل. الغِ تحديد أي خدمة لا ترغب في استقبالها.'
        ) %>
      </div>
    </div>
  </div>
<% } %>

<% if (_error) { %>
  <div class="v2-card" style="border-color:#c0392b;margin-block-end:12px;"><div class="v2-card__body" style="color:#c0392b;"><%= _error %></div></div>
<% } %>
<% if (_warning) { %>
  <div class="v2-card" style="border-color:var(--v2-brass, #b8860b);margin-block-end:12px;"><div class="v2-card__body"><%= _warning %></div></div>
<% } %>
<% if (_success) { %>
  <div class="v2-card" style="border-color:var(--v2-brand);margin-block-end:12px;"><div class="v2-card__body" style="color:var(--v2-brand-dk, #0b6b5f);"><%= _success %></div></div>
<% } %>

    <%# ── Turnaround speeds (2026-08-24) ────────────────────────────────────
      The control doctors never had. These three checkboxes existed only on
      the signup form, with Standard pre-ticked, and nothing in the portal
      could change them afterwards — so 25 of 31 doctors were listed for
      Standard alone by default rather than by choice, and VIP and Urgent had
      one doctor between them platform-wide.

      It lives on the services page rather than the profile because it is the
      same question the rest of this page asks: what work will you take. And
      the tier chosen decides the deadline, so it belongs beside the services
      whose SLA hours are listed right below.

      Saving stamps users.sla_tiers_confirmed_at, which dismisses the banner
      — whatever they choose. Confirming is the point, not the answer. %>
  <form method="post" action="/portal/doctor/turnaround">
  <%- (typeof csrfField === 'function') ? csrfField() : '' %>
  <input type="hidden" name="tier_form" value="1" />
  <div class="v2-card" id="turnaround" style="margin-block-end:12px;<% if (typeof tiersUnconfirmed !== 'undefined' && tiersUnconfirmed) { %>border-inline-start:3px solid var(--v2-brand);<% } %>">
    <div class="v2-card__header">
      <div class="v2-card__title"><%= tt('Turnaround speeds you accept', 'Turnaround speeds you accept', 'سرعات التسليم التي تقبلها') %></div>
      <% if (typeof tiersUnconfirmed !== 'undefined' && tiersUnconfirmed) { %>
        <span class="v2-pill v2-pill--teal"><%= tt('Needs your confirmation', 'Needs your confirmation', 'بحاجة لتأكيدك') %></span>
      <% } %>
    </div>
    <div class="v2-card__body v2-card__body--flush">
      <% var _tiers = (typeof slaTiers !== 'undefined' && Array.isArray(slaTiers)) ? slaTiers : ['standard'];
         function _hasTier(t) { return _tiers.indexOf(t) !== -1; }
         var _tierRows = [
           { id: 'standard', label: tt('Standard', 'Standard', 'قياسي'),  hours: 48, pill: 'neutral',
             note: tt('48 hours from the moment you accept.', '48 hours from the moment you accept.', '٤٨ ساعة من لحظة قبولك للحالة.') },
           { id: 'vip',      label: tt('VIP', 'VIP', 'VIP'),             hours: 18, pill: 'brass',
             note: tt('18 hours. The patient pays a surcharge, which is refunded if the deadline is missed.', '18 hours. The patient pays a surcharge, which is refunded if the deadline is missed.', '١٨ ساعة. يدفع المريض رسوماً إضافية تُرد إذا تأخر التسليم.') },
           { id: 'urgent',   label: tt('Urgent', 'Urgent', 'عاجل'),       hours: 4,  pill: 'red',
             note: tt('4 hours, 7am–7pm Cairo time. Only tick this if you can genuinely turn a case round same-day.', '4 hours, 7am–7pm Cairo time. Only tick this if you can genuinely turn a case round same-day.', '٤ ساعات، من ٧ صباحاً حتى ٧ مساءً بتوقيت القاهرة. اختر هذا فقط إذا كان بإمكانك فعلاً إنجاز الحالة في نفس اليوم.') }
         ];
      %>
      <% _tierRows.forEach(function(t){ %>
        <label class="v2-check-row">
          <input type="checkbox" class="v2-check-row__box" name="sla_tiers" value="<%= t.id %>" <%= _hasTier(t.id) ? 'checked' : '' %> />
          <span class="v2-check-row__main">
            <span class="v2-check-row__name">
              <span class="v2-pill v2-pill--<%= t.pill %>"><span class="v2-pill__dot"></span><%= t.label %></span>
              <strong style="margin-inline-start:8px;" data-numeric><%= t.hours %><%= _isAr ? ' ساعة' : 'h' %></strong>
            </span>
            <span class="v2-check-row__meta"><%= t.note %></span>
          </span>
        </label>
      <% }); %>
    </div>
    <div class="v2-card__body" style="border-block-start:1px solid var(--v2-rule);font-size:12px;color:var(--v2-muted);line-height:1.55;">
      <%= tt('Unticking a speed only stops new cases at that speed reaching you — it never affects a case you have already accepted. You can change this whenever you like.', 'Unticking a speed only stops new cases at that speed reaching you — it never affects a case you have already accepted. You can change this whenever you like.', 'إلغاء اختيار سرعة يمنع فقط وصول حالات جديدة بتلك السرعة إليك، ولا يؤثر إطلاقاً على حالة قبلتها بالفعل. يمكنك تغيير هذا في أي وقت.') %>
    </div>
    <div class="v2-card__body" style="border-block-start:1px solid var(--v2-rule);display:flex;justify-content:flex-end;">
      <button type="submit" class="v2-btn v2-btn--primary v2-btn--sm"><%= tt('Save turnaround speeds', 'Save turnaround speeds', 'حفظ سرعات التسليم') %></button>
    </div>
  </div>
</form>

<% if (_isEmpty) { %>
  <div class="v2-card">
    <div class="v2-card__body--flush">
      <div class="v2-empty">
        <div class="v2-empty__title"><%= tt('Your services are being finalised', 'Your services are being finalised', 'يتم تجهيز خدماتك') %></div>
        <div class="v2-empty__msg"><%= tt("The services for your specialty are being set up. You'll be notified when they're ready.", "The services for your specialty are being set up. You'll be notified when they're ready.", 'يتم إعداد خدمات تخصصك حالياً. سيتم إشعارك عند جاهزيتها.') %></div>
        <div class="v2-empty__actions">
          <a class="v2-btn v2-btn--secondary" href="/portal/doctor/today"><%= tt('Back to Today', 'Back to Today', 'عُد إلى اليوم') %></a>
        </div>
      </div>
    </div>
  </div>
<% } else { %>
  <% if (_subs.length) { %>
  <div class="v2-card" style="margin-block-end:12px;">
    <div class="v2-card__body">
      <div style="font-size:12px;color:var(--v2-muted);margin-block-end:6px;"><%= tt('Your sub-specialties', 'Your sub-specialties', 'تخصصاتك الدقيقة') %><% if (_specName) { %> · <%= _specName %><% } %></div>
      <div style="display:flex;flex-wrap:wrap;gap:6px;">
        <% _subs.forEach(function(s){ %><span class="v2-chip v2-chip--neutral"><%= s %></span><% }); %>
      </div>
    </div>
  </div>
  <% } %>

  <form method="post" action="/portal/doctor/services">
    <%- (typeof csrfField === 'function') ? csrfField() : '' %>

    <% _groups.forEach(function(g, _gi){ %>
      <div class="v2-card" style="margin-block-end:12px;<% if (_gi === 0 && _svcUnconfirmed) { %>border-inline-start:3px solid var(--v2-brand);<% } %>">
        <div class="v2-card__header">
          <div class="v2-card__title"><%= _groupHeading(g) %></div>
          <% if (_gi === 0 && _svcUnconfirmed) { %>
            <span class="v2-pill v2-pill--teal"><%= tt('Needs your confirmation', 'Needs your confirmation', 'بحاجة لتأكيدك') %></span>
          <% } %>
        </div>
        <div class="v2-card__body v2-card__body--flush">
          <% (g.services || []).forEach(function(s){ %>
            <label class="v2-check-row">
              <input type="checkbox" class="v2-check-row__box" name="service_ids" value="<%= s.id %>" <%= s.ticked ? 'checked' : '' %> />
              <span class="v2-check-row__main">
                <span class="v2-check-row__name"><%= s.name %><% if (s.is_visible === false) { %> <span class="v2-chip v2-chip--neutral"><%= tt('Coming Soon', 'Coming Soon', 'قريبًا') %></span><% } %></span>
                <span class="v2-check-row__meta">
                  <% if (s.base_price) { %><span data-numeric><%= tt('Patient pays', 'Patient pays', 'يدفع المريض') %> <%= _money(s.base_price) %> <%= _isAr ? 'ج.م' : 'EGP' %></span> · <% } %><span data-numeric><%= tt('You earn', 'You earn', 'تكسب') %> <%= _money(s.doctor_fee) %> <%= _isAr ? 'ج.م' : 'EGP' %></span>
                  <% if (s.sla_hours) { %> · <span data-numeric><%= _money(s.sla_hours) %><%= _isAr ? ' س' : 'h' %> SLA</span><% } %>
                </span>
              </span>
            </label>
          <% }); %>
        </div>
      </div>
    <% }); %>

    <div class="v2-card" style="margin-block-end:12px;">
      <div class="v2-card__body">
        <label class="v2-check-row v2-check-row--plain">
          <input type="checkbox" class="v2-check-row__box" name="confirm_empty" value="1" <%= (typeof confirmEmpty !== 'undefined' && confirmEmpty) ? 'checked' : '' %> />
          <span class="v2-check-row__main">
            <span class="v2-check-row__name"><%= tt('I accept no services right now', 'I accept no services right now', 'لا أقبل أي خدمة حالياً') %></span>
            <span class="v2-check-row__meta"><%= tt('Only needed if you leave every box unticked', 'Only needed if you leave every box unticked', 'مطلوب فقط إذا تركت كل الخانات فارغة') %></span>
          </span>
        </label>
      </div>
    </div>

    <div style="display:flex;justify-content:flex-end;gap:8px;margin-block-end:24px;">
      <button type="submit" class="v2-btn v2-btn--primary"><%= tt('Save services', 'Save services', 'حفظ الخدمات') %></button>
    </div>
  </form>
<% } %>

<%- include('partials/footer') %>
