<%- include('partials/header', { title: tt('auth.register.title', 'Create Account', 'إنشاء حساب'), layout: "auth", showNav: false, showFooter: false }) %>
  <% const isAr = (typeof lang !== 'undefined' && lang === 'ar'); %>
  <% const formValues = (typeof form !== 'undefined' && form) ? form : {}; %>
  <%#
    SIGNUP-LITE 2026-10-01. Ziad: collect at least name and number — nothing
    more before the patient sees the case form. Email and password are gone
    from this page: the account is created on name + WhatsApp number, the
    patient is signed in straight away, and they come back later by phone code
    (/login → "sign in with a code"), which find-or-creates on the same number.
    Paid traffic reached this form 26+ times in three days and nobody finished
    the six-field version.
  %>
  <div class="auth-page">
    <div class="auth-card">
      <%- include('partials/auth_brand') %>
      <div class="auth-header">
        <h1><%= isAr ? 'خطوة واحدة وتبدأ' : 'One step to start' %></h1>
        <p><%= isAr ? 'اسمك ورقم الواتساب بس — وبعدها ترفع ملفاتك.' : 'Just your name and WhatsApp number — then you upload your files.' %></p>
      </div>

      <% if (error) { %>
        <div class="auth-actions" role="alert">
          <p><%= error %></p>
        </div>
      <% } %>

      <form method="post" action="/register" id="reg-form" novalidate>
        <%- (typeof csrfField === 'function') ? csrfField() : '' %>
        <% if (typeof regNext !== 'undefined' && regNext) { %>
          <input type="hidden" name="next" value="<%= regNext %>">
        <% } %>

        <div class="form-group">
          <label class="form-label" for="reg-name"><%= isAr ? 'الاسم' : 'Your name' %></label>
          <input class="form-control" type="text" id="reg-name" name="name" value="<%= formValues.name || '' %>" required autocomplete="name" />
        </div>

        <div class="form-group">
          <label class="form-label" for="reg-phone"><%= isAr ? 'رقم الواتساب' : 'WhatsApp number' %></label>
          <div style="display:flex;gap:8px;align-items:stretch;direction:ltr;">
            <select class="form-control" id="reg-country" name="country_code" required aria-label="<%= isAr ? 'الدولة' : 'Country' %>" style="flex:0 0 auto;width:auto;max-width:44%;padding-inline:10px;">
              <%- include('partials/country_options', { _selectedCountry: formValues.country_code || '', _isAr: (typeof isAr !== 'undefined' && isAr), _withDial: true }) %>
            </select>
            <%
              // 26 Oct 2026 — the placeholder follows the selected country (it
              // was always the Egyptian "01X XXXX XXXX"). Server-rendered for the
              // pre-selected country; the script below swaps it on change.
              var _regRows = (typeof COUNTRIES !== 'undefined' && COUNTRIES) ? COUNTRIES : [];
              var _regSel = String(formValues.country_code || '').toUpperCase();
              var _regRow = null;
              for (var _i = 0; _i < _regRows.length; _i++) { if (_regRows[_i].iso === _regSel) { _regRow = _regRows[_i]; break; } }
              var _regPhGeneric = isAr ? 'رقمك بدون كود الدولة' : 'Your number, without the country code';
              var _regPh = (_regRow && _regRow.ex) || (_regRow ? _regPhGeneric : (_regSel === 'EG' || !_regSel ? '01X XXXX XXXX' : _regPhGeneric));
            %>
            <input class="form-control" style="flex:1;min-width:0;" type="tel" id="reg-phone" name="phone" value="<%= formValues.phone || '' %>" placeholder="<%= _regPh %>" data-ph-generic="<%= _regPhGeneric %>" required inputmode="tel" dir="ltr" autocomplete="tel-national" />
          </div>
          <small id="reg-phone-hint" style="color:#64748b;font-size:0.78rem;"><%= isAr ? 'هنبعتلك تحديثات حالتك على الواتساب.' : "We'll send your case updates on WhatsApp." %></small>
        </div>

        <%#
          2 Nov 2026 — REGISTER LEAK. Between 26 Oct and 2 Nov the page was opened
          91 times and POSTed once (register_submit counts every POST, and no
          register_err_* fired), so taps were stopped in the browser. Most likely
          the required 13px terms checkbox: in Meta's in-app browser (almost all
          paid traffic) the validation bubble is easy to miss or absent, so the
          button looked dead. Acceptance is
          now by tapping the button, stated right below it, and the server still
          refuses a POST without terms (hidden field below). Empty fields get a
          visible inline message instead of a browser bubble (novalidate + JS).
        %>
        <input type="hidden" name="terms" value="on" />
        <p id="reg-inline-error" role="alert" style="display:none;color:#b42318;font-size:0.9rem;margin:0 0 8px;"></p>

        <div class="auth-actions">
          <button class="btn btn-primary btn-full" id="reg-submit" type="submit"><%= isAr ? 'ابدأ حالتك' : 'Start my case' %></button>
        </div>

        <p class="flow-note" style="font-size:0.8rem;">
          <%= isAr ? 'بالضغط على «ابدأ حالتك» حضرتك موافق على' : 'By tapping Start my case you agree to the' %>
          <a href="<%= locals.publicLinkPrefix || '' %>/terms" target="_blank"><%= isAr ? 'الشروط والأحكام' : 'Terms' %></a>
          <%= isAr ? 'و' : 'and' %>
          <a href="<%= locals.publicLinkPrefix || '' %>/privacy" target="_blank"><%= isAr ? 'سياسة الخصوصية' : 'Privacy Policy' %></a>.
        </p>

        <p class="flow-note"><%= isAr ? 'لن نشارك بياناتك مع أي طرف ثالث.' : 'We never share your data with third parties.' %></p>

        <div class="auth-actions">
          <a href="/login<%= (typeof regNext !== 'undefined' && regNext) ? ('?next=' + encodeURIComponent(regNext)) : '' %>"><%= isAr ? 'عندك حساب؟ ادخل بكود على موبايلك' : 'Have an account? Sign in with a code' %></a>
        </div>
      </form>
    </div>
  </div>

<%#
  26 Oct 2026. (1) The phone placeholder follows the chosen country. (2) The
  register_view funnel count fires only once this page has been VISIBLE for a
  second (same rule as /start since 1 Oct): a server-side GET count also counts
  link prefetch / in-app-browser preloads, which never show the page to anyone.
  The raw GET is still counted server-side as register_get, for comparison.
%>
<script nonce="<%= (typeof cspNonce !== 'undefined' && cspNonce) ? cspNonce : '' %>">
(function () {
  var sel = document.getElementById('reg-country');
  var ph = document.getElementById('reg-phone');
  if (sel && ph) {
    sel.addEventListener('change', function () {
      var o = sel.options[sel.selectedIndex];
      ph.placeholder = (o && o.getAttribute('data-ph')) || ph.getAttribute('data-ph-generic') || '';
    });
  }
  var sent = false, t = null;
  function arm() {
    if (sent || document.visibilityState !== 'visible') return;
    clearTimeout(t);
    t = setTimeout(function () {
      if (sent || document.visibilityState !== 'visible') return;
      sent = true;
      try { fetch('/f/e?s=register_view', { keepalive: true, credentials: 'same-origin' }); } catch (e) {}
    }, 1000);
  }
  document.addEventListener('visibilitychange', arm);
  arm();

  // 2 Nov 2026 — inline validation (the form is novalidate: in-app browsers
  // show no bubble) + funnel counts for every tap, sent with sendBeacon so
  // they survive the navigation.
  function beacon(step) {
    try {
      if (navigator.sendBeacon) navigator.sendBeacon('/f/e?s=' + step);
      else fetch('/f/e?s=' + step, { keepalive: true, credentials: 'same-origin' });
    } catch (e) {}
  }
  var form = document.getElementById('reg-form');
  var errEl = document.getElementById('reg-inline-error');
  var btn = document.getElementById('reg-submit');
  var nameEl = document.getElementById('reg-name');
  var isAr = <%- isAr ? 'true' : 'false' %>;
  if (form) {
    form.addEventListener('submit', function (ev) {
      var missing = null;
      if (!nameEl || !String(nameEl.value || '').trim()) missing = 'name';
      else if (!ph || !String(ph.value || '').trim()) missing = 'phone';
      if (missing) {
        ev.preventDefault();
        beacon('register_blocked_' + missing);
        if (errEl) {
          errEl.textContent = missing === 'name'
            ? (isAr ? 'اكتب اسمك الأول.' : 'Please write your name first.')
            : (isAr ? 'اكتب رقم الواتساب بتاعك.' : 'Please write your WhatsApp number.');
          errEl.style.display = 'block';
        }
        try { (missing === 'name' ? nameEl : ph).focus(); } catch (e) {}
        return;
      }
      beacon('register_tap');
      if (btn) { btn.disabled = true; btn.textContent = isAr ? 'لحظة…' : 'One moment…'; }
    });
  }
})();
</script>

<%- include('partials/footer', { showFooter: false }) %>
