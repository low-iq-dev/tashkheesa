<%
  // CSP nonce for JSON-LD structured data (Theme 2 Sub-issue E item 14).
  // JSON-LD scripts are treated as data by the browser (not executed),
  // so CSP script-src doesn't block them today — adding the nonce
  // attribute is forward-compat hygiene.
  var __nonce = String(
    (typeof cspNonce !== 'undefined' && cspNonce) ||
    (typeof locals !== 'undefined' && locals && (locals.cspNonce || locals.csp_nonce || locals.nonce)) ||
    ''
  );
  var __nonceAttr = __nonce ? (' nonce="' + __nonce + '"') : '';

  // Booking is held shut on the public site until Ziad opens it — see
  // services/public_cta.js. Defaults to CLOSED if the local is missing,
  // because failing open means walking a patient into a funnel that
  // cannot take their payment.
  var __ctaOn = (typeof bookingCtaEnabled !== 'undefined') ? !!bookingCtaEnabled : false;
  var __ctaOffLabel = tt('home.cta.locked', 'Booking opens soon', 'الحجز هيفتح قريب');

  // SEO 2026-09-13 (A2) — the homepage has its own <head>, so it carries its
  // own per-language canonical + hreflang (the layout's copy never reaches it).
  // It used to declare https://tashkheesa.com/ as canonical in both languages.
  var __homeIsAr = (typeof lang !== 'undefined' && lang === 'ar');
  var __homeEn = 'https://tashkheesa.com/';
  var __homeAr = 'https://tashkheesa.com/ar/';
  var __homeCanonical = __homeIsAr ? __homeAr : __homeEn;
%><!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8" />
  <%# SEO 2026-09-13 (D): the title names what people search for, in MSA. %>
  <title><%= tt('home.meta.title',
    'Medical Second Opinion from Egyptian Consultants in 48h | Tashkheesa',
    'رأي طبي ثانٍ من استشاريين مصريين خلال ٤٨ ساعة | تشخيصة') %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="<%= tt('home.meta.description',
    'Get a specialist second opinion from board-certified Egyptian consultants. Upload your scans, labs or reports and get a written review within 48 hours.',
    'احصل على رأي طبي ثانٍ من استشاريين مصريين معتمدين. ارفع صور الأشعة أو التحاليل أو التقارير واستلم مراجعة مكتوبة خلال 48 ساعة.') %>" />
  <!-- Open Graph (Facebook / WhatsApp / LinkedIn) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Tashkheesa" />
  <meta property="og:title" content="<%= tt('home.og.title',
    'Tashkheesa — Specialist Medical Second Opinions',
    'تشخيصة — آراء طبية تانية من دكاترة متخصصين') %>" />
  <meta property="og:description" content="<%= tt('home.meta.description',
    'Get a specialist second opinion from board-certified Egyptian consultants. Upload your scans, labs or reports and get a written review within 48 hours.',
    'احصل على رأي طبي ثانٍ من استشاريين مصريين معتمدين. ارفع صور الأشعة أو التحاليل أو التقارير واستلم مراجعة مكتوبة خلال 48 ساعة.') %>" />
  <meta property="og:image" content="https://tashkheesa.com/assets/brand/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content="<%= __homeCanonical %>" />
  <meta property="og:locale" content="<%= lang === 'ar' ? 'ar_EG' : 'en_US' %>" />
  <meta property="og:locale:alternate" content="<%= lang === 'ar' ? 'en_US' : 'ar_EG' %>" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= tt('home.og.title',
    'Tashkheesa — Specialist Medical Second Opinions',
    'تشخيصة — آراء طبية تانية من دكاترة متخصصين') %>" />
  <meta name="twitter:description" content="<%= tt('home.meta.description',
    'Get a specialist second opinion from board-certified Egyptian consultants. Upload your scans, labs or reports and get a written review within 48 hours.',
    'احصل على رأي طبي ثانٍ من استشاريين مصريين معتمدين. ارفع صور الأشعة أو التحاليل أو التقارير واستلم مراجعة مكتوبة خلال 48 ساعة.') %>" />
  <meta name="twitter:image" content="https://tashkheesa.com/assets/brand/og-image.png" />
  <link rel="canonical" href="<%= __homeCanonical %>" />
  <link rel="alternate" hreflang="ar-EG" href="<%= __homeAr %>" />
  <link rel="alternate" hreflang="en" href="<%= __homeEn %>" />
  <link rel="alternate" hreflang="x-default" href="<%= __homeEn %>" />

  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json"<%- __nonceAttr %>>
  {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "name": "Tashkheesa",
    "description": "Specialist medical second opinion platform connecting patients with board-certified Egyptian consultants for written second opinions on existing reports and scans.",
    "url": "https://tashkheesa.com",
    "logo": "https://tashkheesa.com/assets/brand/og-image.png",
    "image": "https://tashkheesa.com/assets/brand/og-image.png",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "166 El Tesaeen El Shamaly Street, Fifth Settlement",
      "addressLocality": "New Cairo",
      "addressRegion": "Cairo",
      "addressCountry": "EG"
    },
    "priceRange": "<%= currency %> <%= priceRangeMin %> - <%= currency %> <%= priceRangeMax %>",
    "areaServed": {
      "@type": "Country",
      "name": "Egypt"
    },
    "serviceType": ["Medical Second Opinion", "Diagnostic Imaging Review", "Lab Report Review", "Specialist Consultation"],
    "availableLanguage": ["en", "ar"],
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..700&family=Inter:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@500;700&display=swap" rel="stylesheet" />
  <%# The home page's only stylesheet: the approved laptop-reveal reference,
      ported verbatim (docs/redesign/BRIEF.md). It is served through the /site
      mount, which falls back to public/ — there is no /styles mount. Do not
      also load /styles.css or the old /site/css/* sheets here: marketing.css
      styles body, a, h1–h3 and p unscoped and shares class names with them. %>
  <link rel="stylesheet" href="/site/styles/marketing.css" />
  <%# No-JS fallback. The opening is driven by CSS scroll-driven animations and,
      where the browser has none, by /js/home-motion.js. With neither — JS off
      in such a browser — nothing would ever fade the headline in, so show the
      opening's final, static state (the same one prefers-reduced-motion
      gets). A browser that has the CSS feature ignores this block and animates
      as normal, JS or not. %>
  <noscript><style>
    @supports not (animation-timeline: scroll()){
      .rv{height:auto}.rv-stage{position:relative;height:auto;padding-bottom:160px}
      .rv-bg{opacity:.42}.rv-lock,.rv-cue{display:none}
      .rv-head,.rv-laptop,.rv-ui,.rv-card,.rv-pills,.rv-deckglow{opacity:1}.rv-lid{transform:rotateX(14deg)}
      .rv-card,.rv-pills{position:static;margin:12px auto 0}
    }
  </style></noscript>
  <link rel="icon" href="/site/assets/favicons/favicon.svg" type="image/svg+xml" />
  <link rel="icon" type="image/png" sizes="32x32" href="/site/assets/favicons/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/site/assets/favicons/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/site/assets/favicons/apple-touch-icon.png" />
  <meta name="theme-color" content="#06352F" />
  <%# App funnel 2026-09-23 — Play badge + Android smart banner. Nothing below
      renders unless PLAY_STORE_URL is set (locals.appFunnel is null). %>
  <% if (locals.appFunnel) { %><link rel="stylesheet" href="/css/app-funnel.css" /><% } %>
</head>
<body data-meta-pixel="1">
<%- include('partials/app_smart_banner') %>
<script src="/js/meta_pixel.js" defer></script>
<%
  // ── Booking links ────────────────────────────────────────────────────────
  // Every "Start your case" on this page goes to /start — the landing page the
  // ads and the inner-page header (layouts/public.ejs) use — in the page's
  // language. Unlike that header link, these stay behind __ctaOn
  // (tests/lint/public-booking-ctas-are-gated.test.js watches __startHref).
  var __startHref = (locals.publicLinkPrefix || '') + '/start';
  var __startLabel = tt('home.cta.start', 'Start your case', 'ابدأ حالتك');

  // ── Language ─────────────────────────────────────────────────────────────
  // Every string on the page is a tt() call carrying its English and its
  // Arabic (Egyptian, like the rest of the public site; MSA only where the
  // older strings already were). Arabic digits are Western, as in the existing
  // body copy. A key added to src/i18n.js overrides the inline text.
  //
  // Counted nouns. English has two forms; Arabic has four (1 · 2 · 3–10 · 11+)
  // and the adjective agrees with them, so each form is a whole phrase with
  // {n} for the number. The counts are live, so every form does get used.
  function __count(n, key, en, ar) {
    n = Number(n) || 0;
    var form = (n === 1) ? 'one' : (n === 2) ? 'two' : ((n % 100 >= 3 && n % 100 <= 10) ? 'few' : 'many');
    return tt(key + '.' + form, (n === 1) ? en[0] : en[1], ar[form]).replace('{n}', n);
  }
  // "48h" in English; in Arabic the figure with a small unit beside it.
  function __hours(n) {
    return __homeIsAr
      ? (n + '<small> ' + ((n >= 3 && n <= 10) ? 'ساعات' : 'ساعة') + '</small>')
      : (n + 'h');
  }

  // ── Live catalogue figures ───────────────────────────────────────────────
  // Nothing about the catalogue is typed into this page. The specialty grid,
  // its service counts, the "N specialties open" figure and the starting price
  // all come from services/site_stats.js (server.js renderHomepage), the same
  // rule /services uses: a specialty is OPEN when at least one of its services
  // can be booked. If the catalogue read fails the grid is simply not drawn.
  var __specs = (typeof homeSpecialties !== 'undefined' && homeSpecialties) ? homeSpecialties : {};
  var __openSpecs = Array.isArray(__specs.open) ? __specs.open : [];
  var __soonSpecs = Array.isArray(__specs.soon) ? __specs.soon : [];
  // The headline figure is the number of cards. Only when there is no list at
  // all (the read failed) does it fall back to the visible-specialty count; a
  // list that came back with nothing open means nothing is open, and says so.
  var __openCount = (__openSpecs.length || __soonSpecs.length)
    ? __openSpecs.length
    : (typeof specialtyCount !== 'undefined' ? specialtyCount : 7);
  var __spName = function (sp) { return (__homeIsAr && sp.nameAr) ? sp.nameAr : sp.name; };
  var __priceMin = (typeof priceRangeMin !== 'undefined' && priceRangeMin) ? String(priceRangeMin) : '';
  var __fromPrice = !__priceMin ? ''
    : tt('home.price.from', 'From ' + ((typeof currency !== 'undefined' && currency) ? currency : 'EGP') + ' {price}', 'من {price} جنيه')
      .replace('{price}', __priceMin);
  // Facts main settled in the 6 Oct 2026 sweep (7589f6e), after the reference
  // was drawn — the reference said 220 beds, "Meeza", "USD, AED and SAR" and a
  // report "in your inbox":
  //   * 280 beds, and it is the New Cairo hospital's figure, not the group's —
  //     the same goes for the GAHAR accreditation (Ziad, 7 Oct 2026)
  //   * payment: card or mobile wallet, InstaPay, bank transfer; international
  //     cards are accepted and charged in Egyptian pounds (same as /faq)
  //   * the report is delivered to the account and on WhatsApp, not by email
  var __beds = 280;
  var __email = (typeof businessEmail !== 'undefined' && businessEmail) ? businessEmail : 'info@tashkheesa.com';
  var __phone = (typeof businessPhone !== 'undefined' && businessPhone) ? businessPhone : '+20 110 200 9886';
  var __address = (typeof businessAddress !== 'undefined' && businessAddress) ? businessAddress : 'New Cairo, Egypt';
%>

<header class="site-header">
  <nav class="wrap nav" aria-label="<%= tt('home.nav.aria', 'Main', 'القائمة الرئيسية') %>">
    <a class="brand brand-lockup" href="<%= locals.publicLinkPrefix || '' %>/" aria-label="<%= __homeIsAr ? ('تشخيصة — ' + tt('nav.home', 'Home', 'الرئيسية')) : 'Tashkheesa home' %>">
      <span class="tile"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l9 9-9 9-9-9 9-9z" fill="#06352F"/><path d="M12 8l4 4-4 4-4-4 4-4z" fill="#B38B3E"/></svg></span>
      <span class="name"><b>Tashkheesa</b><span lang="ar" dir="rtl">تشخيصة</span></span>
    </a>
    <a class="link" href="<%= locals.publicLinkPrefix || '' %>/services"><%= tt('nav.services', 'Services', 'الخدمات') %></a>
    <a class="link" href="<%= locals.publicLinkPrefix || '' %>/specialties"><%= tt('nav.specialties', 'Specialties', 'التخصصات') %></a>
    <a class="link" href="<%= locals.publicLinkPrefix || '' %>/#how-it-works"><%= tt('home.how.kicker', 'How it works', 'إزاي بتشتغل') %></a>
    <a class="link" href="<%= locals.publicLinkPrefix || '' %>/about"><%= tt('home.nav.hospital', 'The hospital', 'المستشفى') %></a>
    <a class="link" href="<%= locals.publicLinkPrefix || '' %>/faq"><%= tt('nav.faq', 'FAQ', 'الأسئلة الشائعة') %></a>
    <%# The language switch: a plain link to the page's other URL, so a crawler
        can follow it. One tag per line — the link lint reads rel/hreflang off
        the same line as the href. %>
    <% if (__homeIsAr) { %>
    <a class="link ar nav-lang" href="/" rel="alternate" hreflang="en" lang="en">English</a>
    <% } else { %>
    <a class="link ar nav-lang" href="/ar/" rel="alternate" hreflang="ar-EG" lang="ar">العربية</a>
    <% } %>
    <a class="link" href="/login<%= locals.langParam ? '?' + locals.langParam : '' %>"><%= tt('nav.signin', 'Sign in', 'تسجيل الدخول') %></a>
    <% if (__ctaOn) { %><a class="btn btn-brass" href="<%= __startHref %>" data-nav-start><%= __startLabel %></a>
    <% } else { %><span class="btn btn-brass is-cta-locked" aria-disabled="true" title="<%= __ctaOffLabel %>"><%= __startLabel %></span><% } %>
    <%# The menu for phones and tablets (≤1100px — marketing.css says why),
        where every link above except the logo and Start is hidden. A native <details>, so it opens, closes and reports
        its state with no script at all; /js/home-nav.js only adds Escape,
        tap-outside and close-on-follow. Shown or hidden as a whole by CSS
        (display:none above 1100px), so the links are never announced twice.
        Its links must NOT carry .link / .ar — those classes are what the
        reference hides on phones. %>
    <details class="menu" data-home-menu>
      <summary aria-label="<%= tt('home.nav.menu', 'Menu', 'القائمة') %>">
        <svg class="i-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="i-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </summary>
      <div class="menu-panel">
        <a href="<%= locals.publicLinkPrefix || '' %>/services"><%= tt('nav.services', 'Services', 'الخدمات') %></a>
        <a href="<%= locals.publicLinkPrefix || '' %>/specialties"><%= tt('nav.specialties', 'Specialties', 'التخصصات') %></a>
        <a href="<%= locals.publicLinkPrefix || '' %>/#how-it-works"><%= tt('home.how.kicker', 'How it works', 'إزاي بتشتغل') %></a>
        <a href="<%= locals.publicLinkPrefix || '' %>/about"><%= tt('home.nav.hospital', 'The hospital', 'المستشفى') %></a>
        <a href="<%= locals.publicLinkPrefix || '' %>/faq"><%= tt('nav.faq', 'FAQ', 'الأسئلة الشائعة') %></a>
        <a href="/login<%= locals.langParam ? '?' + locals.langParam : '' %>"><%= tt('nav.signin', 'Sign in', 'تسجيل الدخول') %></a>
        <% if (__homeIsAr) { %>
        <a class="menu-lang nav-lang" href="/" rel="alternate" hreflang="en" lang="en">English</a>
        <% } else { %>
        <a class="menu-lang nav-lang" href="/ar/" rel="alternate" hreflang="ar-EG" lang="ar">العربية</a>
        <% } %>
      </div>
    </details>
  </nav>
</header>

<main id="main-content">

<!-- ================= THE OPENING ================= -->
<%- include('partials/hero-reveal', { heroCta: { on: __ctaOn, href: __startHref, offLabel: __ctaOffLabel } }) %>

<!-- ================= THE PAGE ================= -->
<div class="page">

<section class="strip" aria-label="<%= tt('home.strip.aria', 'Trust', 'الثقة') %>">
  <div class="wrap">
    <span><i class="dot"></i><%= tt('home.strip.hospital', 'Shifa Hospital Group · New Cairo', 'مجموعة مستشفيات شفا · القاهرة الجديدة') %></span>
    <span><%= tt('home.strip.gahar', 'GAHAR-accredited', 'معتمد من GAHAR') %></span>
    <span><%= tt('home.strip.beds', __beds + ' beds', __beds + ' سرير') %></span>
    <% if (__openCount > 0) { %><span><%= __count(__openCount, 'home.strip.open', ['{n} specialty open', '{n} specialties open'], { one: 'تخصص واحد متاح', two: 'تخصصين متاحين', few: '{n} تخصصات متاحة', many: '{n} تخصص متاح' }) %></span><% } %>
    <% if (__fromPrice) { %><span><%= __fromPrice %></span><% } %>
    <span><%= tt('home.strip.refund', 'Refund until a consultant is assigned', 'استرداد لحد ما يتعيّن استشاري') %></span>
    <span><%= tt('home.strip.encrypted', 'Encrypted in transit and at rest', 'مشفّر أثناء النقل والتخزين') %></span>
  </div>
</section>

<section class="wrap sec reveal">
  <div class="sec-head">
    <p class="eyebrow"><%= tt('home.moments.eyebrow', 'When people come to us', 'الناس بتيجي لنا إمتى') %></p>
    <h2 class="display"><%= tt('home.moments.title', 'The moments a second opinion is worth having.', 'اللحظات اللي تستاهل رأي طبي ثانٍ.') %></h2>
    <p class="lede"><%= tt('home.moments.lede', 'It isn\'t doubt in your doctor. It\'s one more qualified pair of eyes before a decision you can\'t easily undo.', 'ده مش شك في دكتورك. دي عين خبيرة كمان قبل قرار صعب ترجع فيه.') %></p>
  </div>
  <div class="row">
    <article class="moment m-teal card"><span class="num">01</span><h3><%= tt('home.moments.1.title', 'Surgery has been recommended', 'الدكتور نصحك بعملية') %></h3><p><%= tt('home.moments.1.body', 'Is it the right operation, the right time — or is there a conservative route first?', 'هل دي العملية المناسبة، وده وقتها المناسب — ولا فيه علاج تحفّظي الأول؟') %></p></article>
    <article class="moment m-tint card"><span class="num">02</span><h3><%= tt('home.moments.2.title', 'Two doctors, two answers', 'دكتورين، وإجابتين') %></h3><p><%= tt('home.moments.2.body', 'A third, independent reading of the same files helps you choose between them.', 'قراءة تالتة مستقلة لنفس الملفات بتساعدك تختار بينهم.') %></p></article>
    <article class="moment m-brass card"><span class="num">03</span><h3><%= tt('home.moments.3.title', 'A result you don\'t understand', 'نتيجة مش فاهمها') %></h3><p><%= tt('home.moments.3.body', 'A scan or lab report full of words no one explained. We translate it, in plain Arabic and English.', 'أشعة أو تحليل مليان كلام محدش شرحهولك. بنشرحهولك بعربي وإنجليزي بسيط.') %></p></article>
    <article class="moment m-tint card"><span class="num">04</span><h3><%= tt('home.moments.4.title', 'A treatment isn\'t working', 'علاج مش جايب نتيجة') %></h3><p><%= tt('home.moments.4.body', 'Months in, no better. A specialist looks at the whole file and gives a written opinion on your options.', 'شهور ومفيش تحسّن. استشاري بيبص على الملف كله وبيكتبلك رأيه في الاختيارات اللي قدامك.') %></p></article>
  </div>
</section>

<%# id="how-it-works" anchors the /how-it-works 301 (static-pages.js) and the
    header/footer "How it works" links. %>
<section id="how-it-works" class="wrap sec reveal" style="padding-top:0">
  <div class="sec-head">
    <p class="eyebrow"><%= tt('home.how.eyebrow', 'How it works', 'إزاي بتشتغل') %></p>
    <h2 class="display"><%= tt('home.how.heading', 'Four steps. No waiting room.', '4 خطوات. من غير أوضة انتظار.') %></h2>
    <p class="lede"><%= tt('home.how.lede', 'The first three take about ten minutes. The fourth is on us.', 'أول 3 خطوات بياخدوا حوالي 10 دقايق. والرابعة علينا.') %></p>
  </div>
  <ol class="steps">
    <li class="step"><span class="n">1</span><h3><%= tt('home.how.1.title', 'Tell us what you need', 'قولنا محتاج إيه') %></h3><p><%= tt('home.how.1.body', 'Pick the specialty and how fast you need an answer: Standard 48h, VIP 18h or Urgent 4h.', 'اختار التخصص وعايز الرد بسرعة قد إيه: قياسي 48 ساعة، VIP 18 ساعة، أو عاجل 4 ساعات.') %></p></li>
    <li class="step"><span class="n">2</span><h3><%= tt('home.how.2.title', 'Upload your files', 'ارفع ملفاتك') %></h3><p><%= tt('home.how.2.body', 'Scans, lab results, reports — PDF, photos or DICOM. Write the question you want answered.', 'أشعة، تحاليل، تقارير — PDF أو صور أو DICOM. واكتب السؤال اللي عايز إجابته.') %></p></li>
    <li class="step"><span class="n">3</span><h3><%= tt('home.how.3.title', 'A consultant reads everything', 'استشاري بيقرا كل حاجة') %></h3><p><%= tt('home.how.3.body', 'A named Shifa Hospital Group consultant in that specialty reviews your whole file — not a summary of it.', 'استشاري باسمه من مجموعة مستشفيات شفا في التخصص ده بيراجع ملفك كله — مش ملخّص منه.') %></p></li>
