          (partials/hero-reveal.ejs). %>
      <p class="not-emergency"><%= tt('home.hero.not_emergency',
        'Not for emergencies. In an emergency, go to the nearest hospital or call 123.',
        'الخدمة مش للطوارئ. في الحالات الطارئة روح أقرب مستشفى أو اتصل بـ 123.') %></p>
      <% if (locals.appFunnel) { %><div class="tk-app-badge-row tk-app-badge-row--start"><%- include('partials/app_badge', { placement: 'home' }) %></div><% } %>
    </div>
    <img src="/site/img/home/patient.jpg" alt="<%= tt('home.closing.img_alt', 'A woman at her kitchen table reading her printed report with a calm smile', 'سيدة قاعدة على ترابيزة المطبخ بتقرا تقريرها المطبوع بابتسامة هادية') %>">
  </div>
</section>

</div>
</main>

