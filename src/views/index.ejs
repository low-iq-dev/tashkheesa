<%
  // CSP nonce for JSON-LD structured data (Theme 2 Sub-issue E item 14).
  // JSON-LD scripts are treated as data by the browser (not executed),
  // so CSP script-src doesn't block them today — adding the nonce
  // attribute is forward-compat hygiene.
  var __nonce = String(
    (typeof cspNonce !== 'undefined' && cspNonce) ||
    (typeof locals !== 'undefined' && locals && (locals.cspNonce || locals.csp_nonce || locals.nonce)) ||
    ''
  );
  var __nonceAttr = __nonce ? (' nonce="' + __nonce + '"') : '';

  // Booking is held shut on the public site until Ziad opens it — see
  // services/public_cta.js. Defaults to CLOSED if the local is missing,
  // because failing open means walking a patient into a funnel that
  // cannot take their payment.
  var __ctaOn = (typeof bookingCtaEnabled !== 'undefined') ? !!bookingCtaEnabled : false;
  var __ctaOffLabel = tt('home.cta.locked', 'Booking opens soon', 'الحجز هيفتح قريب');

  // SEO 2026-09-13 (A2) — the homepage has its own <head>, so it carries its
  // own per-language canonical + hreflang (the layout's copy never reaches it).
  // It used to declare https://tashkheesa.com/ as canonical in both languages.
  var __homeIsAr = (typeof lang !== 'undefined' && lang === 'ar');
  var __homeEn = 'https://tashkheesa.com/';
  var __homeAr = 'https://tashkheesa.com/ar/';
  var __homeCanonical = __homeIsAr ? __homeAr : __homeEn;
%><!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8" />
  <%# SEO 2026-09-13 (D): the title names what people search for, in MSA. %>
  <title><%= tt('home.meta.title',
    'Medical Second Opinion from Egyptian Consultants in 48h | Tashkheesa',
    'رأي طبي ثانٍ من استشاريين مصريين خلال ٤٨ ساعة | تشخيصة') %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="<%= tt('home.meta.description',
    'Get a specialist second opinion from board-certified Egyptian consultants. Upload your scans, labs or reports and get a written review within 48 hours.',
    'احصل على رأي طبي ثانٍ من استشاريين مصريين معتمدين. ارفع صور الأشعة أو التحاليل أو التقارير واستلم مراجعة مكتوبة خلال 48 ساعة.') %>" />
  <!-- Open Graph (Facebook / WhatsApp / LinkedIn) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Tashkheesa" />
  <meta property="og:title" content="<%= tt('home.og.title',
    'Tashkheesa — Specialist Medical Second Opinions',
    'تشخيصة — آراء طبية تانية من دكاترة متخصصين') %>" />
  <meta property="og:description" content="<%= tt('home.meta.description',
    'Get a specialist second opinion from board-certified Egyptian consultants. Upload your scans, labs or reports and get a written review within 48 hours.',
    'احصل على رأي طبي ثانٍ من استشاريين مصريين معتمدين. ارفع صور الأشعة أو التحاليل أو التقارير واستلم مراجعة مكتوبة خلال 48 ساعة.') %>" />
  <meta property="og:image" content="https://tashkheesa.com/assets/brand/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content="<%= __homeCanonical %>" />
  <meta property="og:locale" content="<%= lang === 'ar' ? 'ar_EG' : 'en_US' %>" />
  <meta property="og:locale:alternate" content="<%= lang === 'ar' ? 'en_US' : 'ar_EG' %>" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= tt('home.og.title',
    'Tashkheesa — Specialist Medical Second Opinions',
    'تشخيصة — آراء طبية تانية من دكاترة متخصصين') %>" />
  <meta name="twitter:description" content="<%= tt('home.meta.description',
    'Get a specialist second opinion from board-certified Egyptian consultants. Upload your scans, labs or reports and get a written review within 48 hours.',
    'احصل على رأي طبي ثانٍ من استشاريين مصريين معتمدين. ارفع صور الأشعة أو التحاليل أو التقارير واستلم مراجعة مكتوبة خلال 48 ساعة.') %>" />
  <meta name="twitter:image" content="https://tashkheesa.com/assets/brand/og-image.png" />
  <link rel="canonical" href="<%= __homeCanonical %>" />
  <link rel="alternate" hreflang="ar-EG" href="<%= __homeAr %>" />
  <link rel="alternate" hreflang="en" href="<%= __homeEn %>" />
  <link rel="alternate" hreflang="x-default" href="<%= __homeEn %>" />

  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json"<%- __nonceAttr %>>
  {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "name": "Tashkheesa",
    "description": "Specialist medical second opinion platform connecting patients with board-certified Egyptian consultants for written second opinions on existing reports and scans.",
    "url": "https://tashkheesa.com",
    "logo": "https://tashkheesa.com/assets/brand/og-image.png",
    "image": "https://tashkheesa.com/assets/brand/og-image.png",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "166 El Tesaeen El Shamaly Street, Fifth Settlement",
      "addressLocality": "New Cairo",
      "addressRegion": "Cairo",
      "addressCountry": "EG"
    },
    "priceRange": "<%= currency %> <%= priceRangeMin %> - <%= currency %> <%= priceRangeMax %>",
    "areaServed": {
      "@type": "Country",
      "name": "Egypt"
    },
    "serviceType": ["Medical Second Opinion", "Diagnostic Imaging Review", "Lab Report Review", "Specialist Consultation"],
    "availableLanguage": ["en", "ar"],
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..700&family=Inter:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@500;700&display=swap" rel="stylesheet" />
  <%# The home page's only stylesheet: the approved laptop-reveal reference,
      ported verbatim (docs/redesign/BRIEF.md). It is served through the /site
      mount, which falls back to public/ — there is no /styles mount. Do not
      also load /styles.css or the old /site/css/* sheets here: marketing.css
      styles body, a, h1–h3 and p unscoped and shares class names with them. %>
  <link rel="stylesheet" href="/site/styles/marketing.css" />
  <%# No-JS fallback. The opening is driven by CSS scroll-driven animations and,
      where the browser has none, by /js/home-motion.js. With neither — JS off
      in such a browser — nothing would ever fade the headline in, so show the
      opening's final, static state (the same one prefers-reduced-motion
      gets). A browser that has the CSS feature ignores this block and animates
      as normal, JS or not. %>
  <noscript><style>
    @supports not (animation-timeline: scroll()){
      .rv{height:auto}.rv-stage{position:relative;height:auto;padding-bottom:160px}
      .rv-bg{opacity:.42}.rv-lock,.rv-cue{display:none}
      .rv-head,.rv-laptop,.rv-ui,.rv-card,.rv-pills,.rv-deckglow{opacity:1}.rv-lid{transform:rotateX(14deg)}
      .rv-card,.rv-pills{position:static;margin:12px auto 0}
    }
  </style></noscript>
  <link rel="icon" href="/site/assets/favicons/favicon.svg" type="image/svg+xml" />
  <link rel="icon" type="image/png" sizes="32x32" href="/site/assets/favicons/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/site/assets/favicons/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/site/assets/favicons/apple-touch-icon.png" />
  <meta name="theme-color" content="#06352F" />
  <%# App funnel 2026-09-23 — Play badge + Android smart banner. Nothing below
      renders unless PLAY_STORE_URL is set (locals.appFunnel is null). %>
  <% if (locals.appFunnel) { %><link rel="stylesheet" href="/css/app-funnel.css" /><% } %>
</head>
<body data-meta-pixel="1">
<%- include('partials/app_smart_banner') %>
<script src="/js/meta_pixel.js" defer></script>
<%
  // ── Booking links ────────────────────────────────────────────────────────
  // Same rule as /services: a logged-out visitor (nearly everyone here — a
  // signed-in user is redirected away from `/`) registers first and is carried
  // into the case wizard by `next`; the page language rides as a TOP-LEVEL
  // parameter, never inside next. Every link built from this sits behind
  // __ctaOn (tests/lint/public-booking-ctas-are-gated.test.js).
  var __wizard = '/patient/new-case';
  var __loggedIn = !!(typeof user !== 'undefined' && user && user.id);
  var __startHref = __loggedIn ? __wizard : '/register?next=' + encodeURIComponent(__wizard);
  if (locals.langParam) __startHref += (__startHref.indexOf('?') === -1 ? '?' : '&') + locals.langParam;
  var __startLabel = tt('home.cta.start', 'Start your case', 'ابدأ حالتك');

  // ── Language ─────────────────────────────────────────────────────────────
  // The header, the opening's headline block and the footer carry the Arabic
  // strings the site already had. The section copy below is new and has no
  // Arabic yet: each string is behind a tt() key with only its English text
  // (TODO i18n — add the Arabic as the third argument, or in src/i18n.js), and
  // until then those sections are marked lang="en" dir="ltr" on /ar/ so the
  // English is announced as English and its punctuation sits on the right
  // side. Drop __en from a section once its keys have Arabic.
  var __en = __homeIsAr ? ' lang="en" dir="ltr"' : '';

  // ── Live catalogue figures ───────────────────────────────────────────────
  // Nothing about the catalogue is typed into this page. The specialty grid,
  // its service counts, the "N specialties open" figure and the starting price
  // all come from services/site_stats.js (server.js renderHomepage), the same
  // rule /services uses: a specialty is OPEN when at least one of its services
  // can be booked. If the catalogue read fails the grid is simply not drawn.
  var __specs = (typeof homeSpecialties !== 'undefined' && homeSpecialties) ? homeSpecialties : {};
  var __openSpecs = Array.isArray(__specs.open) ? __specs.open : [];
  var __soonSpecs = Array.isArray(__specs.soon) ? __specs.soon : [];
  var __openCount = __openSpecs.length
    ? __openSpecs.length
    : (typeof specialtyCount !== 'undefined' ? specialtyCount : 7);
  var __fromPrice = (typeof priceRangeMin !== 'undefined' && priceRangeMin)
    ? ((typeof currency !== 'undefined' && currency ? currency : 'EGP') + ' ' + priceRangeMin)
    : '';
  // Facts main settled in the 6 Oct 2026 sweep (7589f6e), after the reference
  // was drawn — the reference said 220 beds, "Meeza" and "USD, AED and SAR":
  //   * 280 beds, and it is the New Cairo hospital's figure, not the group's
  //   * payment: card or mobile wallet, InstaPay, bank transfer; international
  //     cards are accepted and charged in Egyptian pounds (same as /faq)
  var __beds = 280;
  var __email = (typeof businessEmail !== 'undefined' && businessEmail) ? businessEmail : 'info@tashkheesa.com';
  var __phone = (typeof businessPhone !== 'undefined' && businessPhone) ? businessPhone : '+20 110 200 9886';
  var __address = (typeof businessAddress !== 'undefined' && businessAddress) ? businessAddress : 'New Cairo, Egypt';
%>

<header class="site-header">
  <nav class="wrap nav" aria-label="<%= tt('home.nav.aria', 'Main') %>">
    <a class="brand brand-lockup" href="<%= locals.publicLinkPrefix || '' %>/" aria-label="<%= __homeIsAr ? ('تشخيصة — ' + tt('nav.home', 'Home', 'الرئيسية')) : 'Tashkheesa home' %>">
      <span class="tile"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l9 9-9 9-9-9 9-9z" fill="#06352F"/><path d="M12 8l4 4-4 4-4-4 4-4z" fill="#B38B3E"/></svg></span>
      <span class="name"><b>Tashkheesa</b><span lang="ar" dir="rtl">تشخيصة</span></span>
    </a>
    <a class="link" href="<%= locals.publicLinkPrefix || '' %>/services"><%= tt('nav.services', 'Services', 'الخدمات') %></a>
    <a class="link" href="<%= locals.publicLinkPrefix || '' %>/specialties"><%= tt('nav.specialties', 'Specialties', 'التخصصات') %></a>
    <a class="link" href="<%= locals.publicLinkPrefix || '' %>/#how-it-works"><%= tt('home.how.kicker', 'How it works', 'إزاي بتشتغل') %></a>
    <a class="link" href="<%= locals.publicLinkPrefix || '' %>/about"><%= tt('home.nav.hospital', 'The hospital', 'عن تشخيصة') %></a>
    <a class="link" href="<%= locals.publicLinkPrefix || '' %>/faq"><%= tt('nav.faq', 'FAQ', 'الأسئلة الشائعة') %></a>
    <%# The language switch: a plain link to the page's other URL, so a crawler
        can follow it. One tag per line — the link lint reads rel/hreflang off
        the same line as the href. %>
    <% if (__homeIsAr) { %>
    <a class="link ar nav-lang" href="/" rel="alternate" hreflang="en" lang="en">English</a>
    <% } else { %>
    <a class="link ar nav-lang" href="/ar/" rel="alternate" hreflang="ar-EG" lang="ar">العربية</a>
    <% } %>
    <a class="link" href="/login<%= locals.langParam ? '?' + locals.langParam : '' %>"><%= tt('nav.signin', 'Sign in', 'تسجيل الدخول') %></a>
    <% if (__ctaOn) { %><a class="btn btn-brass" href="<%= __startHref %>"><%= __startLabel %></a>
    <% } else { %><span class="btn btn-brass is-cta-locked" aria-disabled="true" title="<%= __ctaOffLabel %>"><%= __startLabel %></span><% } %>
  </nav>
</header>

<main id="main-content">

<!-- ================= THE OPENING ================= -->
<%- include('partials/hero-reveal', { heroCta: { on: __ctaOn, href: __startHref, offLabel: __ctaOffLabel } }) %>

<!-- ================= THE PAGE ================= -->
<div class="page">

<%# TODO i18n: home.strip.* %>
<section class="strip" aria-label="<%= tt('home.strip.aria', 'Trust') %>"<%- __en %>>
  <div class="wrap">
    <span><i class="dot"></i><%= tt('home.strip.hospital', 'Shifa Hospital Group · New Cairo') %></span><span><%= tt('home.strip.gahar', 'GAHAR-accredited') %></span><span><%= tt('home.strip.beds', __beds + ' beds') %></span><span><%= __openCount %> <%= __openCount === 1 ? tt('home.strip.specialty_open', 'specialty open') : tt('home.strip.specialties_open', 'specialties open') %></span><% if (__fromPrice) { %><span><%= tt('home.strip.from', 'From') %> <%= __fromPrice %></span><% } %><span><%= tt('home.strip.refund', 'Refund until a consultant is assigned') %></span><span><%= tt('home.strip.encrypted', 'Encrypted end to end') %></span>
  </div>
</section>

<%# TODO i18n: home.moments.* %>
<section class="wrap sec reveal"<%- __en %>>
  <div class="sec-head">
    <p class="eyebrow"><%= tt('home.moments.eyebrow', 'When people come to us') %></p>
    <h2 class="display"><%= tt('home.moments.title', 'The moments a second opinion is worth having.') %></h2>
    <p class="lede"><%= tt('home.moments.lede', 'It isn\'t doubt in your doctor. It\'s one more qualified pair of eyes before a decision you can\'t easily undo.') %></p>
  </div>
  <div class="row">
    <article class="moment m-teal card"><span class="num">01</span><h3><%= tt('home.moments.1.title', 'Surgery has been recommended') %></h3><p><%= tt('home.moments.1.body', 'Is it the right operation, the right time — or is there a conservative route first?') %></p></article>
    <article class="moment m-tint card"><span class="num">02</span><h3><%= tt('home.moments.2.title', 'Two doctors, two answers') %></h3><p><%= tt('home.moments.2.body', 'A third, independent reading of the same files helps you choose between them.') %></p></article>
    <article class="moment m-brass card"><span class="num">03</span><h3><%= tt('home.moments.3.title', 'A result you don\'t understand') %></h3><p><%= tt('home.moments.3.body', 'A scan or lab report full of words no one explained. We translate it, in plain Arabic and English.') %></p></article>
    <article class="moment m-tint card"><span class="num">04</span><h3><%= tt('home.moments.4.title', 'A treatment isn\'t working') %></h3><p><%= tt('home.moments.4.body', 'Months in, no better. A specialist looks at the whole file and says what they would do next.') %></p></article>
  </div>
</section>

<%# id="how-it-works" anchors the /how-it-works 301 (static-pages.js) and the
    header/footer "How it works" links. TODO i18n: home.how.* %>
<section id="how-it-works" class="wrap sec reveal" style="padding-top:0"<%- __en %>>
  <div class="sec-head">
    <p class="eyebrow"><%= tt('home.how.eyebrow', 'How it works') %></p>
    <h2 class="display"><%= tt('home.how.heading', 'Four steps. No waiting room.') %></h2>
    <p class="lede"><%= tt('home.how.lede', 'Most patients finish the first three in under ten minutes. The fourth is on us.') %></p>
  </div>
  <ol class="steps">
    <li class="step"><span class="n">1</span><h3><%= tt('home.how.1.title', 'Tell us what you need') %></h3><p><%= tt('home.how.1.body', 'Pick the specialty and how fast you need an answer: Standard 48h, VIP 18h or Urgent 4h.') %></p></li>
    <li class="step"><span class="n">2</span><h3><%= tt('home.how.2.title', 'Upload your files') %></h3><p><%= tt('home.how.2.body', 'Scans, lab results, reports — PDF, photos or DICOM. Write the question you want answered.') %></p></li>
    <li class="step"><span class="n">3</span><h3><%= tt('home.how.3.title', 'A consultant reads everything') %></h3><p><%= tt('home.how.3.body', 'A named Shifa Hospital Group consultant in that specialty reviews your whole file — not a summary of it.') %></p></li>
    <li class="step last"><span class="n">4</span><h3><%= tt('home.how.4.title', 'Receive your written opinion') %></h3><p><%= tt('home.how.4.body', 'A signed, bilingual report in your account and inbox. Yours to keep, and to show any doctor you choose.') %></p></li>
  </ol>
</section>

<%# TODO i18n: home.receive.* %>
<section class="receive"<%- __en %>>
  <div class="wrap reveal">
    <div class="copy">
      <p class="eyebrow"><%= tt('home.receive.eyebrow', 'What you receive') %></p>
      <h2 class="display" style="font-size:clamp(34px,4.5vw,48px)"><%= tt('home.receive.title1', 'Not a chat that disappears.') %><br><%= tt('home.receive.title2', 'A document you keep.') %></h2>
      <p style="font-size:18px;color:var(--body)"><%= tt('home.receive.lede', 'Every Tashkheesa case ends in the same place: a structured report you can read tonight, print tomorrow, and put on your own doctor\'s desk next week.') %></p>
      <ul>
        <li><span class="check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg></span><span><strong><%= tt('home.receive.1.label', 'Who reviewed it') %></strong> <%= tt('home.receive.1.body', '— the consultant\'s name, specialty and licence, on the first page.') %></span></li>
        <li><span class="check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg></span><span><strong><%= tt('home.receive.2.label', 'What they found') %></strong> <%= tt('home.receive.2.body', '— your results explained in plain language, line by line.') %></span></li>
        <li><span class="check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg></span><span><strong><%= tt('home.receive.3.label', 'What they recommend') %></strong> <%= tt('home.receive.3.body', '— and the questions worth asking your treating doctor next.') %></span></li>
        <li><span class="check brass"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg></span><span><strong><%= tt('home.receive.4.label', 'In Arabic and English') %></strong> <%= tt('home.receive.4.body', '— the same report, both languages, one PDF.') %></span></li>
      </ul>
      <p style="font-size:14px;color:var(--muted)"><%= tt('home.receive.disclaimer', 'Tashkheesa gives a professional second medical opinion. It does not diagnose or treat, and it never replaces your own doctor.') %></p>
    </div>
    <div class="visual">
      <div class="frame">
        <img src="/site/img/home/report.jpg" alt="<%= tt('home.receive.img_alt', 'A signed printed report on a desk beside reading glasses and a pen') %>" loading="lazy" decoding="async">
        <div class="tags"><span><%= tt('home.receive.tag1', 'Signed PDF') %></span><span><%= tt('home.receive.tag2', 'Stays in your account') %></span><span class="t"><%= tt('home.receive.tag3', 'Share with any doctor') %></span></div>
      </div>
    </div>
  </div>
</section>

<%# TODO i18n: home.hospital.* — the bed count is __beds (see the top of the
    body), the turnaround figures are the ones the previous home page carried,
    and the specialty figure is live. %>
<section class="hospital"<%- __en %>>
  <div class="wrap reveal">
    <img class="photo" src="/site/img/home/shifa-night.jpg" alt="<%= tt('home.hospital.img_alt', 'Shifa Hospital Group, Tagammo, lit at night from above') %>" loading="lazy" decoding="async">
    <div class="cols">
      <div class="copy">
        <p class="eyebrow"><%= tt('home.hospital.eyebrow', 'Why Tashkheesa') %></p>
        <h2 class="display"><%= tt('home.hospital.title1', 'Backed by a hospital,') %><br><%= tt('home.hospital.title2', 'not a marketplace.') %></h2>
        <p><%= tt('home.hospital.body', 'Every opinion on Tashkheesa is written by a consultant of Shifa Hospital Group — a GAHAR-accredited, ' + __beds + '-bed hospital in New Cairo with Centres of Excellence in Stroke, NICU and Oncology. No anonymous reviewers. No crowd-sourced answers. A name, a licence, and an institution that stands behind both.') %></p>
        <a class="more" href="<%= locals.publicLinkPrefix || '' %>/about"><%= tt('home.hospital.more', 'About the hospital') %> <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
      <dl class="stats">
        <div><dt><%= __beds %></dt><dd><%= tt('home.hospital.stat_beds', 'beds at Shifa Hospital, New Cairo') %></dd></div>
        <div><dt><%= __openCount %></dt><dd><%= __openCount === 1 ? tt('home.hospital.stat_specialty', 'specialty open today') : tt('home.hospital.stat_specialties', 'specialties open today') %></dd></div>
        <div><dt>48h</dt><dd><%= tt('home.hospital.stat_standard', 'standard turnaround, in writing') %></dd></div>
        <div class="brass"><dt>4h</dt><dd><%= tt('home.hospital.stat_urgent', 'fastest, with Urgent') %></dd></div>
      </dl>
    </div>
  </div>
</section>

<%# The grid is the live catalogue (see the note at the top of the body): one
    card per specialty that can be booked today, with its bookable-service
    count, linking to that specialty's section on /services (same anchor rule
    as services.ejs). Flex-wrap, so it reflows for any number of cards.
    TODO i18n: home.specialties.* (the cards already carry nameAr). %>
<section id="specialties" class="wrap sec reveal"<%- __en %>>
  <div class="sec-head">
    <p class="eyebrow"><%= tt('home.specialties.eyebrow', 'Specialties') %></p>
    <h2 class="display"><%= tt('home.specialties.title', 'Open for review today.') %></h2>
    <p class="lede"><%= tt('home.specialties.lede', 'Only specialties with a consultant on the roster are shown as open.') %><% if (__soonSpecs.length) { %> <%= __soonSpecs.length %> <%= tt('home.specialties.lede_more', 'more are being onboarded.') %><% } %></p>
  </div>
  <% if (__openSpecs.length) { %>
  <div class="specs">
    <% __openSpecs.forEach(function (sp) { %>
    <a class="spec" href="<%= locals.publicLinkPrefix || '' %>/services#<%= sp.anchor %>"><b><%= sp.name %></b><span><%= sp.services %> <%= sp.services === 1 ? tt('home.specialties.service', 'service') : tt('home.specialties.services', 'services') %></span></a>
    <% }); %>
  </div>
  <% } %>
  <% if (__soonSpecs.length) { %>
  <p class="soon"><%= tt('home.specialties.soon', 'Coming soon:') %> <%= __soonSpecs.map(function (sp) { return sp.name; }).join(' · ') %></p>
  <% } %>
</section>

<%# TODO i18n: home.tiers.* — the Urgent hours match services/urgency_window.js
    (07:00–19:00 Cairo). %>
<section class="tiers"<%- __en %>>
  <div class="wrap sec reveal">
    <div class="sec-head">
      <p class="eyebrow"><%= tt('home.tiers.eyebrow', 'Turnaround & price') %></p>
      <h2 class="display"><%= tt('home.tiers.title', 'Choose how fast. The report is the same.') %></h2>
      <p class="lede"><%= tt('home.tiers.lede', 'Every tier gets the same named consultant and the same written, bilingual report. You only pay more for speed.') %></p>
    </div>
    <div class="row">
      <article class="tier card"><span class="k"><%= tt('home.tiers.standard.k', 'Standard') %></span><span class="big">48h</span><p><%= tt('home.tiers.standard.body', 'Included in every service price. Most patients choose this.') %></p><% if (__fromPrice) { %><span class="price"><%= tt('home.tiers.standard.from', 'From') %> <%= __fromPrice %></span><% } %></article>
      <article class="tier vip card"><span class="badge"><%= tt('home.tiers.vip.badge', 'Priority') %></span><span class="k"><%= tt('home.tiers.vip.k', 'VIP') %></span><span class="big">18h</span><p><%= tt('home.tiers.vip.body', 'Your case goes to the front of the consultant\'s queue.') %></p><span class="price"><%= tt('home.tiers.vip.price', 'Service price + priority surcharge') %></span></article>
      <article class="tier urgent card"><span class="k"><%= tt('home.tiers.urgent.k', 'Urgent') %></span><span class="big">4h</span><p><%= tt('home.tiers.urgent.body', '7 AM – 7 PM Cairo time. Cases confirmed overnight start at 7 AM.') %></p><span class="price"><%= tt('home.tiers.urgent.price', 'Service price + urgent surcharge') %></span></article>
    </div>
    <div class="pay">
      <span><%= tt('home.tiers.pay.methods', 'Card or mobile wallet · InstaPay · bank transfer') %></span><span><%= tt('home.tiers.pay.international', 'International cards accepted, charged in Egyptian pounds') %></span>
      <a href="<%= locals.publicLinkPrefix || '' %>/services"><%= tt('home.tiers.pay.all', 'All services and prices') %> <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>

<%# TODO i18n: home.faq.* %>
<section class="faq"<%- __en %>>
  <div class="wrap reveal">
    <div class="intro">
      <p class="eyebrow"><%= tt('home.faq.eyebrow', 'Good questions') %></p>
      <h2 class="display"><%= tt('home.faq.title', 'The things people ask before they start.') %></h2>
      <a href="<%= locals.publicLinkPrefix || '' %>/faq"><%= tt('home.faq.all', 'Read all questions') %> <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
    <div class="list">
      <details><summary><%= tt('home.faq.1.q', 'Will my own doctor be offended?') %><i>+</i></summary><p><%= tt('home.faq.1.a', 'Good doctors expect it. A second opinion is standard practice before major decisions, and your report is written to be shared with — not hidden from — the doctor treating you.') %></p></details>
      <details><summary><%= tt('home.faq.2.q', 'Is this written by AI?') %><i>+</i></summary><p><%= tt('home.faq.2.a', 'No. A named consultant reads your files and writes the opinion. Software helps us organise your uploads and keep them secure; it does not form the opinion.') %></p></details>
      <details><summary><%= tt('home.faq.3.q', 'Who can see my files?') %><i>+</i></summary><p><%= tt('home.faq.3.a', 'Your assigned consultant and a small number of senior Tashkheesa staff for support and quality checks. Files are encrypted in transit and at rest, and handled under Egypt\'s data protection law.') %></p></details>
    </div>
  </div>
</section>

<%# TODO i18n: home.closing.* %>
<section class="cta-wrap"<%- __en %>>
  <div class="cta reveal">
    <div class="copy">
      <h2 class="display"><%= tt('home.closing.title1', 'Before your next decision,') %><br><%= tt('home.closing.title2', 'get a second opinion in writing.') %></h2>
      <p><%= tt('home.closing.body', 'Ten minutes to upload. A signed report within 48 hours. A full refund if you change your mind before a consultant is assigned.') %></p>
      <div class="ctas">
        <% if (__ctaOn) { %><a class="btn btn-brass" href="<%= __startHref %>"><%= tt('home.closing.start', 'Start your case') %></a>
        <% } else { %><span class="btn btn-brass is-cta-locked" aria-disabled="true" title="<%= __ctaOffLabel %>"><%= tt('home.closing.start', 'Start your case') %></span><% } %>
        <a class="btn btn-ghost-dark" href="https://wa.me/201102009886" target="_blank" rel="noopener"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 1-13.3 7.9L3 21l1.1-4.7A9 9 0 1 1 21 12z"/></svg><%= tt('home.closing.whatsapp', 'Ask us on WhatsApp') %></a>
      </div>
      <%# Not in the reference. The 6 Oct sweep put this line under the home
          page's Start button and loop-sweep-2026-10-06.test.js requires it on
          the page. It sits under the closing CTA rather than in the opening,
          whose headline block is sized to fit one viewport with the laptop.
          It already has Arabic, so on /ar/ it is the one Arabic line here. %>
      <p class="not-emergency"<%- __homeIsAr ? ' lang="ar" dir="rtl"' : '' %>><%= tt('home.hero.not_emergency',
        'Not for emergencies. In an emergency, go to the nearest hospital or call 123.',
        'الخدمة مش للطوارئ. في الحالات الطارئة روح أقرب مستشفى أو اتصل بـ 123.') %></p>
      <% if (locals.appFunnel) { %><div class="tk-app-badge-row tk-app-badge-row--start"><%- include('partials/app_badge', { placement: 'home' }) %></div><% } %>
    </div>
    <img src="/site/img/home/patient.jpg" alt="<%= tt('home.closing.img_alt', 'A woman at her kitchen table reading her printed report with a calm smile') %>" loading="lazy" decoding="async">
  </div>
</section>

</div>
</main>

<%# The home page carries its own footer rather than partials/footer.ejs (that
    one closes the public layout's wrappers and is styled by /styles.css).
    Arabic here is the wording the previous home footer and the shared footer
    already used. Two things the reference footer did not have are kept
    because the site depends on them: the Instagram / Facebook links (the only
    live social channels) and the Play badge. /delete-account stays — Play
    requires the deletion link, and this is the page a reviewer lands on. %>
<footer class="footer">
  <div class="wrap">
    <div class="cols">
      <div class="col brandcol">
        <span style="display:flex;align-items:center;gap:10px;color:#fff"><span style="width:32px;height:32px;border-radius:9px;background:var(--brass);display:inline-flex;align-items:center;justify-content:center"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l9 9-9 9-9-9 9-9z" fill="#0F1E2D"/><path d="M12 8l4 4-4 4-4-4 4-4z" fill="#B38B3E"/></svg></span><b style="font-size:17px">Tashkheesa</b><span lang="ar" dir="rtl" style="font-family:var(--font-ar);font-weight:700;font-size:14px;color:var(--brass-light)">تشخيصة</span></span>
        <p style="font-size:14px"><%= tt('home.footer.blurb',
          'Written second medical opinions from named consultants of Shifa Hospital Group. Second opinion only — not diagnosis or treatment.',
          'آراء طبية تانية من دكاترة بتشتغل في مستشفيات. استشارات طبية بتوصلك بسرعة ووضوح.') %></p>
        <p style="font-size:13px;color:#8A96A3"><%= tt('home.footer.hospital',
          'Shifa Hospital Group · Tagammo & Sherouk branches · New Cairo',
          'مجموعة مستشفيات شفا · القاهرة الجديدة') %></p>
      </div>
      <div class="col"><span class="h"><%= tt('home.footer.col_patients', 'Patients', 'الخدمات') %></span><a href="<%= locals.publicLinkPrefix || '' %>/services"><%= tt('home.footer.services', 'Services & prices', 'الخدمات والأسعار') %></a><a href="<%= locals.publicLinkPrefix || '' %>/specialties"><%= tt('nav.specialties', 'Specialties', 'التخصصات') %></a><a href="<%= locals.publicLinkPrefix || '' %>/#how-it-works"><%= tt('home.how.kicker', 'How it works', 'إزاي بتشتغل') %></a><a href="<%= locals.publicLinkPrefix || '' %>/faq"><%= tt('nav.faq', 'FAQ', 'الأسئلة الشائعة') %></a><a href="/login<%= locals.langParam ? '?' + locals.langParam : '' %>"><%= tt('home.footer.patient_portal', 'Patient portal', 'بوابة المريض') %></a></div>
      <div class="col"><span class="h"><%= tt('home.footer.col_company', 'Company', 'عن تشخيصة') %></span><a href="<%= locals.publicLinkPrefix || '' %>/about"><%= tt('home.footer.about', 'About', 'من نحن') %></a><a href="<%= locals.publicLinkPrefix || '' %>/blog"><%= tt('home.footer.blog', 'Blog', 'المدونة') %></a><a href="<%= locals.publicLinkPrefix || '' %>/apply"><%= tt('home.footer.for_doctors', 'For doctors', 'للأطباء') %></a><a href="<%= locals.publicLinkPrefix || '' %>/contact"><%= tt('nav.contact', 'Contact', 'كلمنا') %></a></div>
      <div class="col" style="flex-basis:220px"><span class="h"><%= tt('home.footer.col_legal', 'Legal', 'السياسات') %></span><a href="<%= locals.publicLinkPrefix || '' %>/privacy"><%= tt('home.footer.privacy', 'Privacy policy', 'سياسة الخصوصية') %></a><a href="<%= locals.publicLinkPrefix || '' %>/terms"><%= tt('home.footer.terms', 'Terms of service', 'شروط الخدمة') %></a><a href="<%= locals.publicLinkPrefix || '' %>/refund-policy"><%= tt('home.footer.refund', 'Refunds & cancellation', 'الاسترجاع والإلغاء') %></a><a href="<%= locals.publicLinkPrefix || '' %>/delivery-policy"><%= tt('home.footer.delivery', 'Delivery policy', 'سياسة التسليم') %></a><a href="<%= locals.publicLinkPrefix || '' %>/delete-account"><%= tt('home.footer.delete_account', 'Delete your account', 'حذف حسابك') %></a></div>
      <div class="col" style="flex-basis:240px"><span class="h"><%= tt('home.footer.col_reach', 'Reach us', 'تواصل معنا') %></span><a href="mailto:<%= __email %>"><%= __email %></a><a href="https://wa.me/201102009886" target="_blank" rel="noopener"><bdi dir="ltr"><%= __phone %></bdi> · WhatsApp</a><a href="https://www.instagram.com/tashkheesaa/" target="_blank" rel="noopener">Instagram</a><a href="https://www.facebook.com/profile.php?id=927504083784815" target="_blank" rel="noopener">Facebook</a><span><%= tt('home.footer.address', __address, 'مستشفى شفا، ١٦٦ شارع التسعين الشمالي، التجمع الخامس، القاهرة الجديدة') %></span>
        <% if (locals.appFunnel) { %><div class="tk-app-badge-row tk-app-badge-row--start"><%- include('partials/app_badge', { placement: 'footer' }) %></div><% } %>
      </div>
    </div>
    <div class="bottom"><span><%= tt('home.footer.copyright', '© 2026 Tashkheesa. All rights reserved.', '© 2026 تشخيصة. جميع الحقوق محفوظة.') %></span><span<%- __en %>><%= tt('home.footer.payments', 'Payments processed by Kashier · Data handled under Egypt\'s Personal Data Protection Law') %></span></div>
  </div>
</footer>

<%# Drives the opening where CSS scroll-driven animations are missing, and the
    section reveals where view() timelines are. External + defer: script-src
    has no 'unsafe-inline' (server.js). %>
<script src="/js/home-motion.js" defer></script>
<%# Soft launch 2026-09-25 — the home page closes its own body and never
    includes partials/footer, so the floating WhatsApp button has to be
    included here explicitly. Same partial as every other public page. %>
<%- include('partials/whatsapp-fab') %>
</body>
</html>
