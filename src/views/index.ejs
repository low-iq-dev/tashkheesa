  <div class="specs">
    <% __openSpecs.forEach(function (sp) { %>
    <a class="spec" href="<%= locals.publicLinkPrefix || '' %>/services#<%= sp.anchor %>"><b><%= __spName(sp) %></b><span><%= __count(sp.services, 'home.specialties.count', ['{n} service', '{n} services'], { one: 'خدمة واحدة', two: 'خدمتين', few: '{n} خدمات', many: '{n} خدمة' }) %></span></a>
    <% }); %>
  </div>
  <% } %>
  <% if (__soonSpecs.length) { %>
  <p class="soon"><%= tt('home.specialties.soon', 'Coming soon:', 'قريبًا:') %> <%= __soonSpecs.map(__spName).join(' · ') %></p>
  <% } %>
</section>

<%# The Urgent hours match services/urgency_window.js (07:00–19:00 Cairo). %>
<section class="tiers">
