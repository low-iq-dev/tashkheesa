        <li><span class="check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg></span><span><strong><%= tt('home.receive.2.label', 'What they found', 'لقى إيه') %></strong> <%= tt('home.receive.2.body', '— your results explained in plain language, line by line.', '— نتايجك مشروحة بلغة بسيطة، سطر بسطر.') %></span></li>
        <li><span class="check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg></span><span><strong><%= tt('home.receive.3.label', 'What they recommend', 'بينصح بإيه') %></strong> <%= tt('home.receive.3.body', '— and the questions worth asking your treating doctor next.', '— والأسئلة اللي تستاهل تسألها لدكتورك المعالج بعد كده.') %></span></li>
        <li><span class="check brass"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg></span><span><strong><%= tt('home.receive.4.label', 'In Arabic and English', 'بالعربي والإنجليزي') %></strong> <%= tt('home.receive.4.body', '— the same report, both languages, one PDF.', '— نفس التقرير، باللغتين، في PDF واحد.') %></span></li>
      </ul>
      <p style="font-size:14px;color:var(--muted)"><%= tt('home.receive.disclaimer', 'Tashkheesa gives a professional second medical opinion. It does not diagnose or treat, and it never replaces your own doctor.', 'تشخيصة بتقدّم رأي طبي ثانٍ متخصص. مش بتشخّص ولا بتعالج، ومش بديل عن دكتورك أبداً.') %></p>
    </div>
    <div class="visual">
      <div class="frame">
        <img src="/site/img/home/report.jpg" alt="<%= tt('home.receive.img_alt', 'A signed printed report on a desk beside reading glasses and a pen', 'تقرير مطبوع وموقّع، على مكتب، وجنبه نظارة قراءة وقلم') %>">
        <div class="tags"><span><%= tt('home.receive.tag1', 'Signed PDF', 'PDF موقّع') %></span><span><%= tt('home.receive.tag2', 'Stays in your account', 'بيفضل في حسابك') %></span><span class="t"><%= tt('home.receive.tag3', 'Share with any doctor', 'شاركه مع أي دكتور') %></span></div>
      </div>
    </div>
  </div>
</section>

<%# The bed count is __beds (see the top of the body), the turnaround figures
    are the ones the previous home page carried, and the specialty figure is
    live. %>
<section class="hospital">
  <div class="wrap reveal">
    <img class="photo" src="/site/img/home/shifa-night.jpg" alt="<%= tt('home.hospital.img_alt', 'Shifa Hospital Group, Tagammo, lit at night from above', 'مجموعة مستشفيات شفا بالتجمع، منوّرة بالليل من فوق') %>">
    <div class="cols">
      <div class="copy">
        <p class="eyebrow"><%= tt('home.hospital.eyebrow', 'Why Tashkheesa', 'ليه تشخيصة') %></p>
        <h2 class="display"><%= tt('home.hospital.title1', 'Backed by a hospital,', 'وراءنا مستشفى حقيقي،') %><br><%= tt('home.hospital.title2', 'not a marketplace.', 'مش مجرد منصة.') %></h2>
        <p><%= tt('home.hospital.body',
          'Every opinion on Tashkheesa is written by a consultant of Shifa Hospital Group. The group\'s New Cairo hospital is GAHAR-accredited, with ' + __beds + ' beds and Centres of Excellence in Stroke, NICU and Oncology. No anonymous reviewers. No crowd-sourced answers. A name, a licence, and an institution that stands behind both.',
          'كل رأي على تشخيصة بيكتبه استشاري من مجموعة مستشفيات شفا. مستشفى المجموعة في القاهرة الجديدة معتمد من GAHAR، وفيه ' + __beds + ' سرير ومراكز تميّز في السكتة الدماغية والأورام والرعاية المركزة لحديثي الولادة. مفيش مراجعين مجهولين. مفيش إجابات متجمّعة من الناس. اسم، وترخيص، ومؤسسة واقفة ورا الاتنين.') %></p>
        <a class="more" href="<%= locals.publicLinkPrefix || '' %>/about"><%= tt('home.hospital.more', 'About the hospital', 'عن المستشفى') %> <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
      <dl class="stats">
        <div><dt><%= __beds %></dt><dd><%= tt('home.hospital.stat_beds', 'beds at Shifa Hospital, New Cairo', 'سرير في مستشفى شفا بالتجمع الخامس') %></dd></div>
        <div><dt><%= __openCount %></dt><dd><%= __count(__openCount, 'home.hospital.stat_open', ['specialty open today', 'specialties open today'], { one: 'تخصص متاح النهارده', two: 'تخصصين متاحين النهارده', few: 'تخصصات متاحة النهارده', many: 'تخصص متاح النهارده' }) %></dd></div>
        <div><dt><%- __hours(48) %></dt><dd><%= tt('home.hospital.stat_standard', 'standard turnaround, in writing', 'مدة التسليم القياسية، برأي مكتوب') %></dd></div>
        <div class="brass"><dt><%- __hours(4) %></dt><dd><%= tt('home.hospital.stat_urgent', 'fastest, with Urgent', 'أسرع تسليم، لو اخترت «عاجل»') %></dd></div>
      </dl>
    </div>
  </div>
</section>

<%# The grid is the live catalogue (see the note at the top of the body): one
    card per specialty that can be booked today, with its bookable-service
    count, linking to that specialty's section on /services (same anchor rule
    as services.ejs). It reflows for any number of cards; on /ar/ the cards
    and the coming-soon line use the catalogue's Arabic names. %>
<section id="specialties" class="wrap sec reveal">
  <div class="sec-head">
    <p class="eyebrow"><%= tt('home.specialties.eyebrow', 'Specialties', 'التخصصات') %></p>
    <h2 class="display"><%= tt('home.specialties.title', 'Open for review today.', 'متاحة للمراجعة النهارده.') %></h2>
    <p class="lede"><%= tt('home.specialties.lede', 'Only specialties with a consultant on the roster are shown as open.', 'التخصصات المتاحة هي بس اللي عندنا فيها استشاري.') %><% if (__soonSpecs.length) { %> <%= __count(__soonSpecs.length, 'home.specialties.more', ['{n} more is being onboarded.', '{n} more are being onboarded.'], { one: 'وتخصص واحد كمان في الطريق.', two: 'وتخصصين كمان في الطريق.', few: 'و{n} تخصصات كمان في الطريق.', many: 'و{n} تخصص كمان في الطريق.' }) %><% } %></p>
  </div>
