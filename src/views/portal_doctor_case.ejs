<% } %>

<script<% if (typeof cspNonce !== 'undefined' && cspNonce) { %> nonce="<%= cspNonce %>"<% } %>>
  // Live word AND character counter for the report editor.
  //
  // AUDIT-2026-08-22 (L3): the delivered PDF used to silently cut findings at
  // ~950 characters and impression/recommendations at ~570, so a doctor had no
  // way to know the patient's copy was truncated. The PDF now flows onto
  // continuation pages and truncates nothing, but the doctor still deserves to
  // see how long a section is running while writing it — so the existing word
  // counter (rather than a second one bolted alongside) also reports
  // characters, and updates on load, not only on the first keystroke.
  (function() {
    var nodes = document.querySelectorAll('[data-wc-for]');
    var isAr = document.documentElement.dir === 'rtl';
    var wordUnit = isAr ? ' كلمة' : ' words';
    var charUnit = isAr ? ' حرف' : ' chars';
    nodes.forEach(function(node) {
      var id = node.getAttribute('data-wc-for');
      var ta = document.getElementById(id);
      if (!ta) return;
      function recount() {
        var raw = ta.value || '';
        var t = raw.trim();
        var words = t ? t.split(/\s+/).length : 0;
        node.textContent = words + wordUnit + ' · ' + raw.length + charUnit;
      }
      ta.addEventListener('input', recount);
      recount();
    });
  })();

  // AUDIT-2026-08-22 (L2): refuse an empty submit in the browser too.
  //
  // Submitting is irreversible — it renders and delivers the PDF, completes
  // the case, pays the doctor and emails the patient — and the three boxes
  // were labelled "required" with no validation of any kind behind the label.
  // Bound to the Submit button only: "Save draft" posts the same form and must
  // keep accepting a partial report. The server enforces the same rule; this
  // just saves a round-trip and points at the offending box.
  (function() {
    var btn = document.getElementById('report-submit-btn');
    if (!btn) return;
    var box = document.getElementById('report-submit-error');
    var isAr = document.documentElement.dir === 'rtl';
    var MSG = isAr
      ? 'النتائج والانطباع مطلوبان قبل إرسال التقرير.'
      : 'Findings and Impression are required before you can submit this report.';

    // Mirrors isReportSectionEmpty() in routes/doctor.js: a box holding only
    // whitespace or dashes is empty, so a placeholder "—" cannot be delivered.
    function isEmpty(el) {
      var t = (el && el.value ? el.value : '').trim();
      if (!t) return true;
      return !t.replace(/[\s\-—–_.·•*]+/g, '');
    }

    btn.addEventListener('click', function(e) {
      var findings = document.getElementById('rep-diag');
      var impression = document.getElementById('rep-impr');
      var offender = isEmpty(findings) ? findings : (isEmpty(impression) ? impression : null);
      if (!offender) {
        if (box) { box.hidden = true; box.textContent = ''; }
        return;
      }
      e.preventDefault();
      if (box) { box.textContent = MSG; box.hidden = false; }
      try { offender.focus(); } catch (_) {}
    });
  })();

  // Copy full case ID to clipboard + brief "Copied!" toast.
  // Visual audit item 6.  CSP-safe: addEventListener, no inline handlers.
  (function() {
    var isAr = document.documentElement.dir === 'rtl';
    var COPIED = isAr ? 'تم النسخ' : 'Copied!';
    var FAILED = isAr ? 'فشل النسخ' : 'Copy failed';
    function showToast(text) {
      var t = document.createElement('div');
      t.textContent = text;
      t.style.cssText = [
        'position:fixed',
        'inset-block-end:24px',
        'inset-inline-start:50%',
        'transform:translateX(-50%)',
        'padding:10px 18px',
        'background:var(--v2-ink)',
        'color:var(--v2-on-brand)',
        'border-radius:999px',
        'font-size:13px',
        'font-weight:600',
        'box-shadow:0 6px 20px rgba(15,30,45,0.25)',
        'z-index:1100',
        'opacity:0',
        'transition:opacity 200ms ease'
      ].join(';');
      document.body.appendChild(t);
      requestAnimationFrame(function() { t.style.opacity = '1'; });
      setTimeout(function() {
        t.style.opacity = '0';
        setTimeout(function() { if (t.parentNode) t.parentNode.removeChild(t); }, 250);
      }, 1400);
    }
    document.querySelectorAll('[data-copy-id]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var full = btn.getAttribute('data-copy-id') || '';
        if (!full) return;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(full).then(
            function() { showToast(COPIED); },
            function() { showToast(FAILED); }
          );
        } else {
          // Fallback: textarea + execCommand for older browsers.
          var ta = document.createElement('textarea');
          ta.value = full;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); showToast(COPIED); }
          catch (_) { showToast(FAILED); }
          document.body.removeChild(ta);
        }
      });
    });
  })();
</script>

<% } %>
