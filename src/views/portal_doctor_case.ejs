    </div>

    <div class="v2-stack">
      <% if (_ctx && (_ctx.question || _ctx.medicalHistory || _ctx.medications)) { %>
      <div class="v2-card">
        <div class="v2-card__header"><div class="v2-card__title"><%= tt('Clinical context', 'Clinical context', 'السياق السريري') %></div></div>
        <div class="v2-card__body">
          <% if (_ctx.question) { %>
          <div class="v2-intel-group">
            <div class="v2-intel-group__label"><%= tt('Primary question', 'Primary question', 'السؤال الأساسي') %></div>
            <div class="v2-intel-group__title"><%= _ctx.question %></div>
          </div>
          <% } %>
          <% if (_ctx.medicalHistory) { %>
          <div class="v2-intel-group">
            <div class="v2-intel-group__label"><%= tt('Medical history', 'Medical history', 'التاريخ المرضي') %></div>
            <div class="v2-intel-group__sub" style="white-space:pre-wrap;"><%= _ctx.medicalHistory %></div>
          </div>
          <% } %>
          <% if (_ctx.medications) { %>
          <div class="v2-intel-group">
            <div class="v2-intel-group__label"><%= tt('Current medications', 'Current medications', 'الأدوية الحالية') %></div>
            <div class="v2-intel-group__sub" style="white-space:pre-wrap;"><%= _ctx.medications %></div>
          </div>
          <% } %>
        </div>
      </div>
      <% } %>
      <% if (_orderIdEnc) { %>
      <a class="v2-card v2-card--link" href="/doctor/cases/<%= _orderIdEnc %>/intelligence" style="display:block;text-decoration:none;color:inherit;">
        <div class="v2-card__header">
          <div class="v2-card__title"><%= tt('Case intelligence', 'Case intelligence', 'استنباط الحالة') %></div>
          <span class="v2-chip v2-chip--soon"><%= tt('Beta', 'Beta', 'تجريبي') %></span>
        </div>
        <div class="v2-card__body">
          <div class="v2-intel-group">
            <div class="v2-intel-group__label"><%= tt('Pattern recognition', 'Pattern recognition', 'تعرّف النمط') %></div>
            <div class="v2-intel-group__title" style="display:flex;align-items:center;gap:6px;justify-content:space-between;">
              <span><%= tt('Open the case intelligence file', 'Open the case intelligence file', 'افتح ملف استنباط الحالة') %></span>
              <svg class="p-icon--flip" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;"><polyline points="9 18 15 12 9 6"/></svg>
            </div>
            <div class="v2-intel-group__sub"><%= tt('Extracted patient data, lab values, document inventory, and uploaded images — organized for clinical review.', 'Extracted patient data, lab values, document inventory, and uploaded images — organized for clinical review.', 'البيانات المستخلصة من المريض، نتائج المختبر، جرد المستندات، والصور المرفوعة — منظمة للمراجعة السريرية.') %></div>
          </div>
        </div>
      </a>
      <% } %>
      <div class="v2-card">
        <div class="v2-card__header"><div class="v2-card__title"><%= tt('Timeline', 'Timeline', 'الخط الزمني') %></div></div>
        <div class="v2-card__body">
          <div class="v2-timeline-item">
            <span class="v2-timeline-dot v2-timeline-dot--active"></span>
            <div>
              <div class="v2-timeline-text v2-timeline-text--active"><%= tt('You are reviewing this case.', 'You are reviewing this case.', 'أنت تراجع هذه الحالة.') %></div>
              <div class="v2-timeline-time"><%= tt('Now', 'Now', 'الآن') %></div>
            </div>
          </div>
          <% if (_order && _order.accepted_at) { %>
          <div class="v2-timeline-item">
            <span class="v2-timeline-dot"></span>
            <div>
              <div class="v2-timeline-text"><%= tt('Case accepted.', 'Case accepted.', 'تم قبول الحالة.') %></div>
              <div class="v2-timeline-time"><%= _order.accepted_at_human || _order.accepted_at %></div>
            </div>
          </div>
          <% } %>
          <% if (_order && _order.created_at) { %>
          <div class="v2-timeline-item">
            <span class="v2-timeline-dot"></span>
            <div>
              <div class="v2-timeline-text"><%= tt('Patient submitted the case.', 'Patient submitted the case.', 'قدّم المريض الحالة.') %></div>
              <div class="v2-timeline-time"><%= _order.created_at_human || _order.created_at %></div>
