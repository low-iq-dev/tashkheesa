<%- include('partials/header', { title: (typeof isAr !== 'undefined' && isAr) ? 'تفاصيل الحالة' : 'Case Detail', layout: 'portal', showNav: true, portalFrame: true, portalRole: 'doctor', portalActive: 'cases', portalNext: '/portal/doctor/cases' }) %>
<%
  // ---- Locals guards ----
  var _isAr = (typeof isAr !== 'undefined') ? !!isAr : false;
  var _lang = (typeof lang !== 'undefined' && lang) ? lang : (_isAr ? 'ar' : 'en');
  var _order = (typeof order !== 'undefined' && order) ? order : null;
  var _files = Array.isArray(typeof files !== 'undefined' ? files : []) ? files : [];
  var _accessDenied = !!(typeof accessDenied !== 'undefined' && accessDenied);
  var _blurred = !!(typeof blurred !== 'undefined' && blurred);
  var _canView = !!(typeof canViewDetails !== 'undefined' && canViewDetails);
  var _showAccept = !!(typeof showAcceptButton !== 'undefined' && showAcceptButton);
  var _isPaid = !!(typeof isPaid !== 'undefined' && isPaid);
  var _acceptUrl = (typeof acceptActionUrl !== 'undefined' && acceptActionUrl) ? String(acceptActionUrl) : '';
  var _orderIdEnc = (_order && _order.id) ? encodeURIComponent(String(_order.id)) : '';
  var _errMsg = (typeof errorMessage !== 'undefined' && errorMessage) ? String(errorMessage) : '';
  var _ctx = (typeof clinicalContext !== 'undefined' && clinicalContext) ? clinicalContext : {};
  var _routing = (typeof routingFacts !== 'undefined' && routingFacts) ? routingFacts : null;
  var _rx = (typeof prescriptionAddon !== 'undefined' && prescriptionAddon) ? prescriptionAddon : null;
  var _rxUrl = (typeof prescriptionRequestUrl !== 'undefined' && prescriptionRequestUrl) ? String(prescriptionRequestUrl) : '';
  var _rxFlash = (typeof rxFlash !== 'undefined' && rxFlash) ? rxFlash : null;
  /* Prescriptions are held back — see src/services/prescriptions_flag.js.
     The card stays VISIBLE so a doctor expecting the feature sees it coming
     rather than a hole, but every action on it is inert. Set from res.locals
     in server.js so all thirteen prescription surfaces flip together. */
  var _rxSoon = (typeof prescriptionsComingSoon !== 'undefined') ? !!prescriptionsComingSoon : true;

  /* AUDIT-2026-08-23 (C1) — the real review window, in hours, off the case.
     The template used to print a hardcoded "24h" here; orders.sla_hours is
     4 (Urgent) / 18 (VIP) / 48 (Standard), plus legacy 72h rows. Nothing is
     rendered when the column is null rather than substituting a guess. */
  var _slaHours = Number(_order && _order.sla_hours);
  if (!Number.isFinite(_slaHours) || _slaHours <= 0) _slaHours = null;
  var _slaWindow = _slaHours ? (_isAr ? (_slaHours + ' ساعة') : (_slaHours + 'h')) : null;


  function _initials(name) {
    if (!name) return '?';
    var parts = String(name).split(/\s+/).filter(Boolean).slice(0, 2);
    return (parts.map(function(p){ return p.charAt(0); }).join('') || '?').toUpperCase();
  }

  function _patientName() {
    var n = _order && (_order.patient_name || _order.patientName);
    var raw = n ? String(n).trim() : '';
    /* Visual audit item 12 — when the order has no name on file (or
       carries the literal "Patient" / "مريض" demo placeholder), show
       "Anonymous patient" instead so the case header doesn't read as
       a real name. */
    if (!raw || /^patient$/i.test(raw) || raw === 'مريض') {
      return tt('Anonymous patient', 'Anonymous patient', 'مريض مجهول الهوية');
    }
    return raw;
  }

  // SLA / countdown calc
  var _sla = _order && _order.sla ? _order.sla : null;
  function _countdownParts() {
    if (!_sla) return null;
    if (_sla.isBreached) {
      var over = Math.max(1, Math.ceil((Number(_sla.minutesOverdue) || 0) / 60));
      return { kind: 'breached', h: over, m: 0, sub: tt('Overdue — submit ASAP', 'Overdue — submit ASAP', 'متأخر — أرسل بأسرع وقت'), pct: 100 };
    }
    var rem = Number(_sla.minutesRemaining);
    if (!Number.isFinite(rem)) return null;
    var h = Math.floor(rem / 60);
    var m = Math.floor(rem % 60);
    var totalMin = Number(_sla.totalMinutes) || (rem + 30);
    var pct = totalMin > 0 ? Math.min(100, Math.max(0, ((totalMin - rem) / totalMin) * 100)) : 50;
    /* A case whose SLA the handler froze (doctor asked the patient for more
       files) shows the frozen remainder, not a running clock. */
    var sub = _sla.isPaused
      ? tt('Paused — waiting on patient files', 'Paused — waiting on patient files', 'موقوف مؤقتاً — بانتظار ملفات المريض')
      : tt('on track', 'on track', 'في المسار');
    return { kind: 'ok', h: h, m: m, sub: sub, pct: pct };
  }
  var _cd = _countdownParts();

  // Status chip
  var _statusKey = String((_order && (_order.db_status || _order.status)) || '').toLowerCase();
  var _statusChip = (function(){
    if (_statusKey === 'completed') return { kind: 'green', label: tt('Submitted', 'Submitted', 'تم الإرسال') };
    if (_statusKey === 'breached' || _statusKey === 'sla_breach') return { kind: 'red', label: tt('Overdue', 'Overdue', 'متأخرة') };
    if (_statusKey === 'in_review' || _statusKey === 'review') return { kind: 'teal', label: tt('In review', 'In review', 'قيد المراجعة') };
    // Theme 7 sub-issue D (2026-05-10): 'awaiting_files' transitional
    // fallback; migration 047 converts to 'rejected_files' canonical.
    if (_statusKey === 'awaiting_files' || _statusKey === 'rejected_files') return { kind: 'brass', label: tt('Awaiting files', 'Awaiting files', 'بانتظار الملفات') };
    return { kind: 'neutral', label: tt('Preview', 'Preview', 'معاينة') };
  })();

  /* Urgency tier chip. orders.urgency_tier is canonical
     ('standard' | 'vip' | 'urgent'); migration 031 rewrote the legacy
     'fast_track' rows to 'vip', so that value is handled purely as a
     belt-and-braces fallback. Until now the tier was rendered in no doctor
     view at all — a doctor could not tell an urgent 4h case from a standard
     48h one anywhere in the portal. */
  var _tierKey = String((_order && _order.urgency_tier) || '').toLowerCase();
  if (_tierKey === 'fast_track') _tierKey = 'vip';
  var _tierChip = (function(){
    /* AUDIT-2026-08-23 (C1): the tier alone told the doctor nothing actionable
       — "Standard" is not a deadline. The window is appended when the case
       carries one, so the chip reads "Standard · 48h" / "Urgent · 4h", and
       degrades to the bare tier rather than inventing a number. */
    var win = _slaHours ? (' · ' + (_isAr ? (_slaHours + 'س') : (_slaHours + 'h'))) : '';
    if (_tierKey === 'urgent') return { kind: 'red', label: tt('Urgent', 'Urgent', 'عاجل') + win };
    if (_tierKey === 'vip') return { kind: 'brass', label: tt('VIP', 'VIP', 'VIP') + win };
    if (_tierKey === 'standard') return { kind: 'neutral', label: tt('Standard', 'Standard', 'قياسي') + win };
    if (_slaHours) return { kind: 'neutral', label: (_isAr ? ('مهلة ' + _slaHours + 'س') : (_slaHours + 'h window')) };
    return null;
  })();

  /* Pre-accept file inventory. The doctor is told WHAT is waiting — how many
     files and of what kind — without a single filename, which is where
     patient identity tends to leak (scans are routinely named after the
     patient). Counting by extension gives "2 × JPG" and nothing more. */
  /* Colour key for the urgency tier — the same red / brass / neutral the
     header chip uses, so the brief and the chip agree at a glance. */
  var _tierColour = (_tierKey === 'urgent') ? 'red' : (_tierKey === 'vip' ? 'brass' : 'teal');

  var _fileKinds = (function(){
    var m = {}, order = [];
    _files.forEach(function(f) {
      /* Review round 2: the extension must be established BEFORE truncating.
         Slicing first and only then testing "did that change anything" meant
         the no-extension guard fired only for names of four characters or
         less, so every dot-less name printed its own first four letters —
         "Uploaded file" rendered as "UPLO", a raw storage key as its first
         four hex digits, and a real filename like "Ahmed Hassan MRI" as
         "AHME" on the one screen whose entire purpose is withholding the
         patient's identity. */
      var name = String(f.name || '');
      var dot = name.lastIndexOf('.');
      var raw = (dot > 0 && dot < name.length - 1) ? name.slice(dot + 1) : '';
      var e = /^[A-Za-z0-9]{1,5}$/.test(raw) ? raw.toUpperCase() : (_isAr ? 'ملف' : 'FILE');
      if (!(e in m)) { m[e] = 0; order.push(e); }
      m[e] += 1;
    });
    return order.map(function(k) { return { ext: k, n: m[k] }; });
  })();

  /* Patient sex. users.gender is free-text, so map the values we write and
     fall back to showing whatever is stored rather than hiding it. */
  var _sexLabel = (function(){
    var g = String((_order && (_order.patient_gender || _order.gender)) || '').trim();
    if (!g) return '';
    var k = g.toLowerCase();
    if (k === 'male' || k === 'm') return tt('Male', 'Male', 'ذكر');
    if (k === 'female' || k === 'f') return tt('Female', 'Female', 'أنثى');
    if (k === 'other') return tt('Other', 'Other', 'أخرى');
    if (k === 'prefer_not_to_say' || k === 'unspecified') return tt('Not specified', 'Not specified', 'غير محدد');
    return g;
  })();

  // Fee — doctors only see fee, never patient price (stripPricingFields strips that already)
  var _fee = (_order && (_order.doctor_fee != null ? _order.doctor_fee : _order.fee)) || null;
  var _feeFmt = _fee ? ('EGP ' + Number(_fee).toLocaleString('en-EG')) : null;

  /* Existing report draft (server saved).
     `report_findings` / `report_impression` / `report_recommendations` are
     derived by the handler from orders.diagnosis_text / impression_text /
     recommendation_text (and unpack the legacy combined blob). The bare
     `diagnosis` / `impression` / `recommendations` names below are NOT
     columns on orders — reading only those meant every reopened case showed
     three empty boxes, and hitting Submit then wrote those blanks over the
     saved draft. They are kept only as last-ditch fallbacks. */
  var _exDiag = (_order && (_order.report_findings || _order.diagnosis_text || _order.diagnosis || _order.findings)) || '';
  var _exImpr = (_order && (_order.report_impression || _order.impression_text || _order.impression)) || '';
  var _exRec  = (_order && (_order.report_recommendations || _order.recommendation_text || _order.recommendations || _order.recommendation)) || '';
  function _wc(s) { var t = String(s || '').trim(); return t ? t.split(/\s+/).length : 0; }
%>

<%- include('partials/doctor/topbar', {
  isAr: _isAr,
  topbarTitle: tt('Case ', 'Case ', 'الحالة ') + (_order && _order.id ? '#' + String(_order.id).slice(0, 8).toUpperCase() + '…' : ''),
  topbarSub: (_cd ? (_cd.kind === 'breached'
                      ? tt('Overdue · ' + _cd.h + 'h past due', 'Overdue · ' + _cd.h + 'h past due', 'متأخر · ' + _cd.h + 'س')
                      : tt(_cd.h + 'h ' + _cd.m + 'm remaining', _cd.h + 'h ' + _cd.m + 'm remaining', 'متبقي ' + _cd.h + 'س ' + _cd.m + 'د'))
              : (_canView ? tt('Active case', 'Active case', 'حالة نشطة') : tt('Preview mode', 'Preview mode', 'وضع المعاينة'))),
  topbarShowSearch: false,
  topbarActions: '<a class="v2-btn v2-btn--ghost" href="/portal/doctor/cases">' + (_isAr ? '→ العودة للقائمة' : '← Back to cases') + '</a>'
}) %>

<% if (_errMsg) { %>
  <div class="v2-card" style="margin-block-end:18px;border-color:#F2C9C9;">
    <div class="v2-card__body" style="display:flex;gap:12px;align-items:flex-start;">
      <div style="width:32px;height:32px;border-radius:8px;background:var(--v2-danger-bg);color:var(--v2-danger);display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0;">!</div>
      <div style="flex:1;">
        <div style="font-weight:600;color:var(--v2-danger);"><%= tt('Heads up', 'Heads up', 'تنبيه') %></div>
        <div style="font-size:13px;color:var(--v2-ink-2);margin-block-start:4px;"><%= _errMsg %></div>
      </div>
    </div>
  </div>
<% } %>

<%# AUDIT-2026-08-23 (C4, round 4): outcome of a prescription request. %>
<% if (_rxFlash) { %>
  <div class="v2-card" style="margin-block-end:18px;border-color:<%= _rxFlash.ok ? 'var(--v2-brand-tint)' : '#F2C9C9' %>;">
    <div class="v2-card__body" style="display:flex;gap:12px;align-items:flex-start;">
      <div style="width:32px;height:32px;border-radius:8px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-weight:700;background:<%= _rxFlash.ok ? 'var(--v2-brand-lt)' : 'var(--v2-danger-bg)' %>;color:<%= _rxFlash.ok ? 'var(--v2-brand-dk)' : 'var(--v2-danger)' %>;"><%= _rxFlash.ok ? '✓' : '!' %></div>
      <div style="flex:1;font-size:13px;line-height:1.55;color:var(--v2-ink-2);"><%= _rxFlash.text %></div>
    </div>
  </div>
<% } %>

<% if (_accessDenied) { %>
  <div class="v2-card">
    <div class="v2-card__body--flush">
      <div class="v2-empty">
        <div class="v2-locked__glyph" style="margin:0 auto 14px;">🔒</div>
        <div class="v2-empty__title"><%= tt('Access denied', 'Access denied', 'لا توجد صلاحية') %></div>
        <div class="v2-empty__msg"><%= tt('This case is assigned to another specialist. You will not be able to view its files or details.', 'This case is assigned to another specialist. You will not be able to view its files or details.', 'هذه الحالة مخصصة لاستشاري آخر، ولا يمكنك الاطلاع على ملفاتها أو تفاصيلها.') %></div>
        <div class="v2-empty__actions">
          <a class="v2-btn v2-btn--primary" href="/portal/doctor/cases"><%= tt('Back to cases', 'Back to cases', 'العودة للحالات') %></a>
        </div>
      </div>
    </div>
  </div>
  <%- include('partials/footer') %>
<% } else { %>

<!-- Case header card -->
<div class="v2-card v2-mb-4">
  <div class="v2-case-header">
    <div class="v2-case-header__badge"><%= _initials(_patientName()) %></div>
    <div class="v2-case-header__main">
      <div class="v2-case-header__title-line">
        <h2 class="v2-case-header__title"><%= _patientName() %></h2>
        <% if (_canView) { %>
          <span class="v2-chip v2-chip--<%= _statusChip.kind %>"><%= _statusChip.label %></span>
        <% } else { %>
          <%# AUDIT-2026-08-23 (C1): this slot used to hold a hardcoded
              "Fast-track · 24h" chip. The real tier and window are rendered
              by the _tierChip block below, which is now shown in BOTH states.
              A doctor consenting to a deadline must be shown the deadline the
              case actually carries. %>
          <span class="v2-chip v2-chip--neutral"><%= tt('Preview mode', 'Preview mode', 'معاينة') %></span>
        <% } %>
        <% if (_order && (_order.specialty_name || _order.specialty_name_ar)) { %>
          <span class="v2-chip v2-chip--teal"><%= _isAr && _order.specialty_name_ar ? _order.specialty_name_ar : _order.specialty_name %></span>
        <% } %>
        <% if (_tierChip) { %>
          <span class="v2-chip v2-chip--<%= _tierChip.kind %>" title="<%= tt('Urgency tier', 'Urgency tier', 'مستوى الاستعجال') %>"><%= _tierChip.label %></span>
        <% } %>
      </div>
      <%# AUDIT-2026-08-23 (C2): the service is the one-line answer to "what is
          this case?" and it was shown NOWHERE on this page in either state. %>
      <% if (_order && _order.service_name) { %>
        <div class="v2-case-header__service"><%= _order.service_name %></div>
      <% } %>
      <% if (_ctx && _ctx.question) { %>
        <div class="v2-case-header__sub"><%= _ctx.question %></div>
      <% } else if (!_canView) { %>
        <div class="v2-case-header__sub">
          <%= tt('A patient is waiting for your specialist review.', 'A patient is waiting for your specialist review.', 'يوجد مريض ينتظر مراجعتك.') %>
        </div>
      <% } %>
      <div class="v2-case-header__meta">
        <% if (_order && _order.id) { %>
          <%# Truncated short ID for visual readability; full UUID
              copyable via the button.  Visual audit item 6. %>
          <div class="v2-case-header__meta-item">
            <div class="k"><%= tt('Case ID', 'Case ID', 'رقم الحالة') %></div>
            <div class="v" style="display:inline-flex;align-items:center;gap:6px;">
              <span data-numeric>#<%= String(_order.id).slice(0, 8).toUpperCase() %>…</span>
              <button type="button" class="v2-iconbtn v2-iconbtn--sm" style="width:24px;height:24px;padding:0;color:var(--v2-muted);"
                      data-copy-id="<%= _order.id %>"
                      aria-label="<%= tt('Copy full case ID', 'Copy full case ID', 'نسخ رقم الحالة كاملاً') %>"
                      title="<%= tt('Copy full case ID', 'Copy full case ID', 'نسخ رقم الحالة كاملاً') %>">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
              </button>
            </div>
          </div>
        <% } %>
        <%# AUDIT-2026-08-23 (C2): submission time, age, sex and report
            language were all gated behind _canView. None of them identifies
            the patient and every one of them changes whether a specialist
            should take the case, so they are shown at preview too. %>
        <% if (_order && _order.created_at_human) { %>
          <div class="v2-case-header__meta-item"><div class="k"><%= tt('Submitted', 'Submitted', 'تم التقديم') %></div><div class="v"><%= _order.created_at_human %></div></div>
        <% } %>
        <% if (_feeFmt) { %>
          <div class="v2-case-header__meta-item"><div class="k"><%= tt('Fee', 'Fee', 'الأجر') %></div><div class="v" style="color:var(--v2-accent);"><%= _feeFmt %></div></div>
        <% } %>
        <% if (_order && _order.patient_age != null && _order.patient_age !== '') { %>
          <div class="v2-case-header__meta-item"><div class="k"><%= tt('Patient age', 'Patient age', 'عمر المريض') %></div><div class="v" data-numeric><%= _order.patient_age %></div></div>
        <% } %>
        <%# Sex sits next to age — both are read off the patient's users row and
            both are basic clinical context the doctor previously had nowhere
            on this page. %>
        <% if (_sexLabel) { %>
          <div class="v2-case-header__meta-item"><div class="k"><%= tt('Sex', 'Sex', 'النوع') %></div><div class="v"><%= _sexLabel %></div></div>
        <% } %>
        <% if (_order && _order.report_language) { %>
          <%# orders.language stores the code, not a label. %>
          <div class="v2-case-header__meta-item"><div class="k"><%= tt('Report language', 'Report language', 'لغة التقرير') %></div><div class="v"><%= String(_order.report_language).toLowerCase() === 'ar' ? tt('Arabic', 'Arabic', 'العربية') : (String(_order.report_language).toLowerCase() === 'en' ? tt('English', 'English', 'الإنجليزية') : _order.report_language) %></div></div>
        <% } %>
      </div>
      <%# AUDIT-2026-08-23 (C4): the header used to carry an unconditional
          "Write prescription" shortcut, a second entry point to a EGP 400
          paid add-on that nobody had necessarily bought. It now appears only
          when the add-on is actually payable, i.e. exactly when the doctor
          can legitimately act on it. Every other state is handled by the
          Prescription card below, which explains itself. %>
      <% if (!_rxSoon && _canView && _order && _order.id && _rx && _rx.canWrite && !_rx.hasPrescription) { %>
        <div style="margin-block-start:14px;display:flex;gap:8px;flex-wrap:wrap;">
          <a href="/portal/doctor/case/<%= _orderIdEnc %>/prescribe" class="v2-btn v2-btn--secondary v2-btn--sm" style="text-decoration:none;display:inline-flex;align-items:center;gap:6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <%= tt('Write prescription', 'Write prescription', 'كتابة وصفة') %>
          </a>
        </div>
      <% } %>
    </div>
    <% if (_cd) { %>
      <div class="v2-case-header__countdown">
        <div class="v2-case-header__countdown-k"><%= tt('Time remaining', 'Time remaining', 'الوقت المتبقي') %></div>
        <div class="v2-case-header__countdown-v" data-numeric>
          <% if (_cd.kind === 'breached') { %>
            <%= _cd.h %><span>h</span> <%= tt('over', 'over', 'تأخير') %>
          <% } else { %>
            <%= _cd.h %><span>h</span> <%= _cd.m %><span>m</span>
          <% } %>
        </div>
        <div class="v2-case-header__countdown-bar"><span style="width:<%= _cd.pct %>%;"></span></div>
        <div class="v2-case-header__countdown-sub" style="<%= _cd.kind === 'breached' ? 'color:var(--v2-danger);' : '' %>"><%= _cd.sub %></div>
      </div>
    <% } %>
  </div>
</div>

<% if (!_canView) { %>
  <!-- ============== PRE-ACCEPT (case brief + commitment) ==============

       AUDIT-2026-08-23 (C2) — this screen used to be a decoration.

       It showed two tiles: a file-count icon, and a hand-drawn dark-navy SVG
       blob captioned "Locked preview" that is not an image of anything and
       certainly not of THIS patient's study. Under them sat a commitment list
       whose headline term was a hardcoded, always-wrong "24-hour turnaround".
       A specialist was asked to take on a clinical case, with a deadline and a
       fee, on the strength of a placeholder graphic.

       The clinical question was in the render payload the entire time. The
       template simply refused to print it until after the doctor had already
       committed. So the doctor's own objection — "I wouldn't accept the case,
       I don't know what it involves" — was correct and the data to answer it
       was already there.

       What is shown now is what a worklist has always shown at triage:
       service, specialty, tier and window, patient age and sex, report
       language, what is attached (counted, never named), and the referring
       question in full. What stays locked is what should be: the files
       themselves, and the patient's identity.
  -->
  <div class="v2-brief">
    <div class="v2-brief__main">

      <div class="v2-card v2-card--railed">
        <div class="v2-card__header">
          <div class="v2-card__title"><%= tt('Case brief', 'Case brief', 'ملخص الحالة') %></div>
          <span class="v2-card__title-sub"><%= tt('Shown before you commit', 'Shown before you commit', 'يُعرض قبل القبول') %></span>
        </div>
        <div class="v2-card__body">

          <% if (_ctx && _ctx.question) { %>
            <div class="v2-brief__quote">
              <div class="v2-brief__quote-label"><%= tt('What the patient is asking', 'What the patient is asking', 'ما يسأل عنه المريض') %></div>
              <blockquote class="v2-brief__quote-text"><%= _ctx.question %></blockquote>
            </div>
          <% } else { %>
            <div class="v2-brief__quote v2-brief__quote--empty">
              <div class="v2-brief__quote-label"><%= tt('What the patient is asking', 'What the patient is asking', 'ما يسأل عنه المريض') %></div>
              <div class="v2-brief__quote-text v2-brief__quote-text--muted"><%= tt('The patient did not write a referring question. The attached files are the whole brief.', 'The patient did not write a referring question. The attached files are the whole brief.', 'لم يكتب المريض سؤالاً محدداً. الملفات المرفقة هي كامل المعطيات.') %></div>
            </div>
          <% } %>

          <% if (_ctx && (_ctx.medicalHistory || _ctx.medications)) { %>
            <div class="v2-brief__notes">
              <% if (_ctx.medicalHistory) { %>
                <div class="v2-brief__note">
                  <div class="v2-brief__note-label"><%= tt('Medical history', 'Medical history', 'التاريخ المرضي') %></div>
                  <div class="v2-brief__note-body"><%= _ctx.medicalHistory %></div>
                </div>
              <% } %>
              <% if (_ctx.medications) { %>
                <div class="v2-brief__note">
                  <div class="v2-brief__note-label"><%= tt('Current medications', 'Current medications', 'الأدوية الحالية') %></div>
                  <div class="v2-brief__note-body"><%= _ctx.medications %></div>
                </div>
              <% } %>
            </div>
          <% } %>

          <dl class="v2-brief__specs">
            <% if (_order && _order.service_name) { %>
              <div class="v2-brief__spec v2-brief__spec--keyed v2-brief__spec--key-brass"><dt><%= tt('Service', 'Service', 'الخدمة') %></dt><dd><%= _order.service_name %></dd></div>
            <% } %>
            <% if (_order && (_order.specialty_name || _order.specialty_name_ar)) { %>
              <div class="v2-brief__spec v2-brief__spec--keyed v2-brief__spec--key-teal"><dt><%= tt('Specialty', 'Specialty', 'التخصص') %></dt><dd><%= _isAr && _order.specialty_name_ar ? _order.specialty_name_ar : _order.specialty_name %></dd></div>
            <% } %>
            <% if (_tierChip) { %>
              <%# The one spec that changes what a doctor should do, so it
                  carries the tier's own colour rather than the shared grey. %>
              <div class="v2-brief__spec v2-brief__spec--keyed v2-brief__spec--key-<%= _tierColour %>"><dt><%= tt('Turnaround', 'Turnaround', 'مدة الإنجاز') %></dt><dd><span class="v2-pill v2-pill--<%= _tierColour %>"><span class="v2-pill__dot"></span><%= _tierChip.label %></span></dd></div>
            <% } %>
            <% if (_order && _order.patient_age != null && _order.patient_age !== '') { %>
              <div class="v2-brief__spec v2-brief__spec--keyed v2-brief__spec--key-info"><dt><%= tt('Patient', 'Patient', 'المريض') %></dt><dd data-numeric><%= _order.patient_age %><% if (_sexLabel) { %> · <%= _sexLabel %><% } %></dd></div>
            <% } else if (_sexLabel) { %>
              <div class="v2-brief__spec"><dt><%= tt('Patient', 'Patient', 'المريض') %></dt><dd><%= _sexLabel %></dd></div>
            <% } %>
            <% if (_order && _order.report_language) { %>
              <div class="v2-brief__spec v2-brief__spec--keyed v2-brief__spec--key-info"><dt><%= tt('Report language', 'Report language', 'لغة التقرير') %></dt><dd><span class="v2-pill v2-pill--info"><%= String(_order.report_language).toLowerCase() === 'ar' ? tt('Arabic', 'Arabic', 'العربية') : (String(_order.report_language).toLowerCase() === 'en' ? tt('English', 'English', 'الإنجليزية') : _order.report_language) %></span></dd></div>
            <% } %>
            <% if (_order && _order.created_at_human) { %>
              <div class="v2-brief__spec"><dt><%= tt('Submitted', 'Submitted', 'تم التقديم') %></dt><dd><%= _order.created_at_human %></dd></div>
            <% } %>
          </dl>

          <%# File inventory: counted and typed, never named. A scan filename
              routinely carries the patient's name, so listing them here would
              undo the identity gate this whole screen exists to enforce. %>
          <div class="v2-brief__files">
            <div class="v2-brief__files-head">
              <span class="v2-brief__files-title"><%= tt('Attached for review', 'Attached for review', 'مرفق للمراجعة') %></span>
              <span class="v2-brief__files-lock">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <%= tt('opens on accept', 'opens on accept', 'تُفتح عند القبول') %>
              </span>
            </div>
            <% if (_fileKinds.length) { %>
              <div class="v2-brief__filerow">
                <% _fileKinds.forEach(function(k) { %>
                  <span class="v2-pill v2-pill--ghost"><b data-numeric><%= k.n %></b> × <%= k.ext %></span>
                <% }); %>
              </div>
            <% } else { %>
              <div class="v2-brief__files-empty"><%= tt('No files attached to this case yet.', 'No files attached to this case yet.', 'لا توجد ملفات مرفقة بهذه الحالة بعد.') %></div>
            <% } %>
          </div>

        </div>
      </div>

      <%# The commitment panel. Every line is now read off the case: the
          window comes from orders.sla_hours (AUDIT-2026-08-23 C1) rather than
          the hardcoded "24-hour turnaround" that was wrong on every row in
          the database, and the fee line only appears when there is a fee. %>
      <div class="v2-card v2-card--commit">
        <div class="v2-card__body">
          <div class="v2-gated__commit-title"><%= tt('Accepting this case commits you to', 'Accepting this case commits you to', 'بقبولك للحالة فإنك تلتزم بـ') %></div>
          <ul class="v2-gated__commit-list">
            <li>
              <span class="v2-gated__check">✓</span>
              <div>
                <% if (_slaWindow) { %>
                  <b><%= _isAr ? ('تسليم خلال ' + _slaWindow) : (_slaWindow + ' turnaround') %><% if (_tierKey === 'urgent' || _tierKey === 'vip') { %> · <%= _tierKey === 'urgent' ? tt('Urgent', 'Urgent', 'عاجل') : tt('VIP', 'VIP', 'VIP') %><% } %></b>
                  <em><%= tt('The clock starts the moment you accept. Submit your report before it expires.', 'The clock starts the moment you accept. Submit your report before it expires.', 'يبدأ العد فور قبولك. أرسل تقريرك قبل انتهاء المهلة.') %></em>
                <% } else { %>
                  <b><%= tt('Submit within the case SLA', 'Submit within the case SLA', 'الالتزام بمهلة الحالة') %></b>
                  <em><%= tt('The countdown appears on this page the moment you accept.', 'The countdown appears on this page the moment you accept.', 'يظهر العد التنازلي على هذه الصفحة فور القبول.') %></em>
                <% } %>
              </div>
            </li>
            <li><span class="v2-gated__check">✓</span><div><b><%= tt('Three-field structured report', 'Three-field structured report', 'تقرير بثلاثة حقول') %></b><em><%= tt('Findings · Impression · Recommendation', 'Findings · Impression · Recommendation', 'النتائج · الانطباع · التوصية') %></em></div></li>
            <% if (_feeFmt) { %>
            <li><span class="v2-gated__check">✓</span><div><b><%= _feeFmt %></b><em><%= tt('Credited on submission · paid out monthly', 'Credited on submission · paid out monthly', 'يُحسب عند الإرسال · يُسوّى شهرياً') %></em></div></li>
            <% } %>
            <li><span class="v2-gated__check">✓</span><div><b><%= tt('Audit-logged access', 'Audit-logged access', 'وصول موثّق') %></b><em><%= tt('All file views recorded for the patient record.', 'All file views recorded for the patient record.', 'تُسجّل كل عمليات فتح الملفات في سجل المريض.') %></em></div></li>
          </ul>
          <% if (_showAccept && _acceptUrl) { %>
            <form id="acceptCaseForm" class="v2-gated__actions" method="POST" action="<%= _acceptUrl %>">
              <%- (typeof csrfField === 'function') ? csrfField() : '' %>
              <button type="submit" class="v2-btn v2-btn--primary v2-btn--lg"><%= tt('Accept case', 'Accept case', 'قبول الحالة') %></button>
              <a class="v2-btn v2-btn--ghost" href="/portal/doctor/cases"><%= tt('Decline · back to queue', 'Decline · back to queue', 'رفض · العودة للقائمة') %></a>
            </form>
          <% } else if (!_isPaid) { %>
            <div class="v2-gated__actions" style="display:block;">
              <div style="background:var(--v2-warn-bg);border:1px solid #F2D8B0;border-radius:10px;padding:10px 12px;font-size:12px;color:var(--v2-warn);font-weight:600;">
                <%= tt('Payment pending · accept will unlock once the patient completes payment.', 'Payment pending · accept will unlock once the patient completes payment.', 'الدفع قيد الانتظار · سيُفتح القبول بعد إتمام الدفع.') %>
              </div>
            </div>
          <% } %>
          <div class="v2-gated__fineprint">
            <%= tt('Files are encrypted in transit and at rest (AES-256). Access requires authentication and is audit-logged per Egyptian Medical Syndicate guidelines.', 'Files are encrypted in transit and at rest (AES-256). Access requires authentication and is audit-logged per Egyptian Medical Syndicate guidelines.', 'الملفات مشفّرة أثناء النقل والتخزين (AES-256). يستلزم الوصول مصادقة وتُسجَّل العمليات وفق إرشادات نقابة الأطباء.') %>
          </div>
        </div>
      </div>
    </div>

    <div class="v2-stack">
      <%# AUDIT-2026-08-23 (C3) — "Why you got this case", rebuilt out of facts.

          It previously asserted "Trusted reviewer" and "Your SLA compliance
          and patient ratings made you a top match." to every doctor, from no
          query at all, and fell back to the literal string "Your primary
          specialty". A doctor onboarded that morning — no completed cases, no
          SLA record, no rating — was told the platform had weighed a history
          it does not have. Every line below is either read from the database
          or not rendered. %>
      <div class="v2-card">
        <div class="v2-card__header"><div class="v2-card__title"><%= tt('Why you got this case', 'Why you got this case', 'لماذا أُسندت إليك') %></div></div>
        <div class="v2-card__body">
          <% if (_routing && _routing.listedForService && _routing.serviceName) { %>
            <div class="v2-intel-group">
              <div class="v2-intel-group__label"><span class="v2-pill v2-pill--green"><span class="v2-pill__dot"></span><%= tt('Service match', 'Service match', 'تطابق الخدمة') %></span></div>
              <div class="v2-intel-group__title"><%= _routing.serviceName %></div>
              <div class="v2-intel-group__sub"><%= tt('You are registered to review this service.', 'You are registered to review this service.', 'أنت مسجَّل لمراجعة هذه الخدمة.') %></div>
            </div>
          <% } %>
          <% if (_routing && (_routing.specialtyName || _routing.specialtyNameAr)) { %>
            <div class="v2-intel-group">
              <div class="v2-intel-group__label"><span class="v2-pill v2-pill--teal"><span class="v2-pill__dot"></span><%= tt('Specialty', 'Specialty', 'التخصص') %></span></div>
              <div class="v2-intel-group__title"><%= _isAr && _routing.specialtyNameAr ? _routing.specialtyNameAr : _routing.specialtyName %></div>
            </div>
          <% } %>
          <% if (_routing && _routing.isReassignment) { %>
            <div class="v2-intel-group">
              <div class="v2-intel-group__label"><span class="v2-pill v2-pill--amber"><span class="v2-pill__dot"></span><%= tt('Routing', 'Routing', 'التوجيه') %></span></div>
              <div class="v2-intel-group__title"><%= tt('Reassigned to you', 'Reassigned to you', 'أُعيد إسنادها إليك') %></div>
              <div class="v2-intel-group__sub"><%= tt('This case was previously with another specialist.', 'This case was previously with another specialist.', 'كانت هذه الحالة مع استشاري آخر.') %></div>
            </div>
          <% } %>
          <% if (_routing && _routing.respondByHuman) { %>
            <div class="v2-intel-group">
              <div class="v2-intel-group__label"><span class="v2-pill v2-pill--red"><span class="v2-pill__dot"></span><%= tt('Respond by', 'Respond by', 'الرد قبل') %></span></div>
              <div class="v2-intel-group__title"><%= _routing.respondByHuman %></div>
              <div class="v2-intel-group__sub"><%= tt('After this the case is offered to another specialist.', 'After this the case is offered to another specialist.', 'بعد هذا الموعد تُعرض الحالة على استشاري آخر.') %></div>
            </div>
          <% } else if (_routing && _routing.assignedAtHuman) { %>
            <div class="v2-intel-group">
              <div class="v2-intel-group__label"><span class="v2-pill v2-pill--neutral"><span class="v2-pill__dot"></span><%= tt('Reached you', 'Reached you', 'وصلتك') %></span></div>
              <div class="v2-intel-group__title"><%= _routing.assignedAtHuman %></div>
            </div>
          <% } %>
          <% if (!_routing || (!_routing.listedForService && !_routing.specialtyName && !_routing.specialtyNameAr && !_routing.assignedAtHuman)) { %>
            <div class="v2-intel-group">
              <div class="v2-intel-group__sub"><%= tt('Routed to you by clinical operations.', 'Routed to you by clinical operations.', 'وُجِّهت إليك من فريق العمليات السريرية.') %></div>
            </div>
          <% } %>
        </div>
      </div>
      <% if (_feeFmt) { %>
      <div class="v2-card">
        <div class="v2-card__header"><div class="v2-card__title"><%= tt('Fee breakdown', 'Fee breakdown', 'تفاصيل الأجر') %></div></div>
        <div class="v2-card__body">
          <div class="v2-fee-row"><span><%= tt('Specialist fee', 'Specialist fee', 'أجر الاستشاري') %></span><span data-numeric><%= _feeFmt %></span></div>
          <div class="v2-fee-row"><span class="muted"><%= tt('Platform fee (already deducted)', 'Platform fee (already deducted)', 'رسوم المنصة (مخصومة)') %></span><span class="muted">—</span></div>
          <div class="v2-fee-row v2-fee-row--total"><span><%= tt('You receive', 'You receive', 'تستلم') %></span><span data-numeric><%= _feeFmt %></span></div>
        </div>
      </div>
      <% } %>
    </div>
  </div>

<% } else { %>
  <!-- ============== POST-ACCEPT (full case) ============== -->
  <div class="v2-layout-grid">
    <div class="v2-stack">
      <% if (_files.length) { %>
      <div class="v2-card">
        <div class="v2-card__header">
          <div class="v2-card__title"><%= tt('Patient files', 'Patient files', 'ملفات المريض') %></div>
          <span class="v2-card__title-sub"><span data-numeric><%= _files.length %></span> <%= tt('files', 'files', 'ملف') %></span>
        </div>
        <div class="v2-card__body v2-card__body--flush">
          <% _files.forEach(function(f) {
               var ext = (f.name || '').split('.').pop().toUpperCase().slice(0, 4);
          %>
            <div class="v2-file-row">
              <div class="v2-file-row__icon"><%= ext || '·' %></div>
              <div class="v2-file-row__name">
                <%= f.name %>
                <%# Files from order_additional_files — what the patient uploaded
                    after the doctor asked for more. Flagged so the doctor can
                    see at a glance which files answered their request. %>
                <% if (f.source === 'additional') { %>
                  <span class="v2-chip v2-chip--brass" style="margin-inline-start:6px;"><%= tt('Added later', 'Added later', 'أُضيف لاحقاً') %></span>
                <% } %>
              </div>
              <a class="v2-btn v2-btn--ghost v2-btn--sm" href="<%= f.url %>" target="_blank" rel="noopener"><%= tt('Open', 'Open', 'فتح') %></a>
            </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (_statusKey !== 'completed') { %>
      <!-- Report editor — preserves field names: diagnosis, impression, recommendations -->
      <div class="v2-card">
        <div class="v2-card__header">
          <div class="v2-card__title"><%= tt('Report', 'Report', 'التقرير') %></div>
          <span class="v2-card__title-sub"><%= tt('Auto-saved as you type', 'Auto-saved as you type', 'يُحفظ تلقائياً أثناء الكتابة') %></span>
        </div>
        <form method="POST" action="/portal/doctor/case/<%= _orderIdEnc %>/diagnosis">
          <%- (typeof csrfField === 'function') ? csrfField() : '' %>
          <div class="v2-card__body" style="display:flex;flex-direction:column;gap:14px;">
            <div class="v2-field">
              <div class="v2-field__labelrow">
                <label class="v2-field__label" for="rep-diag"><%= tt('Findings', 'Findings', 'النتائج') %><span class="v2-field__req"><%= tt('required', 'required', 'مطلوب') %></span></label>
                <span class="v2-field__count" data-wc-for="rep-diag" data-numeric><%= _wc(_exDiag) %> <%= tt('words', 'words', 'كلمة') %></span>
              </div>
              <%# AUDIT-2026-08-22 (L2): aria-required, NOT the `required`
                  attribute — the same form's "Save draft" button must keep
                  accepting a partial report, and `required` would block it. %>
              <textarea class="v2-field__textarea" id="rep-diag" name="diagnosis" rows="6" aria-required="true"><%= _exDiag %></textarea>
              <div class="v2-field__hint"><%= tt('Describe what you see. Measurements, locations, comparisons with priors.', 'Describe what you see. Measurements, locations, comparisons with priors.', 'صف ما تراه. القياسات، المواقع، والمقارنة بالفحوص السابقة.') %></div>
            </div>
            <div class="v2-field">
              <div class="v2-field__labelrow">
                <label class="v2-field__label" for="rep-impr"><%= tt('Impression', 'Impression', 'الانطباع') %><span class="v2-field__req"><%= tt('required', 'required', 'مطلوب') %></span></label>
                <span class="v2-field__count" data-wc-for="rep-impr" data-numeric><%= _wc(_exImpr) %> <%= tt('words', 'words', 'كلمة') %></span>
              </div>
              <textarea class="v2-field__textarea" id="rep-impr" name="impression" rows="4" aria-required="true"><%= _exImpr %></textarea>
              <div class="v2-field__hint"><%= tt('Your clinical interpretation. One or two sentences.', 'Your clinical interpretation. One or two sentences.', 'تفسيرك السريري. جملة أو جملتان.') %></div>
            </div>
            <div class="v2-field">
              <div class="v2-field__labelrow">
                <label class="v2-field__label" for="rep-rec"><%= tt('Recommendation to patient', 'Recommendation to patient', 'التوصية للمريض') %><span class="v2-field__req"><%= tt('required', 'required', 'مطلوب') %></span></label>
                <span class="v2-field__count" data-wc-for="rep-rec" data-numeric><%= _wc(_exRec) %> <%= tt('words', 'words', 'كلمة') %></span>
              </div>
              <textarea class="v2-field__textarea" id="rep-rec" name="recommendations" rows="4" placeholder="<%= tt('Plain language. The patient reads this directly.', 'Plain language. The patient reads this directly.', 'لغة بسيطة. المريض يقرأ هذا مباشرة.') %>"><%= _exRec %></textarea>
              <div class="v2-field__hint"><%= tt('Calm, specific, actionable. Avoid jargon — the patient reads this directly.', 'Calm, specific, actionable. Avoid jargon — the patient reads this directly.', 'هادئة، محددة، قابلة للتنفيذ. تجنّب المصطلحات — المريض يقرأها مباشرة.') %></div>
            </div>
            <%# AUDIT-2026-08-22 (L2): inline refusal message for an empty
                submit. The server refuses independently — this is only the
                helpful half, so the doctor is told before the round-trip. %>
            <div id="report-submit-error" role="alert" hidden
                 style="font-size:13px;font-weight:600;color:var(--v2-danger);background:var(--v2-danger-bg);border-radius:10px;padding:10px 12px;"></div>
            <div style="display:flex;justify-content:space-between;align-items:center;border-block-start:1px solid var(--v2-rule);padding-block-start:14px;flex-wrap:wrap;gap:8px;">
              <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <button type="submit" class="v2-btn v2-btn--secondary"><%= tt('Save draft', 'Save draft', 'حفظ مسودة') %></button>
              </div>
              <button type="submit" id="report-submit-btn" formaction="/portal/doctor/case/<%= _orderIdEnc %>/report" formmethod="POST" class="v2-btn v2-btn--brass v2-btn--lg"><%= tt('Submit report', 'Submit report', 'إرسال التقرير') %></button>
            </div>
          </div>
        </form>
      </div>
      <% } else { %>
      <!-- Completed: show submitted artifact link -->
      <div class="v2-card">
        <div class="v2-card__header">
          <div class="v2-card__title"><%= tt('Submitted report', 'Submitted report', 'التقرير المُرسَل') %></div>
          <span class="v2-chip v2-chip--green"><%= tt('Completed', 'Completed', 'مكتمل') %></span>
        </div>
        <div class="v2-card__body">
          <%# AUDIT-P0-1: report_url is an R2 object key, not a URL. Link the
              signed-download route instead. %>
          <% if (_order && (_order.report_url || _order.reportUrl)) { %>
            <a class="v2-btn v2-btn--primary" href="/portal/case/<%= _order.id %>/download-report" target="_blank" rel="noopener"><%= tt('Open submitted PDF', 'Open submitted PDF', 'فتح ملف PDF المُرسَل') %></a>
          <% } else { %>
            <div class="v2-empty__msg"><%= tt('Your submitted report is being prepared. Refresh in a moment.', 'Your submitted report is being prepared. Refresh in a moment.', 'يجري تجهيز تقريرك. حدّث الصفحة بعد قليل.') %></div>
          <% } %>
        </div>
      </div>
      <% } %>

      <!-- ============== PRESCRIPTION (add-on aware) ==============

           AUDIT-2026-08-23 (C4) — this card used to be unconditional.

           `prescription` is a paid add-on: addon_services carries it at
           EGP 400 with a 50% doctor commission and a full purchase → fulfil →
           earnings lifecycle in src/services/addons/prescription.js. The card
           consulted none of it. It rendered a brass "Write prescription" CTA
           on every accepted case, pointing at /prescribe — a route that wrote
           the `prescriptions` table and never touched `order_addons`.

           Two ways that lost money. A patient who never bought the add-on got
           a EGP 400 product free. A patient who DID buy it got it delivered
           with the add-on still sitting at 'paid', which settles as a refund
           at completion — patient refunded, doctor unpaid, prescription
           delivered anyway.

           The card now renders the add-on's actual state, and a doctor who
           believes one is indicated raises a request rather than writing it.
      -->
      <% if (_rxSoon) { %>
        <%# ---- Prescriptions: coming soon (2026-08-24) ----
            Visible but inert. Three things are unresolved and none of them
            should be found by a real patient in launch week: there is no
            addon_prescription row in service_regional_prices so the option
            cannot be bought at all; /admin/orders/:id/mark-paid — the only
            live payment path while Paymob is down — never activates add-ons;
            and nothing has ever been sold, so no part of the lifecycle has
            run against real money. Flip PRESCRIPTIONS_ENABLED=true when the
            audit is done. %>
        <div class="v2-card v2-card--soon">
          <div class="v2-card__header">
            <div class="v2-card__title"><%= tt('Prescription', 'Prescription', 'الوصفة الطبية') %></div>
            <span class="v2-pill v2-pill--soon"><%= tt('Coming soon', 'Coming soon', 'قريباً') %></span>
          </div>
