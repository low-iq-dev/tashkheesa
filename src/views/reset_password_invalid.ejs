<%- include('partials/header', { title: "Reset Link Invalid", layout: "auth", showNav: false, showFooter: false }) %>
<%
  const _lang = (typeof lang !== 'undefined' && lang) ? lang : ((typeof isAr !== 'undefined' && isAr) ? 'ar' : 'en');
  const _isAr = (typeof isAr !== 'undefined') ? !!isAr : (_lang === 'ar');
%>
  <div class="auth-page">
    <div class="auth-card">
      <%- include('partials/auth_brand') %>
      <div class="auth-header">
        <h1><%= _isAr ? 'الرابط غير صالح' : 'Invalid or expired link' %></h1>
        <p>
          <%= _isAr ?
            'انتهت صلاحية رابط إعادة تعيين كلمة المرور أو تم استخدامه بالفعل.' :
            'This password reset link is no longer valid or has already been used.'
          %>
        </p>
      </div>

      <%#
        AUDIT-2026-08-23 (P0-DOC-WELCOME): this page used to be a dead end — the
        only way forward was a link to /forgot-password, where the user had to
        find the form and retype the address they had just proved they own by
        clicking a link mailed to it. Doctors dropped out here. The recovery is
        now ON this page: one field, one click, posting straight to the existing
        (rate-limited, enumeration-safe) POST /forgot-password, which replies
        with its own "If an account exists…" confirmation state. That handler
        also decides WHICH email to send — an onboarding doctor with no password
        gets the 7-day welcome again, not a 2-hour generic reset — so the
        replacement link matches the one that just expired.
      %>
      <form method="post" action="<%= '/forgot-password?lang=' + _lang %>">
        <%- (typeof csrfField === 'function') ? csrfField() : '' %>

        <div class="form-group">
          <label class="form-label" for="reset-invalid-email">
            <%= _isAr ? 'البريد الإلكتروني' : 'Email' %>
          </label>
          <input class="form-control" id="reset-invalid-email" type="email" name="email"
                 autocomplete="email" placeholder="you@example.com" required dir="ltr" />
        </div>

        <div class="auth-actions">
          <button class="btn btn-primary btn-full" type="submit">
            <%= _isAr ? 'أرسل لي رابطًا جديدًا' : 'Email me a new link' %>
          </button>
        </div>
      </form>

      <p style="text-align:center;font-size:13px;color:#718096;margin:0 0 16px;">
        <%= _isAr ?
          'إذا كان هناك حساب بهذا البريد الإلكتروني، ستصلك رسالة تحتوي على رابط جديد.' :
          'If an account exists for this email, you will receive a message with a fresh link.'
        %>
      </p>

      <div class="auth-actions">
        <a href="<%= '/login?lang=' + _lang %>">
          <%= _isAr ? 'تسجيل الدخول' : 'Sign in' %>
        </a>
      </div>
    </div>
  </div>

<%- include('partials/footer', { showFooter: false }) %>
