<%
  // Doctors list. Locals: doctors, specialties, statusFilter,
  //                       pendingDoctorsCount, pausedDoctorsCount.
  var isAr = (typeof lang !== 'undefined' && lang === 'ar');
  var _doctors = (typeof doctors !== 'undefined' && doctors) ? doctors : [];
  var _statusFilter = (typeof statusFilter !== 'undefined' && statusFilter) ? statusFilter : 'all';
  var _pending = (typeof pendingDoctorsCount !== 'undefined') ? Number(pendingDoctorsCount) || 0 : 0;
  var _paused = (typeof pausedDoctorsCount !== 'undefined') ? Number(pausedDoctorsCount) || 0 : 0;

  // Bulk welcome. _bulkEligible is computed by the route with the SAME cohort
  // query and cooldown the send itself uses, so the button's number and the
  // result cannot disagree.
  var _bulkEligible = (typeof bulkWelcomeEligible !== 'undefined') ? Number(bulkWelcomeEligible) || 0 : 0;
  var _bulkCooling  = (typeof bulkWelcomeCooling  !== 'undefined') ? Number(bulkWelcomeCooling)  || 0 : 0;
  var _bulkCooldown = (typeof bulkWelcomeCooldownHours !== 'undefined') ? Number(bulkWelcomeCooldownHours) || 24 : 24;
  var _wSent    = (typeof welcomeSent    !== 'undefined' && welcomeSent    !== null) ? Number(welcomeSent)    : null;
  var _wSkipped = (typeof welcomeSkipped !== 'undefined' && welcomeSkipped !== null) ? Number(welcomeSkipped) : null;
  var _wFailed  = (typeof welcomeFailed  !== 'undefined' && welcomeFailed  !== null) ? Number(welcomeFailed)  : null;
  var _wError   = (typeof welcomeError   !== 'undefined') ? !!welcomeError : false;

  function _docStatusChip(d) {
    if (d.pending_approval) return { label: 'Pending', tone: 'amber' };
    if (!d.is_active && d.rejection_reason) return { label: 'Rejected', tone: 'red' };
    if (!d.is_active) return { label: 'Inactive', tone: 'neutral' };
    if (d.is_paused) return { label: 'Paused', tone: 'amber' };
    return { label: 'Active', tone: 'green' };
  }

  function _fmtWhen(iso) {
    if (!iso) return '—';
    var d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '—';
    var diffMs = Date.now() - d.getTime();
    var mins = Math.round(diffMs / 60000);
    if (mins < 60) return mins + 'm ago';
    var hrs = Math.round(mins / 60);
    if (hrs < 24) return hrs + 'h ago';
    var days = Math.round(hrs / 24);
    return days + 'd ago';
  }

  var _filterTabs = [
    { id: 'all', label: isAr ? 'الكل' : 'All' },
    { id: 'pending', label: isAr ? 'قيد المراجعة' : 'Pending', count: _pending, tone: 'amber' },
    { id: 'approved', label: isAr ? 'مفعل' : 'Approved' },
    { id: 'rejected', label: isAr ? 'مرفوض' : 'Rejected' },
    { id: 'inactive', label: isAr ? 'غير نشط' : 'Inactive' },
    { id: 'paused', label: isAr ? 'معلق' : 'Paused', count: _paused, tone: 'red' }
  ];
%>
<%- include('partials/superadmin/header', {
      title: isAr ? 'الأطباء' : 'Doctors',
      currentSection: 'doctors',
      user: user,
      lang: lang || 'en',
      showTabBar: false,
      sidebarBadges: (typeof sidebarBadges !== 'undefined' && sidebarBadges) ? sidebarBadges : {},
      cspNonce: (typeof cspNonce !== 'undefined') ? cspNonce : ''
    }) %>

<%- include('partials/superadmin/page_header', {
      title: isAr ? 'الأطباء' : 'Doctors',
      subtitle: isAr ? 'إدارة حسابات الأطباء.' : 'Manage doctor accounts and onboarding.',
      breadcrumb: [
        { label: 'Dashboard', href: '/superadmin' },
        { label: isAr ? 'الأطباء' : 'Doctors' }
      ],
      actionsHtml: '<a class="btn primary" href="/superadmin/doctors/new">+ ' + (isAr ? 'إضافة طبيب' : 'Add doctor') + '</a>'
    }) %>

<div class="page-body">

  <%# ── Result of the last bulk send ──────────────────────────────────────
      Shown once, from the redirect's query string. "Skipped" is not a failure:
      it is the 24h cooldown refusing to re-blast someone invited yesterday. %>
  <% if (_wSent !== null || _wError) { %>
    <div style="margin-bottom:14px;padding:13px 16px;border-radius:8px;border:1px solid var(--line);
                border-inline-start:3px solid <%= _wError || (_wFailed || 0) > 0 ? 'var(--red, #b3261e)' : 'var(--green, #0B6B5F)' %>;
                background:var(--bg-2, #fff);font-size:13.5px;line-height:1.6;">
      <% if (_wError) { %>
        <strong style="color:var(--red, #b3261e);"><%= isAr ? 'فشل الإرسال الجماعي' : 'Bulk send failed' %></strong> —
        <%= isAr ? 'لم يتم إرسال أي رسالة. راجع سجل الأخطاء.' : 'nothing was sent. Check the error log.' %>
      <% } else { %>
        <strong><%= isAr ? 'تم الإرسال' : 'Sent' %>: <%= _wSent %></strong>
        <% if ((_wSkipped || 0) > 0) { %>
          · <%= _wSkipped %> <%= isAr ? 'تم تخطيها (أُرسلت خلال آخر ' + _bulkCooldown + ' ساعة)' : 'skipped (invited within the last ' + _bulkCooldown + 'h)' %>
        <% } %>
        <% if ((_wFailed || 0) > 0) { %>
          · <span style="color:var(--red, #b3261e);"><%= _wFailed %> <%= isAr ? 'فشلت' : 'failed' %></span>
        <% } %>
      <% } %>
    </div>
  <% } %>

  <%# ── Email all pending invites ─────────────────────────────────────────
      One request, so the 10-per-15-minutes IP limiter that governs the
      per-doctor button never bites. Plain form post, no inline JS, because the
      CSP has no script nonce on this page. %>
  <% if (_bulkEligible > 0 || _bulkCooling > 0) { %>
    <%- include('partials/superadmin/c_card_open', { tight: true }) %>
      <div style="padding:14px 16px;display:flex;gap:14px;align-items:center;flex-wrap:wrap;justify-content:space-between;">
        <div style="font-size:13.5px;line-height:1.6;">
          <strong><%= isAr ? 'دعوات لم تُفعّل بعد' : 'Doctors who have not set a password' %></strong><br>
          <span style="color:var(--fg-3);">
            <% if (_bulkEligible > 0) { %>
              <strong style="color:var(--fg);"><%= _bulkEligible %></strong>
              <%= isAr ? 'جاهزون للإرسال الآن.' : _bulkEligible === 1 ? 'ready to send now.' : 'ready to send now.' %>
            <% } else { %>
              <%= isAr ? 'لا أحد جاهز للإرسال الآن.' : 'None ready to send right now.' %>
            <% } %>
            <% if (_bulkCooling > 0) { %>
              <%= _bulkCooling %> <%= isAr ? 'في فترة الانتظار (' + _bulkCooldown + ' ساعة).' : 'in the ' + _bulkCooldown + 'h cooldown.' %>
            <% } %>
            <%= isAr ? 'كل رسالة تحمل رابطاً جديداً صالحاً 7 أيام ويُلغي الرابط السابق.' : 'Each send mints a fresh 7-day link and invalidates that doctor\'s previous one.' %>
          </span>
        </div>
        <form method="post" action="/superadmin/doctors/bulk-welcome-passwordless" style="margin:0;"
              onsubmit="return confirm('<%= isAr ? "إرسال إيميل الترحيب إلى " + _bulkEligible + " طبيب؟" : "Send the welcome email to " + _bulkEligible + " doctor(s)?" %>');">
          <%- (typeof csrfField === 'function') ? csrfField() : '' %>
          <input type="hidden" name="redirect" value="1" />
          <button type="submit" class="btn primary" <%= _bulkEligible === 0 ? 'disabled aria-disabled="true"' : '' %>>
            <%= isAr ? 'إرسال للكل (' + _bulkEligible + ')' : 'Email all (' + _bulkEligible + ')' %>
          </button>
        </form>
      </div>
    <%- include('partials/superadmin/c_card_close') %>
  <% } %>

  <%- include('partials/superadmin/c_card_open', { title: 'Filters', tight: true }) %>
    <div style="display:flex;gap:6px;flex-wrap:wrap;padding:12px 14px;">
      <% _filterTabs.forEach(function(t) {
           var isActive = _statusFilter === t.id;
      %>
        <a href="/superadmin/doctors?status=<%= t.id %>"
           class="chip<%= isActive ? ' accent' : '' %>"
           style="text-decoration:none;cursor:pointer;<% if (isActive) { %>font-weight:600;<% } %>">
          <%= t.label %>
          <% if (t.count != null && t.count > 0) { %>
            <span style="margin-inline-start:6px;font-variant-numeric:tabular-nums;<% if (t.tone === 'red') { %>color:var(--red);<% } else if (t.tone === 'amber') { %>color:var(--amber);<% } %>"><%= t.count %></span>
          <% } %>
        </a>
      <% }); %>
    </div>
  <%- include('partials/superadmin/c_card_close') %>

  <div class="section-h standalone" style="margin-top:16px;"><h2><%= isAr ? 'الأطباء' : 'Doctors' %> · <%= _doctors.length %></h2></div>
  <%- include('partials/superadmin/c_card_open', { tight: true }) %>
    <% if (!_doctors.length) { %>
      <%- include('partials/superadmin/c_empty', { title: isAr ? 'لا يوجد أطباء.' : 'No doctors match this filter' }) %>
    <% } else { %>
      <%- include('partials/superadmin/c_table_open', { headers: ['Name', 'Email', 'Specialty', 'Phone', 'Status', 'Created', 'Welcome', 'Notes', { label: 'Actions', align: 'end' }] }) %>
        <% _doctors.forEach(function(d) {
             var chip = _docStatusChip(d);
             var hasPassword = d.has_password === true;
             var welcomeSentAt = d.welcome_email_last_sent_at;
             var welcomeLabel;
             if (hasPassword) {
               welcomeLabel = isAr ? 'تم التفعيل' : 'Set up';
             } else if (welcomeSentAt) {
               welcomeLabel = (isAr ? 'أُرسل ' : 'sent ') + _fmtWhen(welcomeSentAt);
             } else {
               welcomeLabel = '—';
             }
             // Confirmation prompt — keep tight; falls back to a no-op if
             // a future CSP blocks inline handlers (the form still submits).
             var safeName = String(d.name || 'this doctor').replace(/'/g, "\\'");
             var confirmMsg = isAr
               ? ('إرسال إيميل الترحيب لـ د. ' + safeName + '؟')
               : ('Send welcome email to Dr. ' + safeName + '?');
        %>
          <tr>
            <td>
              <div style="display:flex;align-items:center;gap:10px;">
                <%- include('partials/superadmin/c_avatar', { name: d.name || 'Doctor' }) %>
                <a href="/superadmin/doctors/<%= d.id %>" style="color:inherit;font-weight:500;"><%= d.name || 'Doctor' %></a>
              </div>
            </td>
            <td><%= d.email || '—' %></td>
            <td><% if (d.specialty_name) { %><span class="spec-tag"><%= d.specialty_name %></span><% } else { %>—<% } %></td>
            <td class="mono" style="font-size:11.5px;"><%= d.phone || '—' %></td>
            <td><%- include('partials/superadmin/c_chip', { label: chip.label, tone: chip.tone, dot: true }) %></td>
            <td class="mono" style="color:var(--fg-3);font-size:11.5px;"><%= _fmtWhen(d.created_at) %></td>
            <td class="mono" style="color:<%= hasPassword ? 'var(--green, #0B6B5F)' : 'var(--fg-3)' %>;font-size:11.5px;"><%= welcomeLabel %></td>
            <td style="max-width:240px;color:var(--fg-3);font-size:11.5px;"><% if (d.signup_notes) { %><%= String(d.signup_notes).slice(0, 80) %><% if (String(d.signup_notes).length > 80) { %>…<% } %><% } else { %>—<% } %></td>
            <td style="text-align:end;">
              <div style="display:inline-flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;">
                <a class="btn" href="/superadmin/doctors/<%= d.id %>">View</a>
                <a class="btn" href="/superadmin/doctors/<%= d.id %>/edit">Edit</a>
                <% if (!d.pending_approval) { %>
                  <form method="post" action="/superadmin/doctors/<%= d.id %>/toggle" style="display:inline;">
                    <%- (typeof csrfField === 'function') ? csrfField() : '' %>
                    <button type="submit" class="btn"><%= d.is_active ? 'Deactivate' : 'Activate' %></button>
                  </form>
                  <% if (!d.rejection_reason) { %>
                    <form method="post" action="/superadmin/doctors/<%= d.id %>/resend-welcome" style="display:inline;"
                          title="<%= hasPassword
                              ? (isAr ? 'الطبيب فعّل الحساب بالفعل' : 'Doctor has already set up their account')
                              : (isAr ? 'إعادة إصدار رابط سحري لمدة 7 أيام وإعادة إرسال إيميل الترحيب' : 'Re-issue a fresh 7-day magic link and re-queue the welcome email') %>"
                          onsubmit="return confirm('<%= confirmMsg %>');">
                      <%- (typeof csrfField === 'function') ? csrfField() : '' %>
                      <button type="submit" class="btn" <%= hasPassword ? 'disabled aria-disabled="true"' : '' %>>
                        <%= hasPassword
                              ? (isAr ? 'تم التفعيل' : 'Already set up')
                              : (welcomeSentAt ? (isAr ? 'إعادة إرسال الترحيب' : 'Resend welcome') : (isAr ? 'إرسال الترحيب' : 'Send welcome')) %>
                      </button>
                    </form>
                  <% } %>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      <%- include('partials/superadmin/c_table_close') %>
    <% } %>
  <%- include('partials/superadmin/c_card_close') %>
</div>

<%- include('partials/superadmin/footer', { isAr: isAr }) %>
